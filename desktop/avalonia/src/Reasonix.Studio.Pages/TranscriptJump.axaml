<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Reasonix.Studio.Pages.TranscriptJump" HorizontalAlignment="Right" VerticalAlignment="Bottom">
  <UserControl.Styles>
    <Style Selector="Button.transcript-jump">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="{DynamicResource RSm}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource HairBrush}"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="JumpFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                  BoxShadow="0 2 8 -3 #2E000000">
            <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Canvas Width="24" Height="24">
                <Path Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/>
              </Canvas>
            </Viewbox>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.transcript-jump:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    </Style>
    <Style Selector="Button.transcript-jump:focus-visible /template/ Border#JumpFrame">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Window.motion Button.transcript-jump.shown">
      <Style.Animations>
        <Animation Duration="0:0:0.18" Easing="0.16,1,0.3,1">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/><Setter Property="TranslateTransform.Y" Value="6"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/><Setter Property="TranslateTransform.Y" Value="0"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="6">
    <Button Name="JumpUp" Classes="transcript-jump" IsVisible="False" AutomationProperties.AutomationId="action:transcript.scroll.up">
      <Button.Tag><StreamGeometry>M6 15l6-6 6 6</StreamGeometry></Button.Tag>
      <Button.RenderTransform><TranslateTransform/></Button.RenderTransform>
    </Button>
    <Button Name="JumpDown" Classes="transcript-jump" IsVisible="False" AutomationProperties.AutomationId="action:transcript.scroll.down">
      <Button.Tag><StreamGeometry>M6 9l6 6 6-6</StreamGeometry></Button.Tag>
      <Button.RenderTransform><TranslateTransform/></Button.RenderTransform>
    </Button>
  </StackPanel>
</UserControl>
