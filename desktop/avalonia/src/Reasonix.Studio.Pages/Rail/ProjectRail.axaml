<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Reasonix.Studio.Pages.Rail.ProjectRail"
             FontFamily="{DynamicResource WorkbenchUiFamily}" FontWeight="Medium" Foreground="{DynamicResource TextBrush}">
  <UserControl.Styles>
    <Style Selector="Button.rail-button">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="0"/>
      <Setter Property="FontSize" Value="{DynamicResource StudioType12}"/><Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Template"><ControlTemplate>
        <Border Name="Frame" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="Center" TextElement.FontFamily="{TemplateBinding FontFamily}" TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontWeight="{TemplateBinding FontWeight}"/>
        </Border>
      </ControlTemplate></Setter>
    </Style>
    <Style Selector="Button.rail-button:pointerover /template/ Border#Frame"><Setter Property="Background" Value="{DynamicResource OverlayBrush}"/></Style>
    <Style Selector="Button.rail-button:pressed /template/ Border#Frame"><Setter Property="Background" Value="{DynamicResource BorderBrush}"/></Style>
    <Style Selector="Button.rail-tab"><Setter Property="Height" Value="22"/><Setter Property="Padding" Value="8,0"/><Setter Property="CornerRadius" Value="5"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></Style>
    <Style Selector="Button.rail-tab.selected"><Setter Property="Background" Value="{DynamicResource RaisedBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button.rail-icon"><Setter Property="Width" Value="26"/><Setter Property="Height" Value="26"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
    <Style Selector="Button.session-more"><Setter Property="Height" Value="29"/><Setter Property="Margin" Value="3,2,9,5"/><Setter Property="Padding" Value="9,0"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
    <Style Selector="Path.rail-glyph"><Setter Property="Stroke" Value="{DynamicResource FaintBrush}"/><Setter Property="StrokeThickness" Value="1.8"/><Setter Property="StrokeLineCap" Value="Round"/><Setter Property="StrokeJoin" Value="Round"/></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="34,*">
    <Border Margin="0,4,-1,0" Height="30" Padding="4,0,2,0" AutomationProperties.AutomationId="class:projects-header">
    <Grid Name="Toolbar" Height="28" VerticalAlignment="Center" ColumnDefinitions="Auto,Auto,*,28,54,28" ColumnSpacing="2">
      <Button Name="ProjectTab" Margin="2,0,0,0" Width="40" VerticalAlignment="Center" Classes="rail-button rail-tab selected" AutomationProperties.AutomationId="action:session.view"/>
      <Button Name="RecentTab" Grid.Column="1" Width="40" VerticalAlignment="Center" Classes="rail-button rail-tab" AutomationProperties.AutomationId="action:session.recent">
        <Button.Flyout><Flyout Placement="RightEdgeAlignedTop">
          <StackPanel Width="320" MaxHeight="440" Spacing="8">
            <TextBlock Name="RecentTitle" FontSize="{DynamicResource StudioType14}" FontWeight="SemiBold"/>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Name="RecentRows" Spacing="1"/></ScrollViewer>
          </StackPanel>
        </Flyout></Button.Flyout>
      </Button>
      <Button Name="FoldAll" Grid.Column="3" Classes="rail-button rail-icon" Width="28" Height="28" FontSize="{DynamicResource StudioType13}" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}" AutomationProperties.AutomationId="action:workspace.fold-all">
        <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Name="FoldShape" Classes="rail-glyph" Data="m14 10 7-7 M20 10h-6V4 m-11 17 7-7 M4 14h6v6"/></Canvas></Viewbox>
      </Button>
      <Button Name="Scope" Grid.Column="4" Classes="rail-button" Padding="5,0" Height="26" Tag="action:session.scope">
        <StackPanel Orientation="Horizontal" Spacing="3"><TextBlock Name="ScopeLabel" FontSize="{DynamicResource StudioType12}" VerticalAlignment="Center"/><Viewbox Width="11" Height="11"><Canvas Width="24" Height="24"><Path Classes="rail-glyph" Data="m6 9 6 6 6-6"/></Canvas></Viewbox></StackPanel>
      </Button>
      <Button Name="AddProject" Grid.Column="5" Classes="rail-button rail-icon" Width="28" Height="28" FontSize="{DynamicResource StudioType13}" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}" AutomationProperties.AutomationId="action:workspace.add">
        <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Classes="rail-glyph" Data="M5 12h14 M12 5v14"/></Canvas></Viewbox>
      </Button>
    </Grid>
    </Border>
    <ScrollViewer Name="TreeScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Name="Rows" Spacing="0" Margin="10,0,20,8"/>
    </ScrollViewer>
  </Grid>
</UserControl>
