<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Reasonix.Studio.Pages">
  <Style Selector="local|DisclosureMotion">
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="Window.motion local|DisclosureMotion"><Setter Property="MotionEnabled" Value="True"/></Style>
  <Style Selector="local|StreamCaret">
    <Setter Property="IsVisible" Value="False"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>
  <Style Selector="local|StreamCaret.live"><Setter Property="IsVisible" Value="True"/></Style>
  <Style Selector="Window.motion local|StreamCaret.live">
    <Style.Animations>
      <Animation Duration="0:0:1" IterationCount="Infinite">
        <KeyFrame Cue="0%"><Setter Property="Phase" Value="0"/></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Phase" Value="1"/></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Button.conversation-action, Button.conversation-disclosure">
    <Setter Property="Background" Value="{DynamicResource OverlayClearBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HairClearBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="FontSize" Value="{DynamicResource StudioType13}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.conversation-action"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Width" Value="26"/><Setter Property="Height" Value="26"/></Style>
  <Style Selector="Button.conversation-disclosure"><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="Window.motion Button.conversation-action, Window.motion Button.conversation-disclosure">
    <Setter Property="Transitions"><Transitions>
      <BrushTransition Property="Background" Duration="0:0:0.12" Easing="0.16,1,0.3,1"/>
      <BrushTransition Property="BorderBrush" Duration="0:0:0.12" Easing="0.16,1,0.3,1"/>
      <BrushTransition Property="Foreground" Duration="0:0:0.12" Easing="0.16,1,0.3,1"/>
    </Transitions></Setter>
  </Style>
  <Style Selector="Button.conversation-action:pointerover, Button.conversation-disclosure:pointerover">
    <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HairBrush}"/>
  </Style>
  <Style Selector="Button.conversation-action:pressed, Button.conversation-disclosure:pressed"><Setter Property="Background" Value="{DynamicResource BorderBrush}"/></Style>
  <Style Selector="Button.conversation-action:disabled, Button.conversation-disclosure:disabled"><Setter Property="Opacity" Value="0.5"/></Style>
</Styles>
