<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Reasonix.Studio.Controls">

  <!--
    The skeleton's control themes. Every colour and size is read from the token
    dictionary the reference frontend's custom properties were rendered into, so
    the shell's vocabulary and the stylesheet's are the same set of names rather
    than two lists that happen to agree today.
  -->
  <Styles.Resources>
    <ControlTheme x:Key="{x:Type ctl:StudioRail}" TargetType="ctl:StudioRail">
      <Setter Property="Background" Value="{DynamicResource PageBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  Padding="{TemplateBinding Padding}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="0,0,1,0">
            <ContentPresenter Content="{TemplateBinding Content}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ctl:StudioChrome}" TargetType="ctl:StudioChrome">
      <Setter Property="Height" Value="48" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Padding" Value="20,0,12,0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ctl:StudioPane}" TargetType="ctl:StudioPane">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}">
            <ContentPresenter Content="{TemplateBinding Content}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ctl:StudioTranscript}" TargetType="ctl:StudioTranscript">
      <Setter Property="Template">
        <ControlTemplate>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ContentPresenter Content="{TemplateBinding Content}" />
          </ScrollViewer>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ctl:StudioComposer}" TargetType="ctl:StudioComposer">
      <Setter Property="MaxWidth" Value="{DynamicResource Column}" />
      <Setter Property="Height" Value="128" />
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource RLg}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BoxShadow="{DynamicResource ComposerShadow}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <!-- No padding here: the composer's own bands place the input box
                 and the send button, and a margin on the presenter would push
                 both inward by a second inset the baseline never had. -->
            <ContentPresenter Content="{TemplateBinding Content}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ctl:StudioSidePanel}" TargetType="ctl:StudioSidePanel">
      <Setter Property="Width" Value="{DynamicResource SideW}" />
      <Setter Property="Background" Value="{DynamicResource PageBrush}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1,0,0,0">
            <ContentPresenter Content="{TemplateBinding Content}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ctl:StudioCrumb}" TargetType="ctl:StudioCrumb">
      <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Styles.Resources>

  <!-- Applying the theme by type is what lets a page write <ctl:StudioRail/> and
       get the documented width, rather than restating it at each call site. -->
  <Style Selector="ctl|StudioRail">
    <Setter Property="Theme" Value="{StaticResource {x:Type ctl:StudioRail}}" />
  </Style>
  <Style Selector="ctl|StudioChrome">
    <Setter Property="Theme" Value="{StaticResource {x:Type ctl:StudioChrome}}" />
  </Style>
  <Style Selector="ctl|StudioPane">
    <Setter Property="Theme" Value="{StaticResource {x:Type ctl:StudioPane}}" />
  </Style>
  <Style Selector="ctl|StudioTranscript">
    <Setter Property="Theme" Value="{StaticResource {x:Type ctl:StudioTranscript}}" />
  </Style>
  <Style Selector="ctl|StudioComposer">
    <Setter Property="Theme" Value="{StaticResource {x:Type ctl:StudioComposer}}" />
  </Style>
  <Style Selector="ctl|StudioSidePanel">
    <Setter Property="Theme" Value="{StaticResource {x:Type ctl:StudioSidePanel}}" />
  </Style>
  <Style Selector="ctl|StudioCrumb">
    <Setter Property="Theme" Value="{StaticResource {x:Type ctl:StudioCrumb}}" />
  </Style>

</Styles>
