<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Reasonix.Studio.Shell.Session.SessionTabs">
  <UserControl.Styles>
    <Style Selector="Button.pane-tab"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,2"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="11,0,8,0"/><Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="132"/><Setter Property="MaxWidth" Value="216"/><Setter Property="CornerRadius" Value="6,6,0,0"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style Selector="Button.pane-tab.current"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
    <Style Selector="Button.pane-tab:pointerover"><Setter Property="Background" Value="{DynamicResource OverlayBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style Selector="Button.pane-close"><Setter Property="Width" Value="17"/><Setter Property="Height" Value="17"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="4"/><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource GhostBrush}"/><Setter Property="Opacity" Value="0"/></Style>
    <Style Selector="Button.pane-close.current"><Setter Property="Opacity" Value="1"/></Style>
    <Style Selector="Button.pane-close:pointerover"><Setter Property="Foreground" Value="{DynamicResource ErrInkBrush}"/></Style>
    <Style Selector="Button.pane-peer"><Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="4,0,0,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="6"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="Button.pane-peer:pointerover"><Setter Property="Background" Value="{DynamicResource HairBrush}"/></Style>
    <Style Selector="StackPanel.pane-tab-group:pointerover Button.pane-close"><Setter Property="Opacity" Value="1"/></Style>
    <Style Selector="TextBlock.pane-workspace"><Setter Property="FontSize" Value="10"/><Setter Property="FontFamily" Value="{DynamicResource WorkbenchMonoFamily}"/><Setter Property="Foreground" Value="{DynamicResource GhostBrush}"/></Style>
    <Style Selector="TextBlock.pane-host"><Setter Property="FontSize" Value="10"/><Setter Property="FontFamily" Value="{DynamicResource WorkbenchMonoFamily}"/><Setter Property="Foreground" Value="{DynamicResource NetBrush}"/></Style>
    <Style Selector="Window.motion Border.pane-pip.running">
      <Style.Animations>
        <Animation Duration="0:0:1.4" Easing="0.65,0,0.35,1" IterationCount="Infinite" PlaybackDirection="Alternate">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.45"/></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>
  <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource PageBrush}" Height="41" Padding="12,8,0,0">
    <Grid ClipToBounds="True">
      <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
        <StackPanel Name="Tabs" Orientation="Horizontal" Spacing="2"/>
      </ScrollViewer>
      <Canvas Name="TabMarkLayer" Height="2" VerticalAlignment="Bottom" IsHitTestVisible="False">
        <Border Name="TabMark" Height="2" CornerRadius="2" Background="{DynamicResource AccentBrush}" IsVisible="False"/>
      </Canvas>
    </Grid>
  </Border>
</UserControl>
