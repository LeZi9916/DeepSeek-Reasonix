<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Reasonix.Studio.Shell.Workbench.GitChangeRow">
  <UserControl.Styles>
    <Style Selector="Border#FileHeader">
      <Setter Property="Background" Value="{DynamicResource PageBrush}"/>
    </Style>
    <Style Selector="Border#FileHeader.folded">
      <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
    </Style>
    <Style Selector="StackPanel#FileActions">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Border#FileHeader:pointerover StackPanel#FileActions, Border#FileHeader:focus-within StackPanel#FileActions">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Button.change-row-action">
      <Setter Property="Height" Value="24"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.change-row-action:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style Selector="Button.change-row-action.confirming">
      <Setter Property="Foreground" Value="{DynamicResource ErrInkBrush}"/>
    </Style>
    <Style Selector="TextBlock#PeekLabel">
      <Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/>
    </Style>
    <Style Selector="Button#FoldButton:pointerover, Button#FoldButton:pressed, Button#PeekButton:pointerover, Button#PeekButton:pressed">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button#PeekButton:pointerover TextBlock#PeekLabel">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style Selector="Border#FileHeader Button#FoldButton /template/ Path#FoldChevron">
      <Setter Property="Data" Value="m6 9 6 6 6-6"/>
    </Style>
    <Style Selector="Border#FileHeader.folded Button#FoldButton /template/ Path#FoldChevron">
      <Setter Property="Data" Value="m9 18 6-6-6-6"/>
    </Style>
    <Style Selector="Border#TagBody">
      <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
    </Style>
    <Style Selector="Border#FileHeader.folded Border#TagBody">
      <Setter Property="Background" Value="{DynamicResource PageBrush}"/>
    </Style>
    <Style Selector="TextBlock#Status">
      <Setter Property="Foreground" Value="{DynamicResource WarnInkBrush}"/>
    </Style>
    <Style Selector="TextBlock#Status.added">
      <Setter Property="Foreground" Value="{DynamicResource OkInkBrush}"/>
    </Style>
    <Style Selector="TextBlock#Status.deleted">
      <Setter Property="Foreground" Value="{DynamicResource ErrInkBrush}"/>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="36,Auto,Auto">
    <Border Name="FileHeader" UseLayoutRounding="False" ZIndex="1" BorderBrush="{DynamicResource HairBrush}" BorderThickness="0,0,0,1" Padding="10,0,8,0">
      <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
      <DockPanel UseLayoutRounding="False">
        <Button Name="FoldButton" DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"
                Classes="git-flat" Cursor="Hand" AutomationProperties.AutomationId="action:workbench.change-fold">
            <Button.Template>
              <ControlTemplate>
                <Border Background="Transparent">
                  <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                      <Path Name="FoldChevron" Stroke="{DynamicResource FaintBrush}" StrokeThickness="1.8"
                            StrokeLineCap="Round" StrokeJoin="Round"/>
                    </Canvas>
                  </Viewbox>
                </Border>
              </ControlTemplate>
            </Button.Template>
        </Button>
        <ContentControl Name="StageHost" DockPanel.Dock="Left" Width="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <TextBlock Name="Status" DockPanel.Dock="Left" Width="18" Margin="0,0,8,0" VerticalAlignment="Center" TextAlignment="Center"
                   FontFamily="{DynamicResource WorkbenchMonoFamily}" FontSize="{DynamicResource StudioType11}" FontWeight="Bold"/>
        <StackPanel Name="Figures" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                    TextElement.FontFamily="{DynamicResource WorkbenchMonoFamily}" TextElement.FontSize="{DynamicResource StudioType12}" TextElement.FontWeight="Medium">
          <TextBlock Name="Insertions" Foreground="{DynamicResource AddBrush}"/>
          <TextBlock Name="Deletions" Foreground="{DynamicResource DelBrush}"/>
        </StackPanel>
        <Border Name="TagBody" DockPanel.Dock="Right" Height="20" Margin="0,0,8,0" Padding="7,0" CornerRadius="10" VerticalAlignment="Center">
          <TextBlock Name="FileTag" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource StudioType11}" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Name="FileActions" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" Margin="0,0,8,0" VerticalAlignment="Center">
          <Button Name="OpenFileButton" Classes="git-flat change-row-action" Cursor="Hand" AutomationProperties.AutomationId="action:workbench.change-open"/>
          <Button Name="DiscardButton" Classes="git-flat change-row-action" Cursor="Hand" AutomationProperties.AutomationId="action:workbench.discard"/>
        </StackPanel>
        <TextBlock Name="FilePath" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"
                   FontFamily="{DynamicResource WorkbenchMonoFamily}" FontSize="{DynamicResource StudioType12}" FontWeight="SemiBold"/>
      </DockPanel>
    </Border>
    <Border Name="PeekBody" Grid.Row="1" UseLayoutRounding="False" BorderBrush="{DynamicResource HairBrush}" BorderThickness="0,0,0,1">
      <Button Name="PeekButton" Classes="git-flat" Height="32.8" Padding="54,0,12,0"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand">
        <TextBlock Name="PeekLabel" FontWeight="Medium" FontSize="{DynamicResource StudioType12}"/>
      </Button>
    </Border>
    <ContentControl Name="PatchHost" Grid.Row="2" HorizontalContentAlignment="Stretch"/>
  </Grid>
</UserControl>
