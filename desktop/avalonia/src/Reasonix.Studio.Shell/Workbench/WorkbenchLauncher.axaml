<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Reasonix.Studio.Controls" x:Class="Reasonix.Studio.Shell.Workbench.WorkbenchLauncher"
             FontFamily="{DynamicResource WorkbenchUiFamily}" Background="{DynamicResource RaisedBrush}">
  <UserControl.Styles>
    <Style Selector="Button.launcher-choice,Button.launcher-recent">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style Selector="Button.launcher-choice">
      <Setter Property="Height" Value="56"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Button.launcher-recent">
      <Setter Property="Height" Value="30"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="FontSize" Value="{DynamicResource StudioType12}"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style Selector="Button.launcher-choice:pointerover /template/ ContentPresenter#PART_ContentPresenter,Button.launcher-recent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
    </Style>
    <Style Selector="TextBlock.launcher-title">
      <Setter Property="FontSize" Value="{DynamicResource StudioType13}"/>
      <Setter Property="LineHeight" Value="16.9"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style Selector="TextBlock.launcher-hint">
      <Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/>
      <Setter Property="FontSize" Value="{DynamicResource StudioType12}"/>
      <Setter Property="LineHeight" Value="15.6"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.launcher-dir">
      <Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/>
      <Setter Property="FontSize" Value="{DynamicResource StudioType11}"/>
      <Setter Property="FontFamily" Value="{DynamicResource StudioMonoFamily}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="Path.launcher-icon">
      <Setter Property="Stroke" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="StrokeThickness" Value="1.8"/>
      <Setter Property="StrokeLineCap" Value="Round"/>
      <Setter Property="StrokeJoin" Value="Round"/>
    </Style>
  </UserControl.Styles>
  <ScrollViewer Name="LauncherScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Border Padding="20,24" Width="420" MaxWidth="{Binding #LauncherScroll.Viewport.Width}" HorizontalAlignment="Left">
      <StackPanel Spacing="8">
        <TextBlock Name="Title" Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource StudioType14}"
                   LineHeight="19.6" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <Button Name="Files" Classes="launcher-choice" AutomationProperties.AutomationId="action:workbench.launch-files">
          <Grid ColumnDefinitions="16,*" ColumnSpacing="12">
            <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Classes="launcher-icon" Data="{StaticResource Glyph.folder}"/></Canvas></Viewbox>
            <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Left">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBlock Name="FilesTitle" Classes="launcher-title" VerticalAlignment="Center"/>
                <Border Name="ChangesPill" Grid.Column="1" Background="{DynamicResource OverlayBrush}" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0">
                  <TextBlock Name="Changes" FontSize="{DynamicResource StudioType11}" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"
                             VerticalAlignment="Center" TextAlignment="Center"/>
                </Border>
              </Grid>
              <TextBlock Name="FilesHint" Classes="launcher-hint"/>
            </StackPanel>
          </Grid>
        </Button>
        <Button Name="Browser" Classes="launcher-choice" AutomationProperties.AutomationId="action:workbench.launch-browser">
          <Grid ColumnDefinitions="16,*" ColumnSpacing="12">
            <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
              <Path Classes="launcher-icon" Data="M22 12a10 10 0 1 0-20 0 10 10 0 1 0 20 0z M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20 M2 12h20"/>
            </Canvas></Viewbox>
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Name="BrowserTitle" Classes="launcher-title"/>
              <TextBlock Name="BrowserHint" Classes="launcher-hint"/>
            </StackPanel>
          </Grid>
        </Button>
        <Button Name="Terminal" Classes="launcher-choice" AutomationProperties.AutomationId="action:workbench.launch-terminal">
          <Grid ColumnDefinitions="16,*" ColumnSpacing="12">
            <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
              <Path Classes="launcher-icon" Data="m4 17 6-5-6-5 M12 19h8"/>
            </Canvas></Viewbox>
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Name="TerminalTitle" Classes="launcher-title"/>
              <TextBlock Name="TerminalHint" Classes="launcher-hint"/>
            </StackPanel>
          </Grid>
        </Button>
        <StackPanel Name="RecentGroup" Margin="0,16,0,0" Spacing="6">
          <ctl:StudioLineText Name="RecentTitle" FontSize="{DynamicResource StudioType12}" LineHeight="12"
                              FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
          <StackPanel Name="Recent" Spacing="2"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
