<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Reasonix.Studio.Shell.Workbench.WorkbenchLauncher" FontFamily="{DynamicResource WorkbenchUiFamily}" FontSize="12" FontWeight="Medium">
  <UserControl.Styles>
    <Style Selector="Button.launcher"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="60"/><Setter Property="Padding" Value="14,10"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource HairBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch"/></Border></ControlTemplate></Setter></Style>
    <Style Selector="Button.launcher:pointerover"><Setter Property="Background" Value="{DynamicResource OverlayBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Style>
    <Style Selector="TextBlock.description"><Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/><Setter Property="FontSize" Value="11"/></Style>
    <Style Selector="TextBlock.launcher-dir"><Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/><Setter Property="FontSize" Value="10"/></Style>
    <Style Selector="Path.mark"><Setter Property="Stroke" Value="{DynamicResource MutedBrush}"/><Setter Property="StrokeThickness" Value="1.8"/><Setter Property="StrokeLineCap" Value="Round"/><Setter Property="StrokeJoin" Value="Round"/></Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" MaxWidth="420" HorizontalAlignment="Stretch" Spacing="10" VerticalAlignment="Center">
      <TextBlock Name="Title" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
      <Button Name="Files" Classes="launcher" AutomationProperties.AutomationId="action:workbench.launch-files"><Grid ColumnDefinitions="22,*" ColumnSpacing="12"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Classes="mark" Data="M3 5h7l2 3h9v12H3Z"/></Canvas></Viewbox><StackPanel Grid.Column="1" Spacing="4"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Name="FilesTitle" FontWeight="SemiBold"/><TextBlock Name="Changes" Foreground="{DynamicResource FaintBrush}"/></StackPanel><TextBlock Name="FilesHint" Classes="description" TextWrapping="Wrap"/></StackPanel></Grid></Button>
      <Button Name="Browser" Classes="launcher" AutomationProperties.AutomationId="action:workbench.launch-browser"><Grid ColumnDefinitions="22,*" ColumnSpacing="12"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Classes="mark" Data="M21 12A9 9 0 1 1 3 12A9 9 0 1 1 21 12 M3 12h18 M12 3C6 8 6 16 12 21C18 16 18 8 12 3Z"/></Canvas></Viewbox><StackPanel Grid.Column="1" Spacing="4"><TextBlock Name="BrowserTitle" FontWeight="SemiBold"/><TextBlock Name="BrowserHint" Classes="description" TextWrapping="Wrap"/></StackPanel></Grid></Button>
      <Button Name="Terminal" Classes="launcher" AutomationProperties.AutomationId="action:workbench.launch-terminal"><Grid ColumnDefinitions="22,*" ColumnSpacing="12"><Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Classes="mark" Data="m4 5 7 7-7 7 M13 19h7"/></Canvas></Viewbox><StackPanel Grid.Column="1" Spacing="4"><TextBlock Name="TerminalTitle" FontWeight="SemiBold"/><TextBlock Name="TerminalHint" Classes="description" TextWrapping="Wrap"/></StackPanel></Grid></Button>
      <TextBlock Name="RecentTitle" Foreground="{DynamicResource FaintBrush}" Margin="0,5,0,0"/>
      <StackPanel Name="Recent" Spacing="3"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
