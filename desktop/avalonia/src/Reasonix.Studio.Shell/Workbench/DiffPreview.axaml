<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Reasonix.Studio.Shell.Workbench.DiffPreview">
  <SelectableTextBlock Name="Patch" AutomationProperties.AutomationId="class:workbench-diff" FontFamily="{DynamicResource StudioMonoFamily}"
                       TextWrapping="NoWrap" FontSize="13" Margin="8"/>
</UserControl>
