<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Reasonix.Studio.Shell.Workbench.GitPatchView">
  <StackPanel>
    <StackPanel Name="Lines" TextElement.FontFamily="{DynamicResource DataPathFamily}" TextElement.FontSize="{DynamicResource StudioType12}"/>
    <TextBlock Name="Truncated" IsVisible="False" FontSize="{DynamicResource StudioType12}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
  </StackPanel>
</UserControl>
