<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Reasonix.Studio.Shell.Workbench.GitChangesView"
             FontFamily="{DynamicResource WorkbenchUiFamily}" FontWeight="Medium">
  <Grid RowDefinitions="40,Auto,Auto,*">
    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource HairBrush}" Background="{DynamicResource RaisedBrush}">
      <ContentControl Name="CommandHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Border>
    <ScrollViewer Name="ReviewViewport" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding #ReviewHost.IsVisible}">
    <Border Padding="12,10" Margin="0,8,0,6" CornerRadius="10" BorderThickness="1"
            BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PageBrush}"
            IsVisible="{Binding #ReviewHost.IsVisible}">
      <StackPanel Name="ReviewHost" IsVisible="False" Spacing="8"/>
    </Border>
    </ScrollViewer>
    <TextBlock Name="Feedback" Grid.Row="2" IsVisible="False" Margin="12,4" TextWrapping="Wrap"
               FontSize="{DynamicResource StudioType12}" AutomationProperties.LiveSetting="Polite"/>
    <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                  AutomationProperties.AutomationId="class:wb-changes-body">
      <StackPanel Name="ChangeFiles"/>
    </ScrollViewer>
  </Grid>
</UserControl>
