<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Reasonix.Studio.Shell.Workbench.SignalRail">
  <StackPanel Spacing="6">
    <Grid Height="30" ClipToBounds="True">
      <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource HairBrush}"/>
      <Canvas Name="Markers"/>
    </Grid>
    <WrapPanel Name="Members"/>
  </StackPanel>
</UserControl>
