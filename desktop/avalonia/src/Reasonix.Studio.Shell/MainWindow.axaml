<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Reasonix.Studio.Controls"
        xmlns:pages="using:Reasonix.Studio.Pages"
        x:Class="Reasonix.Studio.Shell.MainWindow"
        Title="Reasonix Studio"
        Width="1440"
        Height="900"
        Background="{DynamicResource SurfaceBrush}">

  <!--
    The skeleton's columns, taken from the baseline: the rail spans the full
    height at 264, and the page area beside it starts with a 48-high chrome bar.
    Every box here is one the geometry gate holds, so the numbers come from
    SkeletonMetrics' own values rather than from new literals.
  -->
  <Grid ColumnDefinitions="264,*">
    <ctl:StudioRail Grid.Column="0">
      <StackPanel Spacing="4">
        <TextBlock Text="DeepSeek-Reasonix" FontSize="13" FontWeight="SemiBold" />
        <TextBlock Text="新会话" FontSize="13" Opacity="0.7" />
      </StackPanel>
    </ctl:StudioRail>

    <Grid Grid.Column="1" RowDefinitions="48,*">
      <ctl:StudioChrome Grid.Row="0">
        <ctl:StudioCrumb>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="DeepSeek-Reasonix" FontSize="13" />
            <TextBlock Text="/" FontSize="13" Opacity="0.5" />
            <TextBlock Name="CrumbTitle" Text="新会话" FontSize="13" Opacity="0.7" />
          </StackPanel>
        </ctl:StudioCrumb>
      </ctl:StudioChrome>

      <ctl:StudioPane Grid.Row="1">
        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Stretch">
          <Grid Grid.Column="0" RowDefinitions="*,Auto">
            <!-- The reading column is the baseline's 760 wide, centred on the
                 pane. The rows carry their own spacing, so this page adds none:
                 its margin would narrow the column the gate measured. -->
            <pages:SessionPage Name="Conversation"
                               Grid.Row="0"
                               Width="{DynamicResource Column}"
                               HorizontalAlignment="Center" />

            <!-- The composer's box is the baseline's 760 x 128, centred on the
                 pane and 35 above its bottom edge: both numbers come from the
                 captured conversation rather than from a preference. -->
            <ctl:StudioComposer Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,35">
              <!-- The composer's three bands are the captured ones: a 30-high
                   status line, a 52-high input band holding a 42-high box, and a
                   46-high toolbar with the 32 round send button 8 from the edge. -->
              <Grid RowDefinitions="30,52,46">
                <TextBox Name="Composer"
                         Grid.Row="1"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         PlaceholderText="写点什么…"
                         Background="Transparent"
                         BorderThickness="0"
                         CornerRadius="0"
                         Padding="0"
                         FontSize="14"
                         Foreground="{DynamicResource TextBrush}"
                         VerticalContentAlignment="Top"
                         Height="42"
                         Margin="16,10,16,0"
                         AutomationProperties.AutomationId="role:combobox" />
                <Button Name="Send"
                        Grid.Row="2"
                        Content="发送"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Width="32"
                        Height="32"
                        Margin="0,6,8,0"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource FaintBrush}"
                        Background="{DynamicResource OverlayBrush}"
                        BorderThickness="0"
                        CornerRadius="16"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        AutomationProperties.AutomationId="action:session.send" />
              </Grid>
            </ctl:StudioComposer>
          </Grid>

          <!-- The captured conversation has this column folded, so the skeleton
               draws it folded too: a panel the baseline never measured must not
               take width from the reading column it did measure. The column
               returns, with its own geometry, when that column's step lands. -->
          <ctl:StudioSidePanel Grid.Column="1" IsVisible="False">
            <StackPanel Margin="12" Spacing="6">
              <TextBlock Text="上下文" FontSize="13" Opacity="0.7" />
              <TextBlock Name="ContextReadout" Text="—" FontSize="12" Opacity="0.55" />
            </StackPanel>
          </ctl:StudioSidePanel>
        </Grid>
      </ctl:StudioPane>
    </Grid>
  </Grid>
</Window>
