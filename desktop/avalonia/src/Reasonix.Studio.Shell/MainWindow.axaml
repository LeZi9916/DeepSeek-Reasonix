<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:ctl="using:Reasonix.Studio.Controls"
        xmlns:pages="using:Reasonix.Studio.Pages"
        xmlns:appearance="using:Reasonix.Studio.Shell.Appearance"
        xmlns:notices="using:Reasonix.Studio.Shell.Notices"
        xmlns:startup="using:Reasonix.Studio.Shell.Startup"
        xmlns:settings="using:Reasonix.Studio.Shell.Settings"
        xmlns:rail="using:Reasonix.Studio.Pages.Rail"
        xmlns:workbench="using:Reasonix.Studio.Shell.Workbench"
        xmlns:session="using:Reasonix.Studio.Shell.Session"
        xmlns:workspace="using:Reasonix.Studio.Shell.Workspace"
        xmlns:composer="using:Reasonix.Studio.Shell.Composer"
        xmlns:metrics="using:Reasonix.Studio.Shell.Metrics"
        x:Class="Reasonix.Studio.Shell.MainWindow"
        Title="Reasonix Studio" Width="1440" Height="900"
        MinWidth="760" MinHeight="480" Background="{DynamicResource SurfaceBrush}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://Reasonix.Studio.Pages/Rail/WorkspaceMenu.axaml"/></ResourceDictionary.MergedDictionaries>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="ComposeMaskBrush" Color="{DynamicResource Ghost}"/><SolidColorBrush x:Key="ComposeContextProgressBrush" Color="#858981"/><SolidColorBrush x:Key="ComposeContextHoleBrush" Color="{DynamicResource Surface}"/></ResourceDictionary>
        <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="ComposeMaskBrush" Color="{DynamicResource Muted}"/><SolidColorBrush x:Key="ComposeContextProgressBrush" Color="{DynamicResource Accent}"/><SolidColorBrush x:Key="ComposeContextHoleBrush" Color="{DynamicResource Raised}"/></ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="Window.motion notices|CopyNotice.arriving">
      <Style.Animations><Animation Duration="0:0:0.18" Easing="0.16,1,0.3,1">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/><Setter Property="TranslateTransform.Y" Value="6"/></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/><Setter Property="TranslateTransform.Y" Value="0"/></KeyFrame>
      </Animation></Style.Animations>
    </Style>
    <StyleInclude Source="avares://Reasonix.Studio.Shell/Styles/Settings.axaml" />
    <StyleInclude Source="avares://Reasonix.Studio.Shell/Styles/Workbench.axaml" />
    <StyleInclude Source="avares://Reasonix.Studio.Shell/Styles/Conversation.axaml" />
    <StyleInclude Source="avares://Reasonix.Studio.Shell/Styles/ComposerPicker.axaml" />
    <StyleInclude Source="avares://Reasonix.Studio.Shell/Styles/ComposerMenus.axaml" />
    <StyleInclude Source="avares://Reasonix.Studio.Shell/Styles/ComposerAttachments.axaml" />
    <StyleInclude Source="avares://Reasonix.Studio.Shell/Styles/PlanStrip.axaml" />
    <StyleInclude Source="avares://Reasonix.Studio.Shell/Styles/RunFeedback.axaml" />
    <StyleInclude Source="avares://Reasonix.Studio.Shell/Styles/OnboardingMotion.axaml"/>
    <StyleInclude Source="avares://Reasonix.Studio.Shell/Styles/Sidebar.axaml" />
    <Style Selector="Window.illustrated ctl|StudioPane"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="Window.illustrated ctl|StudioRail"><Setter Property="Background" Value="{DynamicResource ArtworkRailBrush}"/></Style>
    <Style Selector="Window.illustrated ctl|StudioChrome"><Setter Property="Background" Value="{DynamicResource ArtworkChromeBrush}"/></Style>
    <Style Selector="Window.illustrated ctl|StudioSidePanel"><Setter Property="Background" Value="{DynamicResource ArtworkSideBrush}"/></Style>
    <Style Selector="Window.illustrated ctl|StudioComposer"><Setter Property="Background" Value="{DynamicResource ArtworkComposeBrush}"/></Style>
    <Style Selector="Button.caption">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontSize" Value="{DynamicResource StudioType13}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Window.motion Button.icon">
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.06" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="Window.motion Button.icon:pressed">
      <Setter Property="RenderTransform" Value="scale(0.94)" />
    </Style>
    <Style Selector="Window.motion Button.icon /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions><BrushTransition Property="Background" Duration="0:0:0.12" Easing="0.16,1,0.3,1" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource OverlayBrush}" />
    </Style>
    <Style Selector="Button.chrome-view.active-view">
      <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
  </Window.Styles>
  <Panel>
  <LayoutTransformControl Name="ScaledWindow">
  <LayoutTransformControl.RenderTransform><TranslateTransform/></LayoutTransformControl.RenderTransform>
  <Grid>
  <Grid Name="LayoutRoot" ColumnDefinitions="264,*" Background="{DynamicResource PageBrush}">
    <appearance:ThemeBackdrop Name="Backdrop" Grid.ColumnSpan="2"/>
    <Grid Name="MainArea" Grid.Column="1" RowDefinitions="48,Auto,*">
      <ctl:StudioChrome Name="TitleChrome">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <Button Name="ExpandRail" Classes="icon" IsVisible="False" Margin="0,0,8,0"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Data="{StaticResource Glyph.expand}"/></Canvas></Viewbox></Button>
          <ctl:StudioCrumb Grid.Column="1" Height="19" ClipToBounds="True">
            <Grid ColumnDefinitions="16,Auto,Auto,Auto,Auto,*">
              <Button Name="OpenProject" Classes="icon" Width="16" Height="16" CornerRadius="0"
                      AutomationProperties.AutomationId="action:chrome.open-project">
                <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24">
                  <Path Data="M3,5 Q3,4 5,4 H10 L12,7 H20 Q22,7 22,9 V18 Q22,20 20,20 H5 Q3,20 3,18 Z" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.7" StrokeJoin="Round"/>
                </Canvas></Viewbox>
              </Button>
              <TextBlock Name="ProjectName" Grid.Column="1" Margin="8,0,0,0" Text="Reasonix Studio" FontSize="{DynamicResource StudioType13}" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}" MaxWidth="520" TextTrimming="CharacterEllipsis" />
              <Border Name="IsolatedBadge" Grid.Column="2" Margin="8,0,0,0" CornerRadius="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="5,0" IsVisible="False"><TextBlock Name="IsolatedBadgeLabel" FontSize="{DynamicResource StudioType11}" Foreground="{DynamicResource FaintBrush}"/></Border>
              <Border Name="HostBadge" Grid.Column="3" Margin="8,0,0,0" CornerRadius="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="5,0" IsVisible="False"><TextBlock Name="HostBadgeLabel" MaxWidth="100" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource StudioType11}" Foreground="{DynamicResource FaintBrush}"/></Border>
              <TextBlock Grid.Column="4" Margin="8,0,0,0" Text="/" FontSize="{DynamicResource StudioType13}" Opacity="0.5" />
              <TextBlock Name="CrumbTitle" Grid.Column="5" Margin="8,0,0,0" FontSize="{DynamicResource StudioType13}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
            </Grid>
          </ctl:StudioCrumb>
          <Border Name="QueuedBadge" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" CornerRadius="5" Background="{DynamicResource OverlayBrush}" Padding="6,3" IsVisible="False"><TextBlock Name="QueuedBadgeLabel" FontSize="{DynamicResource StudioType11}" Foreground="{DynamicResource MutedBrush}"/></Border>
          <Grid Name="ChromeGroup" Grid.Column="3">
          <Grid Name="ChromeTools">
            <StackPanel Name="ChromeActions" Orientation="Horizontal" Spacing="4">
            <Button Name="FindButton" Classes="icon" HorizontalAlignment="Left" AutomationProperties.AutomationId="action:transcript.find">
              <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
                <Path Data="{StaticResource Glyph.search}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4" StrokeLineCap="Round"/>
              </Canvas></Viewbox>
            </Button>
            <workspace:WorkspaceChromeStatus Name="WorkspaceStatus" HorizontalAlignment="Left"/>
            <Button Name="ThemeSwitch" Classes="icon" AutomationProperties.AutomationId="action:appearance.theme">
              <ContentControl Name="ThemeGlyph" Width="16" Height="16" HorizontalContentAlignment="Center">
                <Viewbox Width="16" Height="16">
                  <Canvas Width="24" Height="24">
                    <Path Name="ThemeShape" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4"
                          StrokeLineCap="Round" StrokeJoin="Round" />
                  </Canvas>
                </Viewbox>
              </ContentControl>
            </Button>
            <Button Name="ChromeAnalysis" Classes="icon chrome-view" IsVisible="False" AutomationProperties.AutomationId="action:pane.view">
              <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
                <Path Data="M2 12h4l3-9 6 18 3-9h4" Stroke="{Binding #ChromeAnalysis.Foreground}" StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round"/>
              </Canvas></Viewbox>
            </Button>
            <Button Name="ViewSwitch" Classes="icon chrome-view" AutomationProperties.AutomationId="action:pane.view">
              <Grid Width="28" Height="28">
                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
                  <Path Data="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z M9 3v18"
                        Stroke="{Binding #ViewSwitch.Foreground}" StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round"/>
                </Canvas></Viewbox>
                <Border Name="ChromeWorkbenchCount" MinWidth="14" Padding="3,0" Margin="0,-2,-2,0" IsVisible="False"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource AccentInkBrush}" CornerRadius="6">
                  <TextBlock Name="ChromeWorkbenchCountLabel" FontSize="{DynamicResource StudioType11}" LineHeight="14"
                             Foreground="{DynamicResource PageBrush}" TextAlignment="Center"/>
                </Border>
              </Grid>
              <Button.ContextFlyout>
                <MenuFlyout>
                  <MenuItem Name="ConversationView" />
                  <MenuItem Name="AnalysisView" />
                  <MenuItem Name="WorkbenchView" />
                  <MenuItem Name="TerminalAction" />
                  <MenuItem Name="BrowserAction" />
                </MenuFlyout>
              </Button.ContextFlyout>
            </Button>
            </StackPanel>
          </Grid>
          <Button Name="ChromeMore" Classes="icon" IsVisible="False" AutomationProperties.AutomationId="action:chrome.more"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M5 12h.01 M12 12h.01 M19 12h.01" Stroke="{DynamicResource MutedBrush}" StrokeThickness="3" StrokeLineCap="Round"/></Canvas></Viewbox></Button>
          </Grid>
        </Grid>
      </ctl:StudioChrome>
      <startup:BootChromeSweep Name="StartupChromeSweep" Grid.Row="0"
                               Ink="{DynamicResource AccentBrush}" ClipToBounds="True" IsHitTestVisible="False"/>
      <ProgressBar Name="NavigationProgress" Height="2" VerticalAlignment="Bottom" IsIndeterminate="True" IsVisible="False" IsHitTestVisible="False"/>
      <session:SessionTabs Name="PaneTabs" Grid.Row="1" IsVisible="False"/>
      <ctl:StudioPane Grid.Row="2">
        <Grid Name="PaneGrid" ColumnDefinitions="*,Auto,Auto" RowDefinitions="*,Auto">
          <Grid Name="ConversationArea" RowDefinitions="*,Auto" TextElement.FontFamily="{DynamicResource ConversationUiFamily}" TextElement.FontWeight="Medium" TextElement.Foreground="{DynamicResource TextBrush}">
            <pages:SessionPage Name="Conversation" Grid.Row="0" HorizontalAlignment="Stretch">
              <pages:SessionPage.TopContent><Button Name="EarlierHistory" IsVisible="False" HorizontalAlignment="Center" Margin="8,4" MinHeight="24" FontSize="11" Background="Transparent" BorderThickness="0" AutomationProperties.AutomationId="action:history.more"/></pages:SessionPage.TopContent>
            </pages:SessionPage>
          <ScrollViewer Name="AnalysisPanel" Grid.Row="0" MaxWidth="1080" Margin="0,0,10,0" AutomationProperties.AutomationId="class:run-analysis" IsVisible="False">
            <StackPanel Name="AnalysisContent" Margin="0,24,0,16" Spacing="16" HorizontalAlignment="Stretch" />
          </ScrollViewer>
            <Border Name="FindBar" Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Right" IsVisible="False"
                    Padding="6" Margin="10" CornerRadius="7" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBox Name="FindText" Width="180"/>
                <TextBlock Name="MatchCount" VerticalAlignment="Center"/>
                <Button Name="PreviousMatch" Classes="icon">↑</Button>
                <Button Name="NextMatch" Classes="icon">↓</Button>
                <Button Name="CloseFind" Classes="icon">×</Button>
              </StackPanel>
            </Border>
            <StackPanel Name="ComposerArea" Classes="compose-area" UseLayoutRounding="False" TextElement.FontFamily="{DynamicResource ConversationUiFamily}" TextElement.FontWeight="Medium" Grid.Row="1" MaxWidth="{DynamicResource Column}" HorizontalAlignment="Stretch" Spacing="8">
              <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
              <ListBox Name="Suggestions" IsVisible="False" MaxHeight="170" Focusable="False"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{ReflectionBinding Label}" />
                      <TextBlock Text="{ReflectionBinding Hint}" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Border Name="ErrorBar" IsVisible="False" Padding="10,6" CornerRadius="7"
                      Background="{DynamicResource OverlayBrush}">
                <Grid ColumnDefinitions="*,Auto">
                  <SelectableTextBlock Name="ErrorText" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  <Button Name="DismissError" Grid.Column="1" Classes="icon">×</Button>
                </Grid>
              </Border>
              <StackPanel Name="MemorySuggestions" Spacing="5" IsVisible="False"/>
              <ScrollViewer Name="ComposeReviewScroll" IsVisible="False" MaxHeight="240" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="8">
              <Border Name="RefineCard" IsVisible="False" Classes="compose-review">
                <StackPanel Spacing="8">
                  <TextBlock Name="RefineTitle" FontWeight="SemiBold"/>
                  <SelectableTextBlock Name="RefineText" TextWrapping="Wrap" MaxHeight="160"/>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Name="DiscardRefine"/><Button Name="RetryRefine"/><Button Name="AdoptRefine"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Name="SideCard" IsVisible="False" Classes="compose-review">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Name="SideTitle" FontWeight="SemiBold"/><Button Name="CloseSide" Grid.Column="1" Classes="compose-tool compose-icon" Content="×"/></Grid>
                  <TextBlock Name="SideNote" Foreground="{DynamicResource FaintBrush}" FontSize="{DynamicResource StudioType11}"/>
                  <ScrollViewer MaxHeight="160"><SelectableTextBlock Name="SideAnswer" TextWrapping="Wrap"/></ScrollViewer>
                  <TextBox Name="SideInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="42" MaxHeight="100"/>
                  <StackPanel Orientation="Horizontal" Spacing="6"><Button Name="AskSide"/><Button Name="QuoteSide"/></StackPanel>
                </StackPanel>
              </Border>
                </StackPanel>
              </ScrollViewer>
              <Grid RowDefinitions="Auto,Auto">
                <composer:PlanStrip Name="ComposerPlan" Margin="14,0,14,0" IsVisible="False"/>
                <ctl:StudioComposer Grid.Row="1" Name="ComposeSurface" Margin="0,0,0,35" HorizontalAlignment="Stretch" Height="NaN" MinHeight="98">
                  <Grid Name="ComposeRows" RowDefinitions="30,Auto,Auto,Auto,46">
                    <Grid Name="ComposeRunState" Grid.Row="0" ColumnDefinitions="*,Auto" Margin="12,6,12,0" Height="24">
                      <Border Name="ComposerRunBadge" HorizontalAlignment="Left" VerticalAlignment="Center" Classes="compose-run-badge"
                              Padding="8,0" Height="22" CornerRadius="{DynamicResource RSm}" IsVisible="False">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <composer:PlanRunMark Width="12" Height="12"/>
                          <TextBlock Name="ComposerRunClock" Classes="compose-run-clock" IsVisible="False" Opacity="0.78"
                                     FontSize="{DynamicResource StudioType12}" LineHeight="12" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Border>
                      <composer:RunTokens Name="ComposerRunTokens" Grid.Column="1" VerticalAlignment="Center" IsVisible="False"/>
                      <Button Name="ChangedFiles" Grid.Column="1" Classes="compose-changes compose-pill" IsVisible="False" VerticalAlignment="Center" AutomationProperties.AutomationId="action:changes.open">
                        <StackPanel Orientation="Horizontal" Spacing="5"><ctl:StudioLineText Name="ChangedFilesLabel"/><ctl:StudioLineText Name="ChangedAdded" Foreground="{DynamicResource AddBrush}"/><ctl:StudioLineText Name="ChangedRemoved" Foreground="{DynamicResource DelBrush}"/></StackPanel>
                      </Button>
                    </Grid>
                    <ScrollViewer Name="QueueScroll" Grid.Row="1" Margin="12,6,12,0" IsVisible="False"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                      <StackPanel Name="QueueStrip" Spacing="6"/>
                    </ScrollViewer>
                    <StackPanel Name="AttachmentArea" Grid.Row="2" Margin="16,6,16,0" Spacing="4" IsVisible="False">
                      <WrapPanel Name="AttachmentStrip"/>
                      <TextBlock Name="AttachmentWarning" IsVisible="False" FontSize="{DynamicResource StudioType10}" Foreground="{DynamicResource WarnInkBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBox Name="Composer" Classes="compose-input" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap"
                             Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0" MinHeight="42" MaxHeight="168"
                             FontFamily="{DynamicResource ConversationUiFamily}" FontWeight="Medium" FontSize="{DynamicResource StudioType14}" LineHeight="{DynamicResource StudioUserHeight}"
                             Foreground="{DynamicResource TextBrush}" PlaceholderForeground="{DynamicResource MutedBrush}" VerticalContentAlignment="Top"
                             Margin="16,10,16,0" AutomationProperties.AutomationId="role:combobox" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                      <TextBox.Resources><Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness><SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/></TextBox.Resources>
                    </TextBox>
                    <Grid Name="ComposeFooter" Grid.Row="4" ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="*,0,0" Margin="8,6,8,8" ColumnSpacing="2">
                      <WrapPanel Name="ComposeTools" Orientation="Horizontal" ItemSpacing="2" LineSpacing="2" VerticalAlignment="Center">
                        <Button Name="Attach" Classes="compose-tool compose-icon"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource Glyph.plus}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Button>
                        <Button Name="SideQuestion" Classes="compose-tool compose-icon" AutomationProperties.AutomationId="action:side.toggle"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource Glyph.session}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Button>
                        <Button Name="RefinePrompt" Classes="compose-tool compose-icon" AutomationProperties.AutomationId="action:prompt.refine"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource Glyph.fresh}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Button>
                        <Button Name="PlanMode" BorderThickness="1" Classes="compose-tool compose-pill compose-plan" AutomationProperties.AutomationId="action:plan.mode"><StackPanel Orientation="Horizontal" Spacing="4"><Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Data="{StaticResource Glyph.agent}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox><ctl:StudioLineText Name="PlanModeLabel" Text="Agent" Classes="compose-tool-label" VerticalAlignment="Center"/><Viewbox Classes="compose-plan-chevron" Width="11" Height="11"><Canvas Width="24" Height="24"><Path Data="{StaticResource Compose.down}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></StackPanel></Button>
                        <Button Name="ComposeBranch" BorderThickness="1" Classes="compose-tool compose-pill compose-branch"><StackPanel Orientation="Horizontal" Spacing="4"><Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Data="{StaticResource Compose.branch}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox><ctl:StudioLineText Name="ComposeBranchLabel" Text="main" Classes="compose-tool-label" VerticalAlignment="Center"/><Viewbox Width="11" Height="11"><Canvas Width="24" Height="24"><Path Data="{StaticResource Compose.down}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></StackPanel></Button>
                        <Button Name="ApprovalMode" BorderThickness="1" Classes="compose-tool compose-pill compose-policy" AutomationProperties.AutomationId="action:chrome.policy"><StackPanel Orientation="Horizontal" Spacing="4"><Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Name="ApprovalShield" Data="{StaticResource Glyph.tools}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/>
                          <Path Name="ApprovalWarningIcon" IsVisible="False" Data="M10.3 4.1 2.4 18a1.9 1.9 0 0 0 1.7 2.9h15.8a1.9 1.9 0 0 0 1.7-2.9L13.7 4.1a2 2 0 0 0-3.4 0Z M12 9v4 M12 17h.01"
                                Stroke="{DynamicResource WarnInkBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/>
                        </Canvas></Viewbox><ctl:StudioLineText Name="ApprovalModeLabel" Text="询问" Classes="compose-tool-label" VerticalAlignment="Center"/><Viewbox Classes="compose-policy-chevron" Width="11" Margin="1,0,0,0" Height="11"><Canvas Width="24" Height="24"><Path Data="{StaticResource Compose.down}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></StackPanel></Button>
                      </WrapPanel>
                      <StackPanel Grid.Column="1" Name="ComposeModel" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="0" VerticalAlignment="Center">
                        <Button Name="ModelButton" Classes="compose-tool compose-model" BorderThickness="0" Padding="5,0,1,0" MinWidth="0" MaxWidth="180">
                          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Viewbox Name="ModelMark" Width="14" Height="14" IsVisible="False"><Canvas Width="24" Height="24"><Path Name="ModelMarkPath" Data="{StaticResource Compose.deepseek}" Fill="#4D6BFE"/></Canvas></Viewbox><Border Name="ModelInitial" Width="14" Height="14" CornerRadius="4" IsVisible="False" VerticalAlignment="Center"><TextBlock Name="ModelInitialText" FontSize="{DynamicResource StudioType9}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ctl:StudioLineText Name="ModelLabel" ClipToBounds="True" LineHeight="{DynamicResource ComposeModelLineHeight}" FontSize="{DynamicResource StudioType13}" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Viewbox Classes="compose-compact-model-chevron" Width="10" Height="10"><Canvas Width="24" Height="24"><Path Data="{StaticResource Compose.down}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></StackPanel>
                        </Button>
                        <Border Name="EffortSeparator" Width="1" Height="12" Background="{DynamicResource HairBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <Button Name="EffortButton" Classes="compose-tool compose-effort" Padding="6,0,8,0" BorderThickness="0"><StackPanel Orientation="Horizontal" Spacing="6"><StackPanel Orientation="Horizontal" Spacing="3"><Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Data="{StaticResource Glyph.model}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox><ctl:StudioLineText Name="EffortLabel" FontSize="{DynamicResource StudioType13}" FontWeight="Normal" LineHeight="{DynamicResource StudioType13}" VerticalAlignment="Center"/></StackPanel><Viewbox Width="11" Height="11"><Canvas Width="24" Height="24"><Path Data="{StaticResource Compose.down}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></StackPanel></Button>
                      </StackPanel>
                      <Grid Name="NarrowComposeControls" Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" Margin="0,2,0,0" IsVisible="False"/>
                      <Grid Name="NarrowRunningModel" Grid.Row="3" Grid.ColumnSpan="4" Margin="0,2,0,0" IsVisible="False"/>
                      <Button Name="Stop" Grid.RowSpan="2" Grid.Column="2" Classes="compose-tool compose-stop" Width="32" Height="32" IsVisible="False" CornerRadius="16" Margin="4,0,0,0"><PathIcon Width="15" Height="15" Data="M5 5H19V19H5Z"/></Button>
                      <Button Name="Send" FontSize="{DynamicResource StudioType13}" FontWeight="SemiBold" Grid.RowSpan="2" Grid.Column="3" Classes="compose-tool compose-send" Width="32" Height="32" Margin="4,0,0,0" CornerRadius="16" Padding="0" AutomationProperties.AutomationId="action:session.send"><StackPanel Orientation="Horizontal" Spacing="5"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Data="{StaticResource Compose.arrow}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox><ctl:StudioLineText Name="SendIntent" IsVisible="False" VerticalAlignment="Center"/></StackPanel></Button>
                    </Grid>
                    <ctl:ComposerSweep Grid.RowSpan="5" BorderThickness="1" CornerRadius="{DynamicResource RLg}" Ink="{DynamicResource Focus}" IsHitTestVisible="False" Opacity="0"/>
                    <composer:ModelPicker Name="ModelPicker" Grid.Row="4" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                    <composer:ComposerPopup Name="ModePopup" Grid.Row="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" PreferredWidth="300" MenuPadding="0,0,0,6">
                      <composer:ComposerPopup.Panel>
                        <composer:ModePanel Name="ModePanel"/>
                      </composer:ComposerPopup.Panel>
                    </composer:ComposerPopup>
                    <composer:ComposerPopup Name="PolicyPopup" Grid.Row="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" PreferredWidth="340" MenuPadding="8" MotionMilliseconds="180">
                      <composer:ComposerPopup.Panel>
                        <composer:PolicyPanel Name="PolicyPanel"/>
                      </composer:ComposerPopup.Panel>
                    </composer:ComposerPopup>
                    <composer:ComposerPopup Name="BranchPopup" Grid.Row="4" HorizontalAlignment="Left" VerticalAlignment="Bottom" PreferredWidth="340" MenuPadding="0">
                      <composer:ComposerPopup.Panel>
                        <composer:BranchPanel Name="BranchPanel"/>
                      </composer:ComposerPopup.Panel>
                    </composer:ComposerPopup>
                  </Grid>
                </ctl:StudioComposer>
                <Border Grid.Row="1" Height="27" VerticalAlignment="Bottom" RenderTransform="translate(0px,-3px)" Padding="2,0" TextElement.FontSize="{DynamicResource StudioType11}" TextElement.Foreground="{DynamicResource GhostBrush}" AutomationProperties.AutomationId="class:studio-meterrail">
                  <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
                  <ctl:StudioHoverCard Name="SpeedHover" CardWidth="268" OpenOnFocus="True">
                    <ctl:StudioHoverCard.Anchor><Button Name="SpeedToggle" Classes="compose-context"><StackPanel Orientation="Horizontal" Spacing="5"><ctl:StudioSparkline Name="SpeedSpark" Width="44" Height="13" IsVisible="False" Stroke="{DynamicResource FaintBrush}"/><ctl:StudioLineText Name="SpeedText" Classes="compose-reading" TextAlignment="Right" Text="—"/><ctl:StudioLineText Name="SpeedUnit" Text="tok/s"/><Border Name="SpeedLive" Width="4" Height="4" Margin="1,0,0,0" CornerRadius="2" Background="{DynamicResource GhostBrush}" VerticalAlignment="Center"/></StackPanel></Button></ctl:StudioHoverCard.Anchor>
                    <ctl:StudioHoverCard.Card><metrics:SpeedDetailCard Name="SpeedDetails"/></ctl:StudioHoverCard.Card>
                  </ctl:StudioHoverCard>
                  <ctl:StudioHoverCard Name="CacheHover" Grid.Column="1" Gap="7" CardWidth="360" PinOnClick="True">
                    <ctl:StudioHoverCard.Anchor><Button Name="CacheToggle" Classes="compose-context" AutomationProperties.AutomationId="action:metrics.details"><StackPanel Orientation="Horizontal" Spacing="5"><Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Data="{StaticResource Compose.bolt}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox><ctl:StudioLineText Name="CacheLabel"/><ctl:StudioLineText Name="CacheText" Classes="compose-reading" Text="—"/></StackPanel></Button></ctl:StudioHoverCard.Anchor>
                    <ctl:StudioHoverCard.Card><metrics:SessionOverviewCard Name="CacheDetails"/></ctl:StudioHoverCard.Card>
                  </ctl:StudioHoverCard>
                  <ctl:StudioHoverCard Name="ContextHover" Grid.Column="2" Gap="7" CardWidth="360" PinOnClick="True">
                    <ctl:StudioHoverCard.Anchor><Button Name="ContextToggle" Classes="compose-context"><StackPanel Orientation="Horizontal" Spacing="5"><Grid Name="ContextRing" Width="11" Height="11" Opacity="0.75" VerticalAlignment="Center"><Ellipse Fill="{DynamicResource ComposeContextHoleBrush}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="2"/><Path Name="ContextArc" Classes="context-arc" StrokeThickness="2"/></Grid><ctl:StudioLineText Name="ContextLabel"/><ctl:StudioLineText Name="MeterText" Classes="compose-reading" Text="0%"/></StackPanel></Button></ctl:StudioHoverCard.Anchor>
                    <ctl:StudioHoverCard.Card><metrics:ContextSummaryCard Name="ContextDetails"/></ctl:StudioHoverCard.Card>
                  </ctl:StudioHoverCard>
                  <StackPanel Name="ExtraMeters" Grid.Column="3" Orientation="Horizontal" Spacing="10" Margin="6,0" VerticalAlignment="Center"><StackPanel Name="TariffMeter" Orientation="Horizontal" Spacing="4" IsVisible="False"><ctl:StudioLineText Name="TariffText"/><ctl:StudioLineText Name="TariffRemainingText" Foreground="{DynamicResource MutedBrush}"/></StackPanel><ctl:StudioLineText Name="SessionCostText" IsVisible="False"/><ctl:StudioLineText Name="TurnCostText" IsVisible="False"/></StackPanel>
                  <Button Name="HideAmounts" Foreground="{DynamicResource ComposeMaskBrush}" Grid.Column="4" Classes="compose-context compose-mask" Width="22" Padding="5,0" AutomationProperties.AutomationId="action:metrics.hide-amounts"><Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Data="{StaticResource Compose.eye}" Stroke="{DynamicResource ComposeMaskBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/><Path Name="AmountMaskSlash" IsVisible="False" Data="M3 3 21 21" Stroke="{DynamicResource ComposeMaskBrush}" StrokeThickness="1.8" StrokeLineCap="Round"/></Canvas></Viewbox></Button>
                  <Button Name="WalletButton" Grid.Column="5" Classes="compose-context" IsVisible="False"><StackPanel Orientation="Horizontal" Spacing="5"><Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Data="{StaticResource Compose.wallet}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox><ctl:StudioLineText Name="WalletText" Classes="compose-reading"/></StackPanel></Button>
                  <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="1">
                    <composer:SubagentChip Name="Subagents" IsVisible="False"/>
                    <composer:ProcessChip Name="Processes" IsVisible="False"/>
                    <composer:BackgroundJobChip Name="BackgroundJobs" IsVisible="False"/>
                  </StackPanel>
                  </Grid>
                </Border>
                <composer:ComposerPendingSweep Name="PendingComposerSweep" Grid.Row="1" Height="1"
                                               VerticalAlignment="Bottom" Margin="0,0,0,28" Ink="{DynamicResource NetBrush}"
                                               ClipToBounds="True" IsHitTestVisible="False" IsVisible="False"/>
              </Grid>
            </StackPanel>
          </Grid>
          <Border Name="WorkbenchPanel" Grid.Column="1" Margin="0,8,8,8" AutomationProperties.AutomationId="class:workbench" IsVisible="False"
                  TextElement.FontFamily="{DynamicResource WorkbenchUiFamily}" TextElement.FontWeight="Medium"
                  Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
            <Grid RowDefinitions="42,*">
              <Grid UseLayoutRounding="False" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="2" AutomationProperties.AutomationId="class:workbench-tabs" Background="{DynamicResource PageBrush}">
                <Border Grid.ColumnSpan="5" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource BorderBrush}" IsHitTestVisible="False"/>
                <Button Name="ToggleExplorer" Classes="wb-header-button wb-header-files" Margin="8,0,0,1" AutomationProperties.AutomationId="action:workbench.files">
                  <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource Glyph.folder}" Stroke="{Binding #ToggleExplorer.Foreground}" StrokeThickness="1.8" StrokeJoin="Round" StrokeLineCap="Round"/></Canvas></Viewbox>
                    <Border Name="GitCountBadge" Background="{DynamicResource TextBrush}" CornerRadius="8" Padding="4,0" MinWidth="16" Height="16" IsVisible="False">
                      <TextBlock Name="TotalGitCount" FontSize="{DynamicResource StudioType11}" VerticalAlignment="Center" TextAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource PageBrush}"/>
                    </Border>
                  </StackPanel>
                </Button>
                <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                  <ScrollViewer Name="TabViewport" Height="35" Margin="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Bottom" VerticalContentAlignment="Top"
                                AutomationProperties.AutomationId="role:tablist">
                    <StackPanel Name="FileTabs" Orientation="Horizontal" Spacing="2" Height="35" VerticalAlignment="Top" />
                  </ScrollViewer>
                  <Button Name="TabOverflow" Grid.Column="1" Classes="wb-header-button wb-header-overflow" Margin="2,0,0,1" IsVisible="False" AutomationProperties.AutomationId="action:workbench.tab-overflow">
                    <Button.Flyout><MenuFlyout/></Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Name="TabOverflowCount" VerticalAlignment="Center"/>
                      <Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Data="m6 9 6 6 6-6" Stroke="{Binding #TabOverflow.Foreground}" StrokeThickness="1.8" StrokeJoin="Round" StrokeLineCap="Round"/></Canvas></Viewbox>
                    </StackPanel>
                  </Button>
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,0,1">
                  <Panel>
                    <Panel.IsVisible>
                      <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                        <Binding Path="#BackToEditor.IsVisible"/>
                        <Binding Path="!#WorkbenchStart.IsVisible"/>
                      </MultiBinding>
                    </Panel.IsVisible>
                    <Button Name="BackToEditor" Height="28" IsVisible="False"/>
                  </Panel>
                  <Button Name="NewSurface" Classes="wb-header-button" AutomationProperties.AutomationId="action:workbench.new">
                    <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource Glyph.plus}" Stroke="{Binding #NewSurface.Foreground}" StrokeThickness="1.8" StrokeLineCap="Round"/></Canvas></Viewbox>
                  </Button>
                </StackPanel>
                <Button Name="FullWorkbench" Grid.Column="3" Classes="wb-header-button" Margin="0,0,0,1" AutomationProperties.AutomationId="action:browser.full">
                  <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M15 3h6v6 m0-6-7 7 m-11 11 7-7 M9 21H3v-6" Stroke="{Binding #FullWorkbench.Foreground}" StrokeThickness="1.8" StrokeJoin="Round" StrokeLineCap="Round"/></Canvas></Viewbox>
                </Button>
                <Button Name="CloseWorkbench" Grid.Column="4" Classes="wb-header-button" Margin="0,0,6,1" AutomationProperties.AutomationId="action:workbench.dismiss">
                  <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Data="m18 6-12 12 M6 6l12 12" Stroke="{Binding #CloseWorkbench.Foreground}" StrokeThickness="1.8" StrokeLineCap="Round"/></Canvas></Viewbox>
                </Button>
              </Grid>
              <Grid Name="WorkspaceBody" Grid.Row="1" ColumnDefinitions="Auto,*" IsVisible="{Binding !#WorkbenchStart.IsVisible}"
                    AutomationProperties.AutomationId="class:workbench-body">
                <Grid Name="ExplorerPane" UseLayoutRounding="False" Width="190" RowDefinitions="34,48,*" Background="{DynamicResource PageBrush}"
                      IsVisible="False" AutomationProperties.AutomationId="class:workbench-explorer">
                  <Border Padding="6,0,10,0" Margin="0,0,1,0" AutomationProperties.AutomationId="class:workbench-explorer-head"><Grid ColumnDefinitions="18,*,28,28,28" ColumnSpacing="8">
                    <Button Name="FilesTab" Classes="icon" Width="18" Height="22" Content="⌄"/>
                    <StackPanel Grid.Column="1" Margin="4,0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <TextBlock Name="ExplorerHeading" FontSize="{DynamicResource StudioType13}" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Name="ExplorerCount" FontSize="{DynamicResource StudioType10}" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Name="HiddenFiles" Grid.Column="2" Classes="icon wb-open-editor" Width="28" AutomationProperties.AutomationId="action:workbench.hidden"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource Compose.eye}" Stroke="{DynamicResource FaintBrush}" StrokeThickness="1.8"/><Path Name="HiddenSlash" Data="M3 3l18 18" Stroke="{DynamicResource FaintBrush}" StrokeThickness="1.8"/></Canvas></Viewbox></Button>
                    <Button Name="OpenWorkspaceEditor" Grid.Column="3" Classes="icon wb-open-editor" Width="28" AutomationProperties.AutomationId="action:workspace.editor"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="m8 6-6 6 6 6 M16 6l6 6-6 6 M14 3l-4 18" Stroke="{DynamicResource FaintBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox></Button>
                    <Button Name="RevealWorkspace" Grid.Column="4" Classes="icon wb-open-editor" Width="28" AutomationProperties.AutomationId="action:workbench.reveal"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="M4 10V4h6 M14 4h6v6 M20 14v6h-6 M10 20H4v-6" Stroke="{DynamicResource FaintBrush}" StrokeThickness="1.8" StrokeLineCap="Round"/></Canvas></Viewbox></Button>
                  </Grid></Border>
                  <Border Grid.Row="1" Margin="8,7,9,7" Height="34" BorderThickness="1" CornerRadius="6" Padding="8,0" BorderBrush="{DynamicResource HairBrush}" Background="{DynamicResource SurfaceBrush}" AutomationProperties.AutomationId="class:workbench-search">
                    <Grid ColumnDefinitions="15,*" ColumnSpacing="6">
                      <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Stroke="{DynamicResource FaintBrush}" StrokeThickness="1.8" Data="{StaticResource Glyph.search}"/></Canvas></Viewbox>
                      <TextBox Name="WorkbenchSearch" Grid.Column="1" Height="17" MinHeight="0" VerticalAlignment="Center" FontSize="{DynamicResource StudioType12}" Padding="2,0" BorderThickness="0" Background="Transparent" AutomationProperties.AutomationId="action:workbench.search"/>
                      <Button Name="ClearWorkbenchSearch" Grid.Column="1" Classes="icon" Width="20" Height="20" Padding="0" HorizontalAlignment="Right" IsVisible="False" Content="×" AutomationProperties.AutomationId="action:workbench.clear-search"/>
                    </Grid>
                  </Border>
                  <ScrollViewer Name="ExplorerScroller" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,1,0">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBlock Name="GitError" IsVisible="False" TextWrapping="Wrap" Margin="6,3" Foreground="{DynamicResource ErrBrush}"/>
                        <Button Name="GitRetry" Grid.Column="1" Classes="git-flat" IsVisible="False" Margin="0,3" FontSize="{DynamicResource StudioType10}" VerticalAlignment="Top"/>
                      </Grid>
                      <StackPanel Name="GitRepositories"/>
                      <Border Height="34" Padding="6,0,10,0" AutomationProperties.AutomationId="class:workbench-explorer-head">
                      <Grid ColumnDefinitions="18,*" ColumnSpacing="6">
                        <Button Name="ToggleFileList" Classes="git-flat" Width="18" Height="18" VerticalAlignment="Center" AutomationProperties.AutomationId="action:workbench.files-fold">
                          <Viewbox Name="FileListChevron" Width="12" Height="12"><Canvas Width="24" Height="24"><Path Data="M6 9l6 6 6-6" Stroke="{DynamicResource FaintBrush}" StrokeThickness="1.8"/></Canvas></Viewbox>
                        </Button>
                        <TextBlock Name="FileListHeading" Grid.Column="1" FontSize="{DynamicResource StudioType13}" FontWeight="Bold" VerticalAlignment="Center"/>
                      </Grid>
                      </Border>
                      <ListBox Name="WorkspaceFiles" AutoScrollToSelectedItem="False" SelectionChanged="OnFileSelected" Background="Transparent" BorderThickness="0" Padding="0,2,0,16">
                        <ListBox.ItemTemplate><DataTemplate x:DataType="workbench:WorkspaceFileEntry"><workbench:WorkspaceFileRow/></DataTemplate></ListBox.ItemTemplate>
                      </ListBox>
                      <TextBlock Name="NoWorkspaceFiles" IsVisible="False" Margin="12,18" FontSize="{DynamicResource StudioType11}" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                  </ScrollViewer>
                  <Border Grid.RowSpan="3" Width="1" HorizontalAlignment="Right" Background="{DynamicResource HairBrush}" IsHitTestVisible="False"/>
                  <Thumb Name="ExplorerGrip" Grid.RowSpan="3" Width="5" HorizontalAlignment="Right" Background="Transparent"
                         Cursor="SizeWestEast" ZIndex="2"/>
                </Grid>
                <Grid Name="WorkspaceCanvas" Grid.Column="1" AutomationProperties.AutomationId="class:workbench-canvas">
                  <Grid Name="FileCanvas" RowDefinitions="40,*,Auto" Background="{DynamicResource RaisedBrush}">
                    <Grid.IsVisible>
                      <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                        <Binding Path="!#ManualBrowserHost.IsVisible"/>
                        <Binding Path="!#BackgroundJobHost.IsVisible"/>
                        <Binding Path="!#SubagentRunHost.IsVisible"/>
                        <Binding Path="!#WorkbenchEmpty.IsVisible"/>
                      </MultiBinding>
                    </Grid.IsVisible>
                  <Grid UseLayoutRounding="False" AutomationProperties.AutomationId="class:workbench-filebar">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" Margin="12,0,8,0">
                      <TextBlock Name="WorkbenchTitle" VerticalAlignment="Center" FontSize="{DynamicResource StudioType12}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Name="Breadcrumb" VerticalAlignment="Center" FontFamily="{DynamicResource StudioMonoFamily}"
                                 FontSize="{DynamicResource StudioType12}" FontWeight="Normal" TextTrimming="CharacterEllipsis" IsVisible="False"/>
                      <Button Name="EndTerminal" Grid.Column="1" IsVisible="False"/>
                      <Border Name="FileModeSelector" Grid.Column="1" Background="{DynamicResource OverlayBrush}" CornerRadius="7" Padding="2" VerticalAlignment="Center"
                              IsVisible="{Binding #FileModes.IsVisible}">
                        <StackPanel Name="FileModes" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" IsVisible="False">
                          <Button Name="PreviewFile" Classes="file-mode" IsVisible="False"/>
                          <Button Name="EditFile" Classes="file-mode"/>
                          <Button Name="DiffFile" Classes="file-mode" Content="Diff"/>
                        </StackPanel>
                      </Border>
                      <Grid Grid.Column="2">
                        <Border Name="ReadOnlyBadge" Classes="readonly-badge" IsVisible="False">
                          <TextBlock Name="ReadOnlyBadgeText" FontSize="{DynamicResource StudioType12}" Foreground="{DynamicResource MutedBrush}"/>
                        </Border>
                        <Button Name="SaveFile" Classes="wb-file-save" AutomationProperties.AutomationId="action:workbench.save" IsEnabled="False">
                          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                              <Canvas Width="24" Height="24"><Path Data="{StaticResource Glyph.check}" Stroke="{Binding #SaveFile.Foreground}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas>
                            </Viewbox>
                            <TextBlock Name="SaveFileLabel" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Button>
                      </Grid>
                      <Button Name="FileMore" Grid.Column="3" Width="28" Height="28" Padding="0" AutomationProperties.AutomationId="action:workbench.file-more">
                        <Viewbox Width="13" Height="13"><Canvas Width="24" Height="24">
                          <Path Data="M5 12h.01 M12 12h.01 M19 12h.01" Stroke="{Binding #FileMore.Foreground}" StrokeThickness="2.8" StrokeLineCap="Round"/>
                        </Canvas></Viewbox>
                      </Button>
                    </Grid>
                    <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource HairBrush}" IsHitTestVisible="False"/>
                  </Grid>
                  <workbench:WorkbenchFileEditor Name="FileEditor" Grid.Row="1" Classes="workbench-editor"
                           IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" Background="Transparent" BorderThickness="0"
                           Padding="4,4,0,0" FontFamily="{DynamicResource StudioMonoFamily}" FontSize="{DynamicResource StudioType12}" FontWeight="Normal"
                           Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}" TextWrapping="NoWrap"
                           CanvasBrush="{DynamicResource RaisedBrush}" ActiveLineBrush="{DynamicResource OverlayBrush}"
                           LineNumberBrush="{DynamicResource GhostBrush}" ActiveLineNumberBrush="{DynamicResource MutedBrush}"
                           ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <workbench:WorkbenchFileEditor.InnerLeftContent>
                      <Border Width="{Binding #FileEditor.GutterWidth}" IsHitTestVisible="False"/>
                    </workbench:WorkbenchFileEditor.InnerLeftContent>
                  </workbench:WorkbenchFileEditor>
                  <ScrollViewer Grid.Row="1" Name="RenderedFile" Padding="10" IsVisible="False"/>
                  <Border Name="FileErrorPanel" Grid.Row="1" IsVisible="False" Background="{DynamicResource RaisedBrush}" Padding="24">
                    <StackPanel MaxWidth="420" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Name="FileErrorText" TextWrapping="Wrap" TextAlignment="Center" FontSize="{DynamicResource StudioType12}" Foreground="{DynamicResource MutedBrush}"/>
                      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button Name="FileErrorRetry" Classes="wb-command" Height="30" Padding="12,0"/>
                        <Button Name="FileErrorClose" Classes="wb-command" Height="30" Padding="12,0"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <ContentControl Grid.Row="1" Name="TerminalSurface" IsVisible="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                  <Border Name="FileStatus" Grid.Row="2" IsVisible="False" Height="28"
                          BorderThickness="0,1,0,0" BorderBrush="{DynamicResource HairBrush}" Padding="12,0"
                          Background="{DynamicResource RaisedBrush}" AutomationProperties.AutomationId="class:workbench-status">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14" VerticalAlignment="Center">
                      <TextBlock Name="FileLanguage" FontSize="{DynamicResource StudioType11}" FontWeight="Normal" Foreground="{DynamicResource FaintBrush}"/>
                      <TextBlock Name="FileLine" Grid.Column="2" FontSize="{DynamicResource StudioType11}" FontWeight="Normal" Foreground="{DynamicResource FaintBrush}"/>
                      <TextBlock Name="FileDirty" Grid.Column="3" FontSize="{DynamicResource StudioType11}" FontWeight="Normal" Foreground="{DynamicResource WarnInkBrush}" IsVisible="False"/>
                    </Grid>
                  </Border>
                  </Grid>
                  <ctl:StudioSurfaceHost Name="ManualBrowserHost" IsVisible="False"/>
                  <ContentControl Name="BackgroundJobHost" IsVisible="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                  <ContentControl Name="SubagentRunHost" IsVisible="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                  <Border Name="WorkbenchEmpty" IsVisible="False" Margin="16,24" MaxWidth="320" Padding="18,20"
                          VerticalAlignment="Center" Background="{DynamicResource RaisedBrush}"
                          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                          AutomationProperties.AutomationId="class:workbench-state">
                    <StackPanel Spacing="6">
                      <Viewbox Width="18" Height="18" HorizontalAlignment="Center"><Canvas Width="24" Height="24">
                        <Path Data="{StaticResource Glyph.file-text}"
                              Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" StrokeJoin="Round" StrokeLineCap="Round"/>
                      </Canvas></Viewbox>
                      <TextBlock Name="WorkbenchEmptyTitle" Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource StudioType13}"
                                 FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                      <TextBlock Name="WorkbenchEmptyHint" Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource StudioType12}"
                                 TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </Grid>
              <workbench:WorkbenchLauncher Name="WorkbenchStart" Grid.Row="1" IsVisible="False"/>
            </Grid>
          </Border>
          <ctl:StudioSidePanel Name="ContextPanel" Grid.Column="2" IsVisible="False">
            <StackPanel Margin="14" Spacing="8">
              <TextBlock Name="ContextTitle" FontWeight="SemiBold" />
              <TextBlock Name="ContextReadout" Text="—" /><SelectableTextBlock Name="ContextBreakdown" TextWrapping="Wrap"/>
            </StackPanel>
          </ctl:StudioSidePanel>
        </Grid>
      </ctl:StudioPane>
      <Border Name="StopHint" Grid.Row="2" IsVisible="False" IsHitTestVisible="False" ZIndex="6"
              HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,52,0,0"
              Background="{DynamicResource FloatBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              CornerRadius="999" Padding="14,7" BoxShadow="0 4 16 0 #24000000">
        <TextBlock Name="StopHintText" Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource StudioType12}"
                   AutomationProperties.LiveSetting="Polite"/>
      </Border>
    </Grid>
    <ctl:StudioRail Name="Rail" Grid.Column="0" HorizontalAlignment="Stretch" FontFamily="{DynamicResource WorkbenchUiFamily}" FontWeight="Medium">
      <Grid RowDefinitions="44,40,44,*,52">
        <Grid Margin="20,12,13,0" ColumnDefinitions="*,28">
          <StackPanel Name="BrandLockup" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Border Name="BrandLogo" Background="{DynamicResource SidebarLogoBrush}" Margin="5,0,2,0" Width="72" Height="17"><Border.OpacityMask><ImageBrush Source="/Assets/wordmark.png" Stretch="Uniform"/></Border.OpacityMask></Border>
            <Border Name="BrandTag" BorderThickness="1" BorderBrush="{DynamicResource HairBrush}" CornerRadius="5" Padding="6,0,5,0" Height="17" VerticalAlignment="Center">
              <TextBlock Text="STUDIO" FontSize="{DynamicResource StudioType11}" FontWeight="SemiBold" LineHeight="11" VerticalAlignment="Center" LetterSpacing="1.2" Foreground="{DynamicResource MutedBrush}"/>
            </Border>
          </StackPanel>
          <Button Name="CollapseRail" Classes="icon" Grid.Column="1" AutomationProperties.AutomationId="action:chrome.rail"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Data="{StaticResource Glyph.collapse}"/></Canvas></Viewbox></Button>
        </Grid>
        <Button Name="NewSession" Grid.Row="1" Margin="10,8,9,0" Height="32" Padding="12,0"
                Background="{DynamicResource RaisedBrush}" Foreground="{DynamicResource TextBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" FontSize="{DynamicResource StudioType13}"
                FontWeight="Medium" HorizontalContentAlignment="Center" HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="action:session.new">
          <Button.Template><ControlTemplate>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
              <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="8">
                <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Data="{StaticResource Glyph.plus}"/></Canvas></Viewbox>
                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Alt N" FontSize="{DynamicResource StudioType11}" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </ControlTemplate></Button.Template>
          <TextBlock Name="NewSessionLabel" FontSize="{DynamicResource StudioType13}" FontWeight="SemiBold" />
        </Button>
        <Grid Grid.Row="2" Margin="10,6,10,6">
          <TextBox Name="RailSearch" FontSize="{DynamicResource StudioType13}" Height="30" MinHeight="0" Padding="32,0,52,0" VerticalContentAlignment="Center" Foreground="{DynamicResource FaintBrush}" PlaceholderForeground="{DynamicResource FaintBrush}"
                   BorderThickness="1" BorderBrush="{DynamicResource HairBrush}" Background="{DynamicResource SurfaceBrush}" CornerRadius="7"/>
          <Border Margin="10,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"><Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Data="{StaticResource Glyph.search}"/></Canvas></Viewbox></Border>
          <TextBlock Text="Ctrl K" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource FaintBrush}" FontSize="{DynamicResource StudioType11}" IsHitTestVisible="False"/>
        </Grid>
        <rail:ProjectRail Grid.Row="3" Name="Projects" />
        <Grid Name="WorkspaceFooter" Grid.Row="4" Margin="10,0,10,10" Height="32" VerticalAlignment="Bottom" ColumnDefinitions="*,28" ColumnSpacing="5">
            <Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Top" Margin="4,-7,4,0" Background="{DynamicResource HairBrush}"/>
            <Button Name="OpenSettings" Classes="icon rail-settings" Width="NaN" Height="32" FontWeight="Medium" AutomationProperties.AutomationId="action:chrome.settings"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,0" />
            <Button Name="OpenAccount" Classes="icon" Grid.Column="1" Tag="action:sidebar.tools">
              <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Data="m18 15-6-6-6 6"/></Canvas></Viewbox>
            </Button>
        </Grid>

      </Grid>
    </ctl:StudioRail>
    <workspace:WorkspaceNavigationRail Name="NavigationRail" IsVisible="False" />
    <Popup Name="QuickLinksPopup" PlacementTarget="{Binding #WorkspaceFooter}" Placement="TopEdgeAlignedLeft"
           VerticalOffset="-6" PlacementConstraintAdjustment="SlideX" ShouldUseOverlayLayer="True" IsLightDismissEnabled="True">
      <Border Name="QuickLinksFrame" Width="260" CornerRadius="15" Padding="10" BorderThickness="1"
              BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource FloatBrush}" BoxShadow="0 12 24 0 #20000000">
        <StackPanel Name="QuickLinksRows"/>
      </Border>
    </Popup>
    <Thumb Name="RailGrip" Grid.Column="0" Width="7" Margin="0,48,-6,0" HorizontalAlignment="Right"
           Background="Transparent" Focusable="True" Cursor="SizeWestEast">
      <Thumb.Template><ControlTemplate><Border Background="{TemplateBinding Background}" /></ControlTemplate></Thumb.Template>
    </Thumb>
  </Grid>
  <Grid Name="SettingsPanel" Focusable="True" Background="{DynamicResource SurfaceBrush}" IsVisible="False" RowDefinitions="48,*"
        TextElement.Foreground="{DynamicResource TextBrush}" TextElement.FontWeight="Medium">
    <Grid Name="SettingsTitleBar" ColumnDefinitions="Auto,*" Background="{DynamicResource PageBrush}" AutomationProperties.AutomationId="class:prefs-windowbar">
      <Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource HairBrush}" />
      <Button Name="CloseSettings" AutomationProperties.AutomationId="action:settings.close" Margin="12,0" Padding="10,0" Height="32"
              VerticalAlignment="Center" BorderThickness="0" Background="Transparent" CornerRadius="7">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Data="{StaticResource Glyph.back}" /></Canvas></Viewbox>
          <TextBlock Name="BackLabel" FontSize="{DynamicResource StudioType13}" FontWeight="Medium" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <TextBlock Name="SettingsError" Grid.Column="1" Margin="16,0" VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ErrBrush}" />
    </Grid>
    <Grid Name="SettingsSheet" Grid.Row="1" ColumnDefinitions="Auto,*" AutomationProperties.AutomationId="class:prefs-sheet">
      <Grid Name="SettingsRail" Width="240" RowDefinitions="46,32,8,*" Background="{DynamicResource PageBrush}">
        <TextBlock Name="SettingsTitle" Margin="18,0" FontWeight="SemiBold" FontSize="{DynamicResource StudioType14}" VerticalAlignment="Center" />
        <Grid Grid.Row="1" Margin="10,0" AutomationProperties.AutomationId="class:prefs-find">
          <TextBox Name="SettingsSearch" Height="32" MinHeight="0" CornerRadius="7" Padding="32,0,10,0" FontSize="{DynamicResource StudioType13}"
                   VerticalContentAlignment="Center" BorderThickness="1" BorderBrush="{DynamicResource HairBrush}" Background="{DynamicResource SurfaceBrush}"
                   PlaceholderForeground="{DynamicResource GhostBrush}" AutomationProperties.Name="{Binding #SettingsSearch.PlaceholderText}" />
          <Border HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0" IsHitTestVisible="False"><Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Data="{StaticResource Glyph.search}" /></Canvas></Viewbox></Border>
        </Grid>
        <ListBox Grid.Row="3" Name="SettingsNav" AutoScrollToSelectedItem="False" AutomationProperties.AutomationId="role:tablist" Padding="10,0,10,14" Background="Transparent" BorderThickness="0">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Classes="nav-strip" /></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate><DataTemplate>
            <Grid ColumnDefinitions="16,*,Auto">
              <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Classes="settings-nav-glyph" StrokeThickness="1.45" StrokeLineCap="Round" StrokeJoin="Round" Data="{ReflectionBinding Glyph}" /></Canvas></Viewbox>
              <TextBlock Grid.Column="1" Margin="9,0,0,0" FontSize="{DynamicResource StudioType13}" Text="{ReflectionBinding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <TextBlock Classes="nav-count" Grid.Column="2" Margin="9,0,0,0" FontSize="{DynamicResource StudioType12}" Text="{ReflectionBinding CountText}" Foreground="{DynamicResource FaintBrush}" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.RowSpan="4" Width="1" HorizontalAlignment="Right" Background="{DynamicResource HairBrush}" IsHitTestVisible="False"/>
      </Grid>
      <ScrollViewer Grid.Column="1" Name="SettingsScroller" AutomationProperties.AutomationId="role:tabpanel" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Name="SettingsBody" HorizontalAlignment="Stretch" UseLayoutRounding="False">
          <StackPanel Name="SettingsHeadingBlock" Spacing="6" Margin="0,0,0,16" AutomationProperties.AutomationId="class:prefs-pagetitle">
            <TextBlock Name="SettingsHeading" FontSize="{DynamicResource StudioType22}" LineHeight="28.6" FontWeight="SemiBold" />
            <TextBlock Name="SettingsDescription" FontSize="{DynamicResource StudioType13}" LineHeight="19.5" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
            <TextBlock Name="SettingsUsual" FontSize="{DynamicResource StudioType12}" LineHeight="16.8" TextWrapping="Wrap" Foreground="{DynamicResource FaintBrush}" />
          </StackPanel>
          <Border Name="SettingsIndex" IsVisible="False" ZIndex="1" Padding="0,12" Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource HairBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,14"
                  AutomationProperties.AutomationId="class:page-index">
            <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
            <WrapPanel Name="SettingsLinks" Margin="0,0,0,-6"/>
          </Border>
          <ContentControl Name="SettingsContent" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="class:prefs-col"/>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Column="1" Name="SearchResultsPanel" ZIndex="1" IsVisible="False"
              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HairBrush}"
              BorderThickness="1,0,0,0" CornerRadius="0,15,15,0" Padding="22,58,22,14">
        <Grid>
          <TextBlock Name="NoSettingsHits" IsVisible="False" Margin="9" Foreground="{DynamicResource FaintBrush}"
                     FontSize="{DynamicResource StudioType13}" LineHeight="19" TextWrapping="Wrap"/>
          <ListBox Name="SettingsHits" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   AutomationProperties.Name="{Binding #SettingsSearch.PlaceholderText}">
            <ListBox.ItemTemplate><DataTemplate>
              <StackPanel Spacing="4">
                <TextBlock Text="{ReflectionBinding Title}" FontSize="{DynamicResource StudioType13}" FontWeight="Medium"
                           LineHeight="19" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="{ReflectionBinding Page}" FontSize="{DynamicResource StudioType11}" LineHeight="16" Margin="0,1,0,0"
                           TextWrapping="Wrap" Foreground="{DynamicResource FaintBrush}"/>
              </StackPanel>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>
    <settings:RemoteDirectoryPicker Grid.RowSpan="2" Name="RemoteFolders" ZIndex="3" IsVisible="False"/>
    <Border Grid.RowSpan="2" Name="SettingsLeavePrompt" KeyboardNavigation.TabNavigation="Cycle" ZIndex="2" IsVisible="False" Padding="12">
      <Border.Background><SolidColorBrush Color="{DynamicResource Page}" Opacity="0.8"/></Border.Background>
      <Border Width="380" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BoxShadow="0 10 24 0 #26000000">
        <StackPanel>
          <Grid ColumnDefinitions="*,24" ColumnSpacing="12" Margin="16,16,16,12">
            <TextBlock Name="LeaveQuestion" FontSize="{DynamicResource StudioType14}" FontWeight="Bold"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
            <Button Name="DismissLeavePrompt" Grid.Column="1" Classes="preset-flat preset-muted" Width="24" Height="24">
              <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24">
                <Path Data="M6 6l12 12 M18 6 6 18" Stroke="{Binding #DismissLeavePrompt.Foreground}" StrokeThickness="2" StrokeLineCap="Round"/>
              </Canvas></Viewbox>
            </Button>
          </Grid>
          <StackPanel Margin="16,0,16,14" Spacing="8">
            <TextBlock Name="LeaveDetail" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="19"/>
            <WrapPanel Name="LeaveChanges" ItemSpacing="6" LineSpacing="6"/>
          </StackPanel>
          <Border BorderBrush="{DynamicResource HairBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Name="DiscardSettings" Classes="preset-act" MinWidth="82" Height="32" CornerRadius="7" Padding="14,0"
                      FontSize="{DynamicResource StudioType13}" Foreground="{DynamicResource ErrInkBrush}"/>
              <Button Name="KeepSettings" Classes="preset-major" MinWidth="82" Height="32" CornerRadius="7" Padding="14,0" FontWeight="Medium"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
  <Grid Name="SetupPanel" AutomationProperties.AutomationId="class:onb-stage" Background="{DynamicResource PageBrush}" IsVisible="False" RowDefinitions="64,*,43">
    <Border Grid.RowSpan="3" IsHitTestVisible="False">
      <Border.Background><RadialGradientBrush Center="78%,4%" GradientOrigin="78%,4%" RadiusX="64%" RadiusY="48%">
        <GradientStop Offset="0" Color="{DynamicResource StudioLightPrimary}"/><GradientStop Offset="0.72" Color="Transparent"/>
      </RadialGradientBrush></Border.Background>
    </Border>
    <Border Grid.RowSpan="3" IsHitTestVisible="False">
      <Border.Background><RadialGradientBrush Center="9%,84%" GradientOrigin="9%,84%" RadiusX="46%" RadiusY="38%">
        <GradientStop Offset="0" Color="{DynamicResource StudioLightSecondary}"/><GradientStop Offset="0.74" Color="Transparent"/>
      </RadialGradientBrush></Border.Background>
    </Border>
    <Border Grid.RowSpan="3" IsHitTestVisible="False">
      <Border.Background><RadialGradientBrush Center="92%,88%" GradientOrigin="92%,88%" RadiusX="42%" RadiusY="32%">
        <GradientStop Offset="0" Color="{DynamicResource StudioLightWarm}"/><GradientStop Offset="0.76" Color="Transparent"/>
      </RadialGradientBrush></Border.Background>
    </Border>
    <settings:OnboardingAtmosphere Name="SetupAtmosphere" Grid.RowSpan="3"/>
    <Border Name="SetupTitleBar" AutomationProperties.AutomationId="class:onb-brandbar" Padding="26,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
        <Image Source="/Assets/wordmark.png" Stretch="Uniform" Width="76" Height="18" />
        <TextBlock Text="STUDIO" FontSize="{DynamicResource StudioType9}" LetterSpacing="2" HorizontalAlignment="Right" />
      </StackPanel>
    </Border>
    <Border Name="WelcomeCard" Grid.Row="1" MaxWidth="900" Height="394" Margin="16,0" Padding="42,36,42,34" CornerRadius="15"
            Background="{DynamicResource SurfaceBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
            BoxShadow="0 22 48 0 #20191e19" VerticalAlignment="Center" AutomationProperties.AutomationId="class:onb-shell">
      <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="32" AutomationProperties.AutomationId="class:onb-card">
        <Grid Name="WelcomeContent" RowDefinitions="*,Auto,*" AutomationProperties.AutomationId="class:onb-welcome">
        <StackPanel Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Spacing="8">
          <settings:OnboardingReveal Name="WelcomeMark" Height="26" Width="120" Margin="0,0,0,24">
            <settings:OnboardingReveal.RenderTransform><TranslateTransform/></settings:OnboardingReveal.RenderTransform>
            <Image Source="/Assets/wordmark.png" Stretch="Uniform"/>
          </settings:OnboardingReveal>
          <TextBlock Name="WelcomeTitle" HorizontalAlignment="Center" FontSize="{DynamicResource StudioType22}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" AutomationProperties.AutomationId="class:onb-t">
            <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
          </TextBlock>
          <TextBlock Name="WelcomeDescription" AutomationProperties.AutomationId="class:onb-s" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="{DynamicResource StudioType12}" Foreground="{DynamicResource FaintBrush}">
            <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
          </TextBlock>
          <StackPanel Name="WelcomeActions" Spacing="8">
            <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
            <Button Name="BeginSetup" AutomationProperties.AutomationId="action:onboarding.begin" Width="240" Height="40" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Margin="0,16,0,0"
                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentFgBrush}" CornerRadius="10" />
            <Button Name="SkipWelcome" Height="24" MinHeight="0" Padding="8,0" FontSize="{DynamicResource StudioType12}" Foreground="{DynamicResource MutedBrush}" AutomationProperties.AutomationId="action:onboarding.skip" HorizontalAlignment="Center" Background="Transparent" BorderThickness="0" />
          </StackPanel>
          <TextBlock Name="SetupTime" AutomationProperties.AutomationId="class:onb-note" HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="{DynamicResource StudioType12}" Foreground="{DynamicResource MutedBrush}">
            <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
          </TextBlock>
        </StackPanel>
        </Grid>
        <settings:OnboardingDemo Name="SetupDemo" Grid.Column="1"/>
      </Grid>
    </Border>
    <Border Grid.Row="2" AutomationProperties.AutomationId="class:onb-foot">
      <TextBlock Name="SetupFoot" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{DynamicResource StudioType11}" Foreground="{DynamicResource MutedBrush}" />
    </Border>
    <settings:ProjectChoice Name="ProjectStep" Grid.Row="1" IsVisible="False">
      <settings:ProjectChoice.RenderTransform><TransformGroup><ScaleTransform/><TranslateTransform/></TransformGroup></settings:ProjectChoice.RenderTransform>
    </settings:ProjectChoice>
    <ScrollViewer Name="SetupForm" Grid.Row="1" IsVisible="False">
      <Border Name="SetupShell" MaxWidth="640" Margin="24,12" HorizontalAlignment="Stretch" VerticalAlignment="Center"
              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1" CornerRadius="15" Padding="42,36,42,34" ClipToBounds="True">
        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
        <StackPanel Name="SetupCard" Spacing="14">
          <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,8">
            <settings:OnboardingSteps Name="SetupProgress" VerticalAlignment="Center"/>
            <Button Name="DeferSetup" Grid.Column="1" Padding="0" MinHeight="20"
                    FontSize="{DynamicResource StudioType12}" Foreground="{DynamicResource MutedBrush}" Background="Transparent" BorderThickness="0"/>
          </Grid>
          <TextBlock Name="SetupTitle" Margin="0,2,0,0" LineHeight="27.5" FontSize="{DynamicResource StudioType22}"
                     FontWeight="Medium" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
          <TextBlock Name="SetupDescription" Margin="0,-5,0,5" LineHeight="20.4" FontSize="{DynamicResource StudioType12}"
                     Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" />
          <StackPanel Name="ServiceFields" Spacing="14">
            <UniformGrid Name="SetupServices" Columns="4" ColumnSpacing="8" RowSpacing="8" />
            <TextBox Name="ServiceAddress" Text="https://api.deepseek.com" />
            <TextBox Name="ServiceName" Text="deepseek" />
          </StackPanel>
          <StackPanel Name="ServiceKeyField" Spacing="6">
            <TextBlock Text="API key" LineHeight="15.4" FontSize="{DynamicResource StudioType11}"
                       FontWeight="Medium" Foreground="{DynamicResource FaintBrush}"/>
            <TextBox Name="ServiceKey" PlaceholderText="sk-…" MinHeight="42.6">
              <TextBox.RenderTransform><TranslateTransform/></TextBox.RenderTransform>
            </TextBox>
          </StackPanel>
          <TextBlock Name="SetupError" IsVisible="False" TextWrapping="Wrap" Foreground="{DynamicResource ErrInkBrush}"
                     FontSize="{DynamicResource StudioType12}" AutomationProperties.LiveSetting="Assertive"/>
          <Border Name="SetupFound" IsVisible="False" MinHeight="39" CornerRadius="{DynamicResource RMd}" Padding="12,10"
                  Background="{DynamicResource OkWashBrush}" AutomationProperties.LiveSetting="Polite">
            <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
            <StackPanel Spacing="8" Orientation="Horizontal">
              <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource Glyph.check}" Stroke="{DynamicResource OkInkBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox>
              <TextBlock Name="SetupFoundLabel" FontSize="{DynamicResource StudioType13}" FontWeight="Medium" Foreground="{DynamicResource OkInkBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <ComboBox Name="ServiceProtocol" IsVisible="False" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="action:onboarding.protocol"/>
          <StackPanel Name="SetupModelField" IsVisible="False" Spacing="6">
            <TextBlock Name="SetupModelLabel" LineHeight="15.4" FontSize="{DynamicResource StudioType11}"
                       FontWeight="Medium" Foreground="{DynamicResource FaintBrush}"/>
            <StackPanel Name="ModelOptions" IsVisible="False" Spacing="6"/>
            <ComboBox Name="ServiceModels" IsVisible="False" HorizontalAlignment="Stretch" />
            <TextBlock Name="SetupModelNote" Margin="0,12" LineHeight="19.2" FontSize="{DynamicResource StudioType12}"
                       Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,4,0,0" MinHeight="42">
            <Button Name="SetupBack" Classes="setup-back"/>
            <Button Name="ConnectProvider" Classes="setup-go" AutomationProperties.AutomationId="action:onboarding.connect">
              <Grid>
                <TextBlock Name="ConnectLabel" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Viewbox Name="ConnectSpinner" IsVisible="False" Width="16" Height="16">
                  <Canvas Width="16" Height="16">
                    <Path Classes="setup-spin-stem" Data="M4.7 2.9V13.1" Stroke="{Binding #ConnectProvider.Foreground}" StrokeThickness="1.7" StrokeLineCap="Round" StrokeDashArray="6,6"/>
                    <Path Classes="setup-spin-bowl" Data="M4.7 2.9h4.2a2.9 2.9 0 0 1 0 5.8H4.7" Stroke="{Binding #ConnectProvider.Foreground}" StrokeThickness="1.7" StrokeLineCap="Round" StrokeDashArray="10.3,10.3"/>
                    <Path Classes="setup-spin-leg" Data="M9 8.7l3.3 4.4" Stroke="{Binding #ConnectProvider.Foreground}" StrokeThickness="1.7" StrokeLineCap="Round" StrokeDashArray="3.24,3.24"/>
                  </Canvas>
                </Viewbox>
                <Viewbox Name="ConnectCheck" IsVisible="False" Width="16" Height="16">
                  <Canvas Width="24" Height="24"><Path Classes="setup-check" Data="{StaticResource Glyph.check}"
                    Stroke="{Binding #ConnectProvider.Foreground}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" StrokeDashArray="17.78,17.78"/></Canvas>
                </Viewbox>
              </Grid>
            </Button>
          </StackPanel>
          <TextBlock Name="SetupServiceNote" IsVisible="False" Margin="0,12" LineHeight="19.2" FontSize="{DynamicResource StudioType12}"
                     Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </ScrollViewer>
  </Grid>
  <StackPanel Name="WindowsCaption" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" IsVisible="False">
    <Button Name="Minimise" Content="─" Classes="caption" />
    <Button Name="Maximise" Content="□" Classes="caption" />
    <Button Name="CloseCaption" Content="×" Classes="caption" />
  </StackPanel>
  <Canvas Name="CopyNoticeLayer">
    <StackPanel Name="CopyNotices" Width="380" Spacing="8" Canvas.Right="16" Canvas.Bottom="16"
                AutomationProperties.AutomationId="class:toasts"/>
  </Canvas>
  <Border Name="GlobalError" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" MaxWidth="480" Padding="12" CornerRadius="8" Background="{DynamicResource FloatBrush}" BorderBrush="{DynamicResource ErrInkBrush}" BorderThickness="1" AutomationProperties.LiveSetting="Assertive">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><SelectableTextBlock Name="GlobalErrorText" TextWrapping="Wrap" Foreground="{DynamicResource ErrInkBrush}"/><Button Grid.Column="1" Classes="icon" Content="×" Click="OnDismissGlobalError"/></Grid>
  </Border>
  </Grid>
  </LayoutTransformControl>
    <startup:WelcomeCurtain Name="FirstRunCurtain" IsVisible="False"/>
    <startup:BootIntro Name="StartupIntro" IsVisible="False" ClipToBounds="True">
      <startup:BootIntro.Resources>
        <ResourceDictionary>
          <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="avares://Reasonix.Studio.Shell/Startup/BootWordmark.axaml"/>
          </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
      </startup:BootIntro.Resources>
    </startup:BootIntro>
  </Panel>
</Window>
