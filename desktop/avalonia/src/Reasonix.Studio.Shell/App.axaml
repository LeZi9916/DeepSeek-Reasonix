<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Reasonix.Studio.Shell.App"
             RequestedThemeVariant="Default">

  <!--
    The shell's token dictionary. It is a ResourceDictionary rather than a Styles
    document, so it is merged into the application's resources: a StyleInclude
    would demand IStyle and a dictionary cannot satisfy that.
  -->
  <Application.Resources>
    <ResourceDictionary>
      <x:String x:Key="StudioUiFontSources">avares://Reasonix.Studio.Shell/Assets/WorkbenchFonts#Reasonix Workbench UI, avares://Reasonix.Studio.Shell/Assets/WorkbenchFonts#Reasonix Workbench CJK, avares://Reasonix.Studio.Shell/Assets/WorkbenchFonts#Reasonix Workbench Full</x:String>
      <x:String x:Key="StudioMonoFontSources">avares://Reasonix.Studio.Shell/Assets/WorkbenchFonts#Reasonix Workbench Mono, avares://Reasonix.Studio.Shell/Assets/WorkbenchFonts#Reasonix Workbench CJK, avares://Reasonix.Studio.Shell/Assets/WorkbenchFonts#Reasonix Workbench Full</x:String>
      <FontFamily x:Key="DataReadingFamily">avares://Reasonix.Studio.Shell/Assets/DataFonts#Studio CJK Text, avares://Reasonix.Studio.Shell/Assets/WorkbenchFonts#Reasonix Workbench CJK, avares://Reasonix.Studio.Shell/Assets/WorkbenchFonts#Reasonix Workbench Full, sans-serif</FontFamily>
      <FontFamily x:Key="DataPathFamily">avares://Reasonix.Studio.Shell/Assets/DataFonts#Studio Code Text, avares://Reasonix.Studio.Shell/Assets/WorkbenchFonts#Reasonix Workbench CJK, avares://Reasonix.Studio.Shell/Assets/WorkbenchFonts#Reasonix Workbench Full, monospace</FontFamily>
      <FontFamily x:Key="WorkbenchUiFamily">avares://Reasonix.Studio.Shell/Assets/WorkbenchFonts#Reasonix Workbench UI, avares://Reasonix.Studio.Shell/Assets/WorkbenchFonts#Reasonix Workbench CJK, avares://Reasonix.Studio.Shell/Assets/WorkbenchFonts#Reasonix Workbench Full</FontFamily>
      <FontFamily x:Key="WorkbenchMonoFamily">avares://Reasonix.Studio.Shell/Assets/WorkbenchFonts#Reasonix Workbench Mono, avares://Reasonix.Studio.Shell/Assets/WorkbenchFonts#Reasonix Workbench CJK, avares://Reasonix.Studio.Shell/Assets/WorkbenchFonts#Reasonix Workbench Full</FontFamily>
      <FontFamily x:Key="ConversationUiFamily">avares://Reasonix.Studio.Shell/Assets/WorkbenchFonts#Reasonix Workbench UI, avares://Reasonix.Studio.Shell/Assets/WorkbenchFonts#Reasonix Workbench CJK, avares://Reasonix.Studio.Shell/Assets/WorkbenchFonts#Reasonix Workbench Full</FontFamily>
      <FontFamily x:Key="StudioMonoFamily">avares://Reasonix.Studio.Shell/Assets/WorkbenchFonts#Reasonix Workbench Mono, avares://Reasonix.Studio.Shell/Assets/WorkbenchFonts#Reasonix Workbench CJK, avares://Reasonix.Studio.Shell/Assets/WorkbenchFonts#Reasonix Workbench Full</FontFamily>
      <x:Double x:Key="StudioUserHeight">22.4</x:Double>
      <x:Double x:Key="ComposeModelLineHeight">19.5</x:Double>
      <x:Double x:Key="StudioReadingSize">14</x:Double>
      <x:Double x:Key="StudioReadingHeight">24.08</x:Double>
      <x:Double x:Key="WorkbenchReadingHeight">24.5</x:Double>
      <x:Double x:Key="WorkbenchDiffLineHeight">19.2</x:Double>
      <x:Double x:Key="WorkbenchDiffNoticeHeight">16.8</x:Double>
      <x:Double x:Key="KeyboardLabelLineHeight">19</x:Double>
      <x:Double x:Key="KeyboardChordLineHeight">18.6</x:Double>
      <x:Double x:Key="StudioType8">8</x:Double>
      <x:Double x:Key="StudioType9">9</x:Double>
      <x:Double x:Key="StudioType10">10</x:Double>
      <x:Double x:Key="StudioType11">11</x:Double>
      <x:Double x:Key="StudioType12">12</x:Double>
      <x:Double x:Key="StudioType13">13</x:Double>
      <x:Double x:Key="StudioType14">14</x:Double>
      <x:Double x:Key="StudioType15">15</x:Double>
      <x:Double x:Key="StudioType16">16</x:Double>
      <x:Double x:Key="StudioType17">17</x:Double>
      <x:Double x:Key="StudioType26">26</x:Double>
      <x:Double x:Key="StudioType18">18</x:Double>
      <x:Double x:Key="StudioType20">20</x:Double>
      <x:Double x:Key="StudioType22">22</x:Double>
      <x:Double x:Key="StudioType25">25</x:Double>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Reasonix.Studio.Controls/Themes/Tokens.axaml" />
        <ResourceInclude Source="avares://Reasonix.Studio.Controls/Themes/StudioIcons.axaml" />
        <ResourceInclude Source="avares://Reasonix.Studio.Shell/Settings/ProviderVendorMarks.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!--
      The Studio controls' own themes. They are a Styles document, which is what
      a page needs in scope for <ctl:StudioRail/> to resolve its template.
    -->
    <StyleInclude Source="avares://Reasonix.Studio.Controls/Themes/Skeleton.axaml" />
  </Application.Styles>
</Application>
