<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Reasonix.Studio.Shell.App"
             RequestedThemeVariant="Default">

  <!--
    The shell's token dictionary. It is a ResourceDictionary rather than a Styles
    document, so it is merged into the application's resources: a StyleInclude
    would demand IStyle and a dictionary cannot satisfy that.
  -->
  <Application.Resources>
    <ResourceDictionary>
      <FontFamily x:Key="StudioMonoFamily">monospace</FontFamily>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Reasonix.Studio.Controls/Themes/Tokens.axaml" />
        <ResourceInclude Source="avares://Reasonix.Studio.Controls/Themes/StudioIcons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!--
      The Studio controls' own themes. They are a Styles document, which is what
      a page needs in scope for <ctl:StudioRail/> to resolve its template.
    -->
    <StyleInclude Source="avares://Reasonix.Studio.Controls/Themes/Skeleton.axaml" />
  </Application.Styles>
</Application>
