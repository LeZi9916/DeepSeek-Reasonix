<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="using:Reasonix.Studio.Shell.Settings">
  <Style Selector="Window.motion settings|OnboardingGrid">
    <Style.Animations>
      <Animation Duration="0:0:36" IterationCount="Infinite">
        <KeyFrame Cue="0%"><Setter Property="Shift" Value="0"/></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Shift" Value="42"/></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Window.motion Border#Halo">
    <Style.Animations>
      <Animation Duration="0:0:8" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0.75"/><Setter Property="ScaleTransform.ScaleX" Value="1"/><Setter Property="ScaleTransform.ScaleY" Value="1"/>
        </KeyFrame>
        <KeyFrame Cue="50%" KeySpline="0.42,0,0.58,1">
          <Setter Property="Opacity" Value="1"/><Setter Property="ScaleTransform.ScaleX" Value="1.08"/><Setter Property="ScaleTransform.ScaleY" Value="1.08"/>
        </KeyFrame>
        <KeyFrame Cue="100%" KeySpline="0.42,0,0.58,1">
          <Setter Property="Opacity" Value="0.75"/><Setter Property="ScaleTransform.ScaleX" Value="1"/><Setter Property="ScaleTransform.ScaleY" Value="1"/>
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="RadioButton.setup-choice">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RMd}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template"><ControlTemplate>
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
              Padding="{TemplateBinding Padding}">
        <Grid ColumnDefinitions="Auto,*">
          <Border Name="ModelIndicator" Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center"
                  IsVisible="False" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5" CornerRadius="7"/>
          <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1" Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center" />
        </Grid>
      </Border>
    </ControlTemplate></Setter>
  </Style>
  <Style Selector="RadioButton.setup-service:pointerover:not(:disabled)">
    <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
  </Style>
  <Style Selector="RadioButton.setup-choice:checked">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="RadioButton.setup-choice:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="RadioButton.setup-service:checked">
    <Setter Property="BorderThickness" Value="1.5"/>
    <Setter Property="Padding" Value="11.5,9.5"/>
  </Style>
  <Style Selector="RadioButton.setup-model /template/ Border#ModelIndicator">
    <Setter Property="IsVisible" Value="True"/>
  </Style>
  <Style Selector="RadioButton.setup-model:checked /template/ Border#ModelIndicator">
    <Setter Property="BorderThickness" Value="4"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="RadioButton.setup-choice TextBlock.setup-choice-name">
    <Setter Property="FontSize" Value="{DynamicResource StudioType13}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="RadioButton.setup-model TextBlock.setup-choice-name">
    <Setter Property="FontFamily" Value="{DynamicResource StudioMonoFamily}"/>
  </Style>
  <Style Selector="RadioButton.setup-choice TextBlock.setup-choice-detail">
    <Setter Property="FontSize" Value="{DynamicResource StudioType11}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/>
  </Style>
  <Style Selector="Window.motion RadioButton.setup-choice">
    <Setter Property="Transitions"><Transitions>
      <BrushTransition Property="Background" Duration="0:0:0.12" Easing="0.16,1,0.3,1"/>
      <BrushTransition Property="BorderBrush" Duration="0:0:0.12" Easing="0.16,1,0.3,1"/>
      <ThicknessTransition Property="BorderThickness" Duration="0:0:0.12" Easing="0.16,1,0.3,1"/>
      <ThicknessTransition Property="Padding" Duration="0:0:0.12" Easing="0.16,1,0.3,1"/>
    </Transitions></Setter>
  </Style>
  <Style Selector="Window.motion RadioButton.setup-model /template/ Border#ModelIndicator">
    <Setter Property="Transitions"><Transitions>
      <BrushTransition Property="BorderBrush" Duration="0:0:0.12" Easing="0.16,1,0.3,1"/>
      <ThicknessTransition Property="BorderThickness" Duration="0:0:0.12" Easing="0.16,1,0.3,1"/>
    </Transitions></Setter>
  </Style>
  <Style Selector="Button.setup-go, Button.setup-back">
    <Setter Property="Template"><ControlTemplate>
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
              Padding="{TemplateBinding Padding}">
        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
    </ControlTemplate></Setter>
  </Style>
  <Style Selector="Button.setup-go">
    <Setter Property="MinWidth" Value="120"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RSm}"/>
    <Setter Property="Background" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="{DynamicResource StudioType13}"/>
    <Setter Property="FontWeight" Value="Medium"/>
  </Style>
  <Style Selector="Button.setup-go:disabled"><Setter Property="Opacity" Value="0.45"/></Style>
  <Style Selector="Button.setup-go.connected">
    <Setter Property="Background" Value="{DynamicResource OkBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource OkBrush}"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Window.motion Button.setup-go">
    <Setter Property="Transitions"><Transitions>
      <BrushTransition Property="Background" Duration="0:0:0.16" Easing="0.16,1,0.3,1"/>
      <BrushTransition Property="BorderBrush" Duration="0:0:0.16" Easing="0.16,1,0.3,1"/>
    </Transitions></Setter>
  </Style>
  <Style Selector="Button.setup-back">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource StudioType12}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Button.setup-back:pointerover"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
  <Style Selector="TextBox.setup-invalid"><Setter Property="BorderBrush" Value="{DynamicResource ErrBrush}"/></Style>
  <Style Selector="Window.motion TextBox.setup-invalid">
    <Style.Animations><Animation Duration="0:0:0.26">
      <KeyFrame Cue="0%"><Setter Property="TranslateTransform.X" Value="0"/></KeyFrame>
      <KeyFrame Cue="20%" KeySpline="0.16,1,0.3,1"><Setter Property="TranslateTransform.X" Value="-6"/></KeyFrame>
      <KeyFrame Cue="40%" KeySpline="0.16,1,0.3,1"><Setter Property="TranslateTransform.X" Value="5"/></KeyFrame>
      <KeyFrame Cue="60%" KeySpline="0.16,1,0.3,1"><Setter Property="TranslateTransform.X" Value="-3"/></KeyFrame>
      <KeyFrame Cue="80%" KeySpline="0.16,1,0.3,1"><Setter Property="TranslateTransform.X" Value="2"/></KeyFrame>
      <KeyFrame Cue="100%" KeySpline="0.16,1,0.3,1"><Setter Property="TranslateTransform.X" Value="0"/></KeyFrame>
    </Animation></Style.Animations>
  </Style>
  <Style Selector="Window.motion TextBlock#SetupError.shown">
    <Style.Animations><Animation Duration="0:0:0.18" Easing="0.16,1,0.3,1">
      <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
      <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
    </Animation></Style.Animations>
  </Style>
  <Style Selector="Window.motion Border#SetupFound.enter">
    <Style.Animations><Animation Duration="0:0:0.26" Easing="0.16,1,0.3,1">
      <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/><Setter Property="TranslateTransform.Y" Value="-8"/></KeyFrame>
      <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/><Setter Property="TranslateTransform.Y" Value="0"/></KeyFrame>
    </Animation></Style.Animations>
  </Style>
  <Style Selector="Window.motion Button.setup-go.checking Path.setup-spin-stem">
    <Style.Animations><Animation Duration="0:0:1.1" IterationCount="Infinite">
      <KeyFrame Cue="0%"><Setter Property="StrokeDashOffset" Value="6"/></KeyFrame>
      <KeyFrame Cue="60%" KeySpline="0.42,0,0.58,1"><Setter Property="StrokeDashOffset" Value="0"/></KeyFrame>
      <KeyFrame Cue="100%"><Setter Property="StrokeDashOffset" Value="0"/></KeyFrame>
    </Animation></Style.Animations>
  </Style>
  <Style Selector="Window.motion Button.setup-go.checking Path.setup-spin-bowl">
    <Style.Animations><Animation Duration="0:0:1.1" IterationCount="Infinite">
      <KeyFrame Cue="0%"><Setter Property="StrokeDashOffset" Value="10.3"/></KeyFrame>
      <KeyFrame Cue="60%" KeySpline="0.42,0,0.58,1"><Setter Property="StrokeDashOffset" Value="0"/></KeyFrame>
      <KeyFrame Cue="100%"><Setter Property="StrokeDashOffset" Value="0"/></KeyFrame>
    </Animation></Style.Animations>
  </Style>
  <Style Selector="Window.motion Button.setup-go.checking Path.setup-spin-leg">
    <Style.Animations><Animation Duration="0:0:1.1" IterationCount="Infinite">
      <KeyFrame Cue="0%"><Setter Property="StrokeDashOffset" Value="3.24"/></KeyFrame>
      <KeyFrame Cue="60%" KeySpline="0.42,0,0.58,1"><Setter Property="StrokeDashOffset" Value="0"/></KeyFrame>
      <KeyFrame Cue="100%"><Setter Property="StrokeDashOffset" Value="0"/></KeyFrame>
    </Animation></Style.Animations>
  </Style>
  <Style Selector="Window.motion Button.setup-go.connected Path.setup-check">
    <Style.Animations><Animation Duration="0:0:0.3" Easing="0,0,0.58,1">
      <KeyFrame Cue="0%"><Setter Property="StrokeDashOffset" Value="17.78"/></KeyFrame>
      <KeyFrame Cue="60%"><Setter Property="StrokeDashOffset" Value="0"/></KeyFrame>
      <KeyFrame Cue="100%"><Setter Property="StrokeDashOffset" Value="0"/></KeyFrame>
    </Animation></Style.Animations>
  </Style>
  <Style Selector="Border.onb-drop Rectangle.onb-drop-frame">
    <Setter Property="StrokeDashArray" Value="3,2"/>
    <Setter Property="Stroke" Value="{DynamicResource BorderBrush}"/>
  </Style>
  <Style Selector="Border.onb-drop.chosen">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
  </Style>
  <Style Selector="Border.onb-drop.chosen Rectangle.onb-drop-frame">
    <Setter Property="StrokeDashArray" Value=""/>
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="Border.onb-drop.over">
    <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
  </Style>
  <Style Selector="Border.onb-drop.over Rectangle.onb-drop-frame">
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="Window.motion Border.onb-drop">
    <Setter Property="Transitions"><Transitions>
      <BrushTransition Property="Background" Duration="0:0:0.16" Easing="0.16,1,0.3,1"/>
    </Transitions></Setter>
  </Style>
  <Style Selector="Window.motion Border.onb-drop Rectangle.onb-drop-frame">
    <Setter Property="Transitions"><Transitions>
      <BrushTransition Property="Stroke" Duration="0:0:0.16" Easing="0.16,1,0.3,1"/>
    </Transitions></Setter>
  </Style>
  <Style Selector="Window.motion Border.onb-drop.over settings|OnboardingStripes">
    <Style.Animations><Animation Duration="0:0:1.2" IterationCount="Infinite">
      <KeyFrame Cue="0%"><Setter Property="Shift" Value="0"/></KeyFrame>
      <KeyFrame Cue="100%"><Setter Property="Shift" Value="22.6"/></KeyFrame>
    </Animation></Style.Animations>
  </Style>
  <Style Selector="TextBox#ServiceKey">
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="Padding" Value="11,9"/>
    <Setter Property="PasswordChar" Value="•"/>
    <Setter Property="FontFamily" Value="{DynamicResource StudioMonoFamily}"/>
    <Setter Property="FontSize" Value="{DynamicResource StudioType12}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="PlaceholderForeground" Value="{DynamicResource GhostBrush}"/>
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RSm}"/>
  </Style>
  <Style Selector="TextBox#ServiceKey.setup-invalid">
    <Setter Property="BorderBrush" Value="{DynamicResource ErrBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="TextBox#ServiceKey.setup-invalid:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource ErrBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
</Styles>
