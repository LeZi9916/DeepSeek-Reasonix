<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.attachment-chip">
    <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HairBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="7,4"/>
    <Setter Property="Margin" Value="0,0,4,4"/>
  </Style>
  <Style Selector="TextBlock.attachment-name">
    <Setter Property="FontSize" Value="{DynamicResource StudioType11}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="MaxWidth" Value="180"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBlock.attachment-error">
    <Setter Property="FontSize" Value="{DynamicResource StudioType10}"/>
    <Setter Property="Foreground" Value="{DynamicResource ErrInkBrush}"/>
    <Setter Property="MaxWidth" Value="220"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.attachment-retry">
    <Setter Property="FontSize" Value="{DynamicResource StudioType10}"/>
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="2,0"/>
    <Setter Property="MinHeight" Value="0"/>
  </Style>
  <Style Selector="Button.attachment-retry:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="Button.attachment-remove">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="4"/>
  </Style>
  <Style Selector="Button.attachment-remove:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Background" Value="{DynamicResource HairBrush}"/>
  </Style>
</Styles>
