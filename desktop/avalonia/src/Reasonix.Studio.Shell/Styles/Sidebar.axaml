<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="SidebarLogoBrush" Color="#0153E5"/></ResourceDictionary>
        <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="SidebarLogoBrush" Color="#F0FFFFFF"/></ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <Style Selector="Button.rail-settings">
    <Setter Property="Template"><ControlTemplate>
      <Border Name="SettingsButtonSurface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
        <Grid ColumnDefinitions="15,*" ColumnSpacing="8">
          <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24"><Path Data="{StaticResource Glyph.common}" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox>
          <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" VerticalContentAlignment="Center" TextElement.FontFamily="{TemplateBinding FontFamily}"
                            TextElement.FontSize="{DynamicResource StudioType13}" TextElement.FontWeight="Medium"/>
        </Grid>
      </Border>
    </ControlTemplate></Setter>
  </Style>
  <Style Selector="Window.motion Button.rail-settings, Window.motion Button.rail-shortcuts">
    <Setter Property="Transitions" Value="{x:Null}"/>
  </Style>
  <Style Selector="Window.motion Button.rail-shortcuts /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions" Value="{x:Null}"/>
  </Style>
  <Style Selector="Button.rail-settings:pointerover:not(:disabled) /template/ Border#SettingsButtonSurface">
    <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
  </Style>
  <Style Selector="Button.rail-shortcuts.expanded">
    <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="Button#NewSession">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
  </Style>
  <Style Selector="Window.motion Button#NewSession">
    <Setter Property="Transitions"><Transitions>
      <BrushTransition Property="Background" Duration="0:0:0.12" Easing="0.16,1,0.3,1"/>
      <BrushTransition Property="BorderBrush" Duration="0:0:0.12" Easing="0.16,1,0.3,1"/>
    </Transitions></Setter>
  </Style>
  <Style Selector="Button#NewSession:pointerover">
    <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
  </Style>
</Styles>
