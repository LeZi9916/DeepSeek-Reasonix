  </Styles.Resources>
  <Style Selector="ctl|StudioSparkline"><Setter Property="Fill" Value="{DynamicResource Compose.curve-idle}"/></Style>
  <Style Selector="ctl|StudioSparkline:live"><Setter Property="Fill" Value="{DynamicResource Compose.curve-live}"/></Style>
  <Style Selector="TextBlock#TariffText"><Setter Property="Foreground" Value="{DynamicResource OkInkBrush}"/></Style>
  <Style Selector="TextBlock#TariffText.peak"><Setter Property="Foreground" Value="{DynamicResource WarnInkBrush}"/></Style>
  <Style Selector="Button.compose-tool, Button.compose-changes, Button.compose-context, Button.compose-queue-action">
    <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="FontFamily" Value="{DynamicResource ConversationUiFamily}"/><Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="FontSize" Value="{DynamicResource StudioType12}"/><Setter Property="Padding" Value="8,0"/>
    <Setter Property="BorderThickness" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
    <Setter Property="Height" Value="28"/><Setter Property="CornerRadius" Value="14"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusAdorner"><Template><Border Margin="-2" BorderBrush="{DynamicResource FocusBrush}" BorderThickness="2" CornerRadius="7" IsHitTestVisible="False"/></Template></Setter>
    <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/></Border></ControlTemplate></Setter>
  </Style>
  <Style Selector="StackPanel.compose-area TextBlock"><Setter Property="FontFamily" Value="{DynamicResource ConversationUiFamily}"/><Setter Property="FontWeight" Value="Medium"/></Style>
  <Style Selector="Button.compose-tool TextBlock, Button.compose-context TextBlock, Button.compose-changes TextBlock"><Setter Property="ClipToBounds" Value="False"/></Style>
  <Style Selector="Button.compose-tool TextBlock"><Setter Property="LineHeight" Value="{DynamicResource StudioType12}"/><Setter Property="FontSize" Value="{DynamicResource StudioType12}"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></Style>
  <Style Selector="Button.compose-model TextBlock#ModelLabel"><Setter Property="FontSize" Value="{DynamicResource StudioType13}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
  <Style Selector="Button.compose-plan, Button.compose-branch, Button.compose-policy"><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="CornerRadius" Value="999"/></Style>
  <Style Selector="Button.compose-icon"><Setter Property="Width" Value="28"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="7"/></Style>
  <Style Selector="Button.compose-changes">
    <Setter Property="Height" Value="22"/><Setter Property="CornerRadius" Value="11"/><Setter Property="Padding" Value="9,0"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontSize" Value="{DynamicResource StudioType11}"/>
  </Style>
  <Style Selector="Button.compose-pill"><Setter Property="CornerRadius" Value="999"/></Style>
  <Style Selector="Window.motion Button.compose-tool">
    <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.12" Easing="0.25,0.1,0.25,1"/></Transitions></Setter>
  </Style>
  <Style Selector="Button.compose-changes TextBlock"><Setter Property="FontFeatures" Value="tnum"/></Style>
  <Style Selector="Button.compose-changes TextBlock, Button.compose-context TextBlock"><Setter Property="LineHeight" Value="{DynamicResource StudioType11}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontSize" Value="{DynamicResource StudioType11}"/></Style>
  <Style Selector="Button.compose-context"><Setter Property="CornerRadius" Value="5"/><Setter Property="FontSize" Value="{DynamicResource StudioType11}"/><Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/><Setter Property="Padding" Value="6,0"/><Setter Property="Height" Value="25"/></Style>
  <Style Selector="Button.compose-context TextBlock"><Setter Property="FontFeatures" Value="tnum"/><Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/></Style>
  <Style Selector="Button.compose-context TextBlock.compose-reading"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></Style>
  <Style Selector="Button.compose-policy TextBlock"><Setter Property="FontSize" Value="{DynamicResource StudioType11}"/><Setter Property="LineHeight" Value="{DynamicResource StudioType11}"/><Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/></Style>
  <Style Selector="Button.compose-policy.risk TextBlock"><Setter Property="Foreground" Value="{DynamicResource WarnInkBrush}"/><Setter Property="FontWeight" Value="Medium"/></Style>
  <Style Selector="Button.compose-context Path.context-arc"><Setter Property="Stroke" Value="{DynamicResource ComposeContextProgressBrush}"/></Style>
  <Style Selector="Button.compose-context.high Path.context-arc"><Setter Property="Stroke" Value="{DynamicResource WarnBrush}"/></Style>
  <Style Selector="Button.compose-context.high TextBlock.compose-reading"><Setter Property="Foreground" Value="{DynamicResource WarnInkBrush}"/></Style>
  <Style Selector="Button.compose-tool:pointerover, Button.compose-changes:pointerover, Button.compose-context:pointerover, Button.compose-tool.open"><Setter Property="Background" Value="{DynamicResource OverlayBrush}"/></Style>
  <Style Selector="Button.compose-tool:pressed"><Setter Property="Background" Value="{DynamicResource OverlayBrush}"/></Style>
  <Style Selector="Button.compose-send"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/></Style>
  <Style Selector="Button.compose-send Path"><Setter Property="Stroke" Value="{DynamicResource AccentFgBrush}"/><Setter Property="StrokeThickness" Value="2"/></Style>
  <Style Selector="Button.compose-send TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/><Setter Property="FontSize" Value="{DynamicResource StudioType13}"/><Setter Property="LineHeight" Value="{DynamicResource StudioType13}"/></Style>
  <Style Selector="Button.compose-send:disabled"><Setter Property="Background" Value="{DynamicResource OverlayBrush}"/><Setter Property="Foreground" Value="{DynamicResource GhostBrush}"/></Style>
  <Style Selector="Button.compose-send:disabled Path"><Setter Property="Stroke" Value="{DynamicResource GhostBrush}"/></Style>
  <Style Selector="Button.compose-stop"><Setter Property="Background" Value="{DynamicResource Compose.stop-wash}"/><Setter Property="Foreground" Value="{DynamicResource ErrInkBrush}"/></Style>
  <Style Selector="TextBox.compose-input, TextBox.compose-input:focus, TextBox.compose-input:pointerover"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/></Style>
  <Style Selector="TextBox.compose-input /template/ Border#PART_BorderElement, TextBox.compose-input:focus /template/ Border#PART_BorderElement, TextBox.compose-input:pointerover /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style Selector="Border.compose-queue-row">
    <Setter Property="Background" Value="{DynamicResource PageBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource HairBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{DynamicResource RMd}"/>
    <Setter Property="Padding" Value="10,6,8,6"/>
  </Style>
  <Style Selector="TextBlock.compose-queue-label, TextBlock.compose-queue-preview, TextBlock.compose-queue-reason">
    <Setter Property="FontSize" Value="{DynamicResource StudioType12}"/>
  </Style>
  <Style Selector="TextBlock.compose-queue-label, TextBlock.compose-queue-reason">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
  </Style>
  <Style Selector="TextBlock.compose-queue-label.held">
    <Setter Property="Foreground" Value="{DynamicResource WarnInkBrush}"/>
  </Style>
  <Style Selector="Button.compose-queue-action">
    <Setter Property="Height" Value="20"/>
    <Setter Property="Padding" Value="7,0"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="FontSize" Value="{DynamicResource StudioType11}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="Button.compose-queue-action:pointerover, Button.compose-queue-action:pressed">
    <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
  </Style>
  <Style Selector="Border.compose-review"><Setter Property="Padding" Value="12"/><Setter Property="Background" Value="{DynamicResource RaisedBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/></Style>
  <Style Selector="StackPanel.compose-area.compact Button.compose-plan TextBlock.compose-tool-label, StackPanel.compose-area.compact Button.compose-plan Viewbox.compose-plan-chevron"><Setter Property="IsVisible" Value="False"/></Style>
  <Style Selector="StackPanel.compose-area.compact Button.compose-plan"><Setter Property="Width" Value="28"/><Setter Property="Padding" Value="0"/></Style>
  <Style Selector="StackPanel.compose-area.tight Button.compose-policy TextBlock.compose-tool-label, StackPanel.compose-area.tight Button.compose-policy Viewbox.compose-policy-chevron">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="StackPanel.compose-area.tight Button.compose-policy">
    <Setter Property="Width" Value="30"/><Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="StackPanel.compose-area.narrow-policy Button.compose-icon">
    <Setter Property="Width" Value="22"/>
  </Style>
  <Style Selector="Viewbox.compose-compact-model-chevron"><Setter Property="IsVisible" Value="False"/></Style>
  <Style Selector="StackPanel.compose-area.narrow-policy Viewbox.compose-compact-model-chevron"><Setter Property="IsVisible" Value="True"/></Style>
  <Style Selector="StackPanel.compose-area.narrow-policy Button.compose-branch TextBlock.compose-tool-label">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="StackPanel.compose-area.narrow-policy Button.compose-branch">
    <Setter Property="Width" Value="30"/><Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="StackPanel.compose-area.narrow-policy Button.compose-model">
    <Setter Property="MaxWidth" Value="105"/>
  </Style>
  <Style Selector="StackPanel.compose-area.tight Button.compose-tool"><Setter Property="Padding" Value="5,0"/></Style>
  <Style Selector="StackPanel.compose-area.tight Button.compose-icon"><Setter Property="Padding" Value="0"/></Style>
  <Style Selector="StackPanel.compose-area.tiny Button.compose-effort, StackPanel.compose-area.tiny Border#EffortSeparator"><Setter Property="IsVisible" Value="False"/></Style>
  <Style Selector="Button.workspace-quick-link">
    <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="10,0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="CornerRadius" Value="7"/>
  </Style>
  <Style Selector="Button.workspace-quick-link:pointerover"><Setter Property="Background" Value="{DynamicResource OverlayBrush}"/></Style>
  <Style Selector="Window.motion Button.workspace-quick-link">
    <Setter Property="RenderTransform" Value="scale(1)"/>
    <Setter Property="Transitions"><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.06"/></Transitions></Setter>
  </Style>
  <Style Selector="Window.motion Button.workspace-quick-link:pressed">
    <Setter Property="RenderTransform" Value="scale(0.94)"/>
  </Style>
  <Style Selector="ScrollViewer.conversation-scroll ScrollBar">
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.12"/></Transitions></Setter>
  </Style>
  <Style Selector="ScrollViewer.conversation-scroll ScrollBar:pointerover">
    <Setter Property="Opacity" Value="1"/>
  </Style>
</Styles>
