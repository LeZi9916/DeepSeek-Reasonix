<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ctl="using:Reasonix.Studio.Controls">
  <Styles.Resources>
    <SolidColorBrush x:Key="Compose.curve-idle" Color="{DynamicResource Ghost}" Opacity="0.1"/>
    <SolidColorBrush x:Key="Compose.curve-live" Color="#82A183" Opacity="0.12"/>
    <SolidColorBrush x:Key="Compose.stop-wash" Color="{DynamicResource Err}" Opacity="0.12"/>
    <StreamGeometry x:Key="Compose.branch">M6 3v12 M6 15a3 3 0 1 0 0 6a3 3 0 1 0 0-6 M18 3a3 3 0 1 0 0 6a3 3 0 1 0 0-6 M18 9a9 9 0 0 1-9 9</StreamGeometry>
    <StreamGeometry x:Key="Compose.down">m6 9 6 6 6-6</StreamGeometry>
