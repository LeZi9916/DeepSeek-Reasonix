<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Reasonix.Studio.Shell.Composer"
             x:Class="Reasonix.Studio.Shell.Composer.RunTokens">
  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
    <StackPanel Name="Sent" Classes="run-token-reading" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
      <Viewbox Classes="run-token-arrow up" Width="11" Height="11" VerticalAlignment="Center">
        <Viewbox.RenderTransform><TransformGroup><ScaleTransform/><TranslateTransform/></TransformGroup></Viewbox.RenderTransform>
        <Canvas Width="24" Height="24">
          <Path Data="{StaticResource Compose.arrow}" Stroke="{DynamicResource Cat1Brush}" StrokeThickness="2.25" StrokeLineCap="Round" StrokeJoin="Round"/>
        </Canvas>
      </Viewbox>
      <local:RunTokenValue Name="SentValue" FontFamily="{DynamicResource StudioMonoFamily}"
                 FontSize="{DynamicResource StudioType11}" LineHeight="11" FontWeight="Medium" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel Name="Received" Classes="run-token-reading" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
      <Viewbox Classes="run-token-arrow down" Width="11" Height="11" VerticalAlignment="Center">
        <Viewbox.RenderTransform><TransformGroup><ScaleTransform/><TranslateTransform/></TransformGroup></Viewbox.RenderTransform>
        <Canvas Width="24" Height="24" RenderTransform="rotate(180deg)">
          <Path Data="{StaticResource Compose.arrow}" Stroke="{DynamicResource Cat5Brush}" StrokeThickness="2.25" StrokeLineCap="Round" StrokeJoin="Round"/>
        </Canvas>
      </Viewbox>
      <local:RunTokenValue Name="ReceivedValue" FontFamily="{DynamicResource StudioMonoFamily}"
                 FontSize="{DynamicResource StudioType11}" LineHeight="11" FontWeight="Medium" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBlock Name="TokenUnit" FontSize="{DynamicResource StudioType11}" LineHeight="11" VerticalAlignment="Center"
               Foreground="{DynamicResource FaintBrush}"/>
  </StackPanel>
</UserControl>
