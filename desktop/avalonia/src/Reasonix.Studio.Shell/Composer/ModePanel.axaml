<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Reasonix.Studio.Shell.Composer.ModePanel"
             HorizontalAlignment="Stretch" MinHeight="148">
  <StackPanel Spacing="0">
    <Border Name="Head" Classes="composer-menu-head" Padding="14,12,14,8" MinHeight="0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Name="ModeTitle" Classes="composer-menu-title" VerticalAlignment="Center"/>
        <TextBlock Name="ModeContext" Grid.Column="1" Classes="composer-menu-context" VerticalAlignment="Center"/>
      </Grid>
    </Border>
    <Button Name="AgentOption" Classes="choice-row" Margin="4,2,4,0" Padding="10,7">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Name="AgentTitle" Classes="choice-title"/>
          <TextBlock Name="AgentNote" Classes="choice-note"/>
        </StackPanel>
        <Path Name="AgentCheck" Grid.Column="1" Classes="choice-check" Data="{StaticResource Glyph.check}" IsVisible="False"/>
      </Grid>
    </Button>
    <Button Name="PlanOption" Classes="choice-row" Margin="4,2,4,0" Padding="10,7">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Name="PlanTitle" Classes="choice-title"/>
          <TextBlock Name="PlanNote" Classes="choice-note"/>
        </StackPanel>
        <Path Name="PlanCheck" Grid.Column="1" Classes="choice-check" Data="{StaticResource Glyph.check}" IsVisible="False"/>
      </Grid>
    </Button>
    <TextBlock Name="ErrorText" Classes="menu-error" IsVisible="False"/>
  </StackPanel>
</UserControl>
