<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:Reasonix.Studio.Controls" x:Class="Reasonix.Studio.Shell.Composer.ProcessChip" UseLayoutRounding="False">
  <UserControl.Styles>
    <StyleInclude Source="avares://Reasonix.Studio.Shell/Styles/ComposerDeck.axaml"/>
  </UserControl.Styles>
  <ctl:StudioHoverCard Name="Details" AlignRight="True" ScaleFromAnchor="True" CardWidth="320" CardHeightFraction="0.38" Gap="7" PinOnClick="True">
    <ctl:StudioHoverCard.Anchor>
      <Button Name="Trigger" Classes="compose-deck-chip" AutomationProperties.AutomationId="action:deck.processes">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <Viewbox Width="12" Height="12" VerticalAlignment="Center">
            <Canvas Width="24" Height="24">
              <Path Data="{StaticResource Glyph.job-play}" Stroke="{Binding #Trigger.Foreground}" StrokeThickness="1.8" StrokeJoin="Round" StrokeLineCap="Round"/>
            </Canvas>
          </Viewbox>
          <ctl:StudioLineText Name="Caption" Foreground="{Binding #Trigger.Foreground}" VerticalAlignment="Center"
                              FontWeight="{Binding #Trigger.FontWeight}" FontFamily="{DynamicResource ConversationUiFamily}" FontSize="{DynamicResource StudioType12}"/>
        </StackPanel>
      </Button>
    </ctl:StudioHoverCard.Anchor>
    <ctl:StudioHoverCard.Card>
      <StackPanel Name="Rows" Margin="12" Spacing="10"/>
    </ctl:StudioHoverCard.Card>
  </ctl:StudioHoverCard>
</UserControl>
