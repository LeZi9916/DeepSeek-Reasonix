<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Reasonix.Studio.Shell.Workspace.WorkspaceChromeStatus">
  <Grid Width="28" Height="28"><Button Name="DeviceAccess" Classes="icon" Width="28" Height="28" Padding="0" AutomationProperties.AutomationId="action:share.card">
      <Grid Width="16" Height="16"><Viewbox Width="14" Height="14"><Canvas Width="24" Height="24">
        <Path Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4" StrokeJoin="Round" StrokeLineCap="Round"
              Data="M4 3h3a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z M17 3h3a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-3a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z M4 16h3a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1z M21 16h-3a2 2 0 0 0-2 2v3 M21 21v.01 M12 7v3a2 2 0 0 1-2 2H7 M3 12h.01 M12 3h.01 M12 16v.01 M16 12h1 M21 12v.01 M12 21v-1"/>
      </Canvas></Viewbox>
      <Border Name="OnlineMark" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-7,0" MinWidth="12" Height="12" Padding="3,0" CornerRadius="6" Background="{DynamicResource NetBrush}" IsVisible="False"><TextBlock Name="OnlineCount" Foreground="{DynamicResource AccentFgBrush}" FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center"/></Border></Grid>
    </Button>
    <Popup Name="Presence" Placement="BottomEdgeAlignedRight" VerticalOffset="8" IsLightDismissEnabled="False"><Border MaxWidth="250" Padding="10,6" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7"><TextBlock Name="PresenceText" FontFamily="{DynamicResource WorkbenchUiFamily}" Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource StudioType12}" FontWeight="Medium" TextWrapping="Wrap"/></Border></Popup>
  </Grid>
</UserControl>
