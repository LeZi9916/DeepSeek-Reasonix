<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Reasonix.Studio.Shell.Workspace" x:Class="Reasonix.Studio.Shell.Workspace.RecentSessionsPanel" IsVisible="False" FontFamily="{DynamicResource WorkbenchUiFamily}" Foreground="{DynamicResource TextBrush}" FontWeight="Medium" KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.AutomationId="class:recent-sessions">
  <UserControl.Resources>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
    <ControlTheme x:Key="RecentItemTheme" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><ControlTemplate><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/></ControlTemplate></Setter>
    </ControlTheme>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Button.recent-action"><Setter Property="Padding" Value="15,6"/><Setter Property="MinHeight" Value="0"/><Setter Property="Height" Value="33"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></Style>
    <Style Selector="Button.recent-action:disabled"><Setter Property="Opacity" Value="0.38"/></Style>
    <Style Selector="ListBoxItem:pointerover Border.recent-row"><Setter Property="Background" Value="{DynamicResource OverlayBrush}"/></Style>
    <Style Selector="ListBoxItem:focus-visible Border.recent-row"><Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Style>
    <Style Selector="ListBoxItem:pointerover Path.recent-chat"><Setter Property="Stroke" Value="{DynamicResource AccentInkBrush}"/></Style>
  </UserControl.Styles>
  <Grid>
    <Border Background="{DynamicResource PageBrush}" Opacity="0.72"/>
    <Border Name="Sheet" MaxWidth="520" MaxHeight="560" Margin="24,48" Padding="20,18" VerticalAlignment="Center" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" BoxShadow="0 12 40 0 #33000000">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
        <TextBlock Name="Title" FontSize="14" FontWeight="SemiBold" LineHeight="20" Margin="0,0,0,12"/>
        <TextBlock Name="Description" Grid.Row="1" FontSize="12" LineHeight="18" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,20">
          <Grid><TextBox Name="Query" Height="32" MinHeight="0" Padding="29,0,9,0" VerticalContentAlignment="Center" FontSize="13" FontWeight="Medium" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" AutomationProperties.AutomationId="action:recent.search"/><Path Width="14" Height="14" Margin="10,0,0,0" HorizontalAlignment="Left" Stretch="Uniform" Stroke="{DynamicResource FaintBrush}" StrokeThickness="1.8" Data="M18 10 A8 8 0 1 1 2 10 A8 8 0 1 1 18 10 M16 16 L22 22" IsHitTestVisible="False"/></Grid>
          <ComboBox Name="Machine" Grid.Column="1" Height="32" MinHeight="0" MaxWidth="140" Padding="8,0" VerticalContentAlignment="Center" FontSize="13" AutomationProperties.AutomationId="action:session.recent-environment"/>
        </Grid>
        <Border Grid.Row="3" MinHeight="160" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4" Background="{DynamicResource SurfaceBrush}">
          <Grid>
            <ListBox Name="Rows" ItemContainerTheme="{StaticResource RecentItemTheme}" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate><DataTemplate x:DataType="local:RecentSessionHit"><StackPanel>
                <TextBlock Classes="recent-group" Text="{Binding Group}" IsVisible="{Binding HasGroup}" FontSize="11" FontWeight="SemiBold" LineHeight="15.4" Margin="10,8,10,2" Foreground="{DynamicResource FaintBrush}"/>
                <Border Classes="recent-row" MinHeight="48" Padding="6,3" BorderBrush="Transparent" BorderThickness="2" CornerRadius="4"><Grid ColumnDefinitions="14,*,Auto" ColumnSpacing="8">
                  <Path Classes="recent-chat" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource GhostBrush}" StrokeThickness="1.3" StrokeJoin="Round" Data="M21 15a4 4 0 0 1-4 4H7l-5 3V6a4 4 0 0 1 4-4h11a4 4 0 0 1 4 4z" AutomationProperties.AutomationId="class:recent-chat"/>
                  <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" LineHeight="19" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" FontSize="11" LineHeight="16" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
                  <TextBlock Grid.Column="2" Classes="recent-tail" Text="{Binding Tail}" FontSize="{Binding TailSize}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                </Grid></Border>
              </StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Margin="8,8" Spacing="8" VerticalAlignment="Top"><TextBlock Name="Status" FontSize="13" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap" IsVisible="False"/><Button Name="Retry" Classes="recent-action" HorizontalAlignment="Left" IsVisible="False" AutomationProperties.AutomationId="action:session.recent-retry"/></StackPanel>
          </Grid>
        </Border>
        <TextBlock Name="KeyboardHint" Grid.Row="4" FontSize="11" LineHeight="15.4" Foreground="{DynamicResource FaintBrush}" Margin="0,8,0,0"/>
        <Grid Grid.Row="5" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8" Margin="0,14,0,0">
          <TextBlock Name="Page" Grid.ColumnSpan="4" FontSize="12" LineHeight="16.8" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
          <Button Name="Previous" Grid.Row="1" Grid.Column="1" Classes="recent-action" AutomationProperties.AutomationId="action:session.recent-previous"/><Button Name="Next" Grid.Row="1" Grid.Column="2" Classes="recent-action" AutomationProperties.AutomationId="action:session.recent-next"/><Button Name="Close" Grid.Row="1" Grid.Column="3" Classes="recent-action" AutomationProperties.AutomationId="action:recent.close"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>