<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Reasonix.Studio.Shell.Workspace.CommunityControl" FontFamily="{DynamicResource WorkbenchUiFamily}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource SurfaceBrush}" Tag="common.community_and_contributors" AutomationProperties.AutomationId="class:community">
  <UserControl.Styles>
    <Style Selector="Button.community-link"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="13,6"/><Setter Property="MinHeight" Value="0"/><Setter Property="Height" Value="33"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style Selector="Button.community-primary"><Setter Property="Background" Value="{DynamicResource TextBrush}"/><Setter Property="Foreground" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource TextBrush}"/></Style>
    <Style Selector="Button.community-small"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Height" Value="24"/><Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="10,2"/><Setter Property="CornerRadius" Value="999"/></Style>
    <Style Selector="Button.community-copy"><Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="Padding" Value="4"/><Setter Property="MinHeight" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="Button.community-person"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource HairBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="999"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontFamily" Value="{DynamicResource WorkbenchMonoFamily}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Padding" Value="9,2"/><Setter Property="MinHeight" Value="0"/><Setter Property="Height" Value="27"/><Setter Property="Margin" Value="0,0,6,6"/></Style>
    <Style Selector="TextBlock.note"><Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </UserControl.Styles>
  <StackPanel Spacing="22">
    <Grid Name="Join" ColumnDefinitions="185,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="0">
      <Border Width="185" Height="185" CornerRadius="8" Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Left" ClipToBounds="True"><Image Name="QqQr" Stretch="Fill" RenderOptions.BitmapInterpolationMode="None"><Image.Clip><RectangleGeometry Rect="0,0,183,183" RadiusX="7" RadiusY="7"/></Image.Clip></Image></Border>
      <StackPanel Name="QqDetails" Grid.Column="1" Spacing="10" VerticalAlignment="Top">
        <TextBlock Text="DeepSeek-Reasonix官方群" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Name="GroupLabel" Classes="note" VerticalAlignment="Center"/><TextBlock Text="1093562660" FontSize="14" FontWeight="SemiBold" FontFamily="{DynamicResource WorkbenchMonoFamily}" VerticalAlignment="Center"/><Button Name="CopyGroup" Classes="community-copy" AutomationProperties.AutomationId="action:community.copy-group"><Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource FaintBrush}" StrokeThickness="1.5" Data="M8 8h13v13H8z M16 8V3H3v13h5"/></Button></StackPanel>
        <TextBlock Name="JoinHint" FontSize="13" LineHeight="20.8" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
        <WrapPanel Margin="0,4,0,0"><Button Name="JoinQq" Classes="community-link community-primary" Margin="0,0,8,0" AutomationProperties.AutomationId="action:community.join"/><Button Name="Discord" Classes="community-link" Margin="0,0,8,0" Content="Discord" AutomationProperties.AutomationId="action:community.discord"/><Button Name="Issues" Classes="community-link" Content="GitHub issues" AutomationProperties.AutomationId="action:community.issues"/></WrapPanel>
      </StackPanel>
    </Grid>
    <WrapPanel><TextBlock Name="DouyinLabel" Classes="note" Margin="0,5,10,0"/><TextBlock Text="做游戏的小鱼" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,5,10,0"/><TextBlock Name="DouyinIdLabel" Classes="note" Margin="0,5,10,0"/><TextBlock Text="22703872788" FontSize="12" FontFamily="{DynamicResource WorkbenchMonoFamily}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,10,0"/><Button Name="CopyDouyin" Classes="community-copy" Margin="0,0,10,0" AutomationProperties.AutomationId="action:community.copy-douyin"><Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource FaintBrush}" StrokeThickness="1.5" Data="M8 8h13v13H8z M16 8V3H3v13h5"/></Button><Button Name="ToggleDouyin" Classes="community-link community-small" AutomationProperties.AutomationId="action:community.douyin-qr"/></WrapPanel>
    <Image Name="DouyinQr" Width="180" Height="269" HorizontalAlignment="Left" IsVisible="False"/>
    <TextBlock Name="Failure" Foreground="{DynamicResource ErrInkBrush}" FontSize="12" TextWrapping="Wrap" IsVisible="False"/>
    <Border BorderBrush="{DynamicResource HairBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0"><StackPanel Spacing="10">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><TextBlock Name="ContributorsLabel" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Name="ContributorsHint" Grid.Column="1" Classes="note" VerticalAlignment="Center"/><Button Name="AllContributors" Grid.Column="2" Classes="community-link community-small" AutomationProperties.AutomationId="action:community.contributors"/></Grid>
      <WrapPanel Name="People" Margin="0,0,0,-6"/><Button Name="MorePeople" Classes="community-link community-small" HorizontalAlignment="Left" AutomationProperties.AutomationId="action:community.more"/>
    </StackPanel></Border>
  </StackPanel>
</UserControl>