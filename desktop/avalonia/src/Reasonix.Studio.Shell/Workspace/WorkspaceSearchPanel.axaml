<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Reasonix.Studio.Shell.Workspace" x:Class="Reasonix.Studio.Shell.Workspace.WorkspaceSearchPanel" IsVisible="False" Background="#29000000" FontFamily="{DynamicResource WorkbenchUiFamily}" AutomationProperties.AutomationId="class:palette-veil">
  <UserControl.Resources>
    <ResourceDictionary>
      <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
      <ControlTheme x:Key="PaletteItemTheme" TargetType="ListBoxItem">
        <Setter Property="IsEnabled" Value="{ReflectionBinding Selectable}"/>
        <Setter Property="Padding" Value="10,0"/><Setter Property="MinHeight" Value="{ReflectionBinding RowHeight}"/><Setter Property="Margin" Value="6,0"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template"><ControlTemplate><Border Name="Row" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center"/></Border></ControlTemplate></Setter>
        <Style Selector="^:selected"><Setter Property="Background" Value="{DynamicResource FloatHiBrush}"/></Style>
        <Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource FloatHiBrush}"/></Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value="1"/><Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/></Style>
      </ControlTheme>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Button.scope">
      <Setter Property="Background" Value="{DynamicResource FloatBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9,0"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="MinHeight" Value="0"/><Setter Property="Height" Value="24"/><Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Template"><ControlTemplate>
        <Border CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="{TemplateBinding BorderThickness}"
                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
        </Border>
      </ControlTemplate></Setter>
    </Style>
    <Style Selector="Button.scope.active, Button.scope:pointerover">
      <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
  </UserControl.Styles>
  <Border Name="Sheet" MaxWidth="600" Margin="16,72,16,24" VerticalAlignment="Top" Background="{DynamicResource FloatBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" BoxShadow="0 12 40 0 #33000000" AutomationProperties.AutomationId="class:palette">
    <Grid RowDefinitions="52,Auto,*,36">
      <Border BorderBrush="{DynamicResource HairBrush}" BorderThickness="0,0,0,1" Padding="16,0">
      <Grid ColumnDefinitions="24,Auto,*,32">
        <Path Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" Data="M18 10 A8 8 0 1 1 2 10 A8 8 0 1 1 18 10 M16 16 L22 22"/>
        <Border Name="ScopeBadge" Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center" CornerRadius="4" Padding="6,3" Background="{DynamicResource OverlayBrush}" IsVisible="False"><TextBlock Name="ScopeBadgeLabel" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></Border>
        <TextBox Name="Query" Grid.Column="2" Background="Transparent" BorderThickness="0" FontSize="16" PlaceholderText="搜索会话与操作" AutomationProperties.AutomationId="action:palette.query"/>
        <Button Name="Close" Grid.Column="3" Classes="scope" Padding="0" Height="18" CornerRadius="4" FontSize="11" Content="Esc" VerticalAlignment="Center" HorizontalContentAlignment="Center"/>
      </Grid>
      </Border>
      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,10,16,6" Spacing="7">
        <Button Name="All" Classes="scope" IsVisible="False"/><Button Name="Actions" Classes="scope" Tag="actions" AutomationProperties.AutomationId="action:palette.scope"/><Button Name="Sessions" Classes="scope" Tag="sessions" AutomationProperties.AutomationId="action:palette.scope"/><Button Name="Settings" Classes="scope" Tag="settings" AutomationProperties.AutomationId="action:palette.scope"/>
      </StackPanel>
      <ListBox Name="Results" Grid.Row="2" MaxHeight="390" ItemContainerTheme="{StaticResource PaletteItemTheme}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="class:palette-results">
        <ListBox.ItemTemplate><DataTemplate x:DataType="local:WorkspaceSearchHit">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Viewbox Width="14" Height="14" IsVisible="{Binding Selectable}">
              <Canvas Width="24" Height="24"><Path Data="{Binding Icon}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8"
                       StrokeLineCap="Round" StrokeJoin="Round"/></Canvas>
            </Viewbox>
            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="{Binding TextSize}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource FaintBrush}" TextTrimming="CharacterEllipsis" MaxWidth="240"/></Grid>
        </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Name="Empty" Grid.Row="2" Margin="16,22" FontSize="12" Foreground="{DynamicResource FaintBrush}" IsVisible="False"/>
      <Border Grid.Row="3" BorderBrush="{DynamicResource HairBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource OverlayBrush}"
              CornerRadius="0,0,14,14" Padding="16,0">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBlock Name="Hint" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
          <TextBlock Name="ScopeHint" Grid.Column="1" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
