<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Reasonix.Studio.Shell</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="AvaloniaTerminal" Version="1.0.0" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Reasonix.Studio.Contracts\Reasonix.Studio.Contracts.csproj" />
    <ProjectReference Include="..\Reasonix.Studio.Kernel\Reasonix.Studio.Kernel.csproj" />
    <ProjectReference Include="..\Reasonix.Studio.State\Reasonix.Studio.State.csproj" />
    <ProjectReference Include="..\Reasonix.Studio.Controls\Reasonix.Studio.Controls.csproj" />
    <ProjectReference Include="..\Reasonix.Studio.Pages\Reasonix.Studio.Pages.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Reasonix.Studio.Baseline.Tests" />
    <InternalsVisibleTo Include="Reasonix.Studio.Render.Tests" />
    <InternalsVisibleTo Include="Reasonix.Studio.WebView.Smoke" />
    <AvaloniaResource Include="Assets/wordmark.png" />
    <AvaloniaResource Include="Assets/DataFonts/*.ttf" />
    <AvaloniaResource Include="Assets/WorkbenchFonts/*.ttf" />
    <None Include="../../../frontend-next/public/fonts/NotoSansSC-OFL.txt;../../../frontend-next/public/fonts/IBMPlexMono-OFL.txt;../../../frontend-next/public/fonts/Inter-OFL.txt" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
