<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Reasonix.Studio.Shell.Browser.ManualWebPreview">
  <Grid RowDefinitions="Auto,Auto,*" Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="6" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="4">
      <Button Name="Back" Content="←" Padding="6,2" IsEnabled="False" />
      <Button Name="Forward" Grid.Column="1" Content="→" Padding="6,2" IsEnabled="False"/>
      <Button Name="Reload" Grid.Column="2" Content="↻" Padding="6,2"/>
      <TextBox Name="Address" Grid.Column="3" MaxLines="1" />
      <Button Name="Go" Grid.Column="4" Padding="8,2" />
    </Grid>
    <SelectableTextBlock Name="Notice" Grid.Row="1" IsVisible="False" Margin="8,0,8,5" TextWrapping="Wrap"/>
    <Border Name="GuestHost" Grid.Row="2" Background="White" ClipToBounds="True"/>
  </Grid>
</UserControl>
