<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Reasonix.Studio.Shell.Settings.SettingsUnitField">
  <UserControl.Styles>
    <Style Selector="Border.unit-field:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}"/>
    </Style>
    <Style Selector="Border.unit-field:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}"/>
    </Style>
    <Style Selector="TextBox#Number">
      <Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="{DynamicResource StudioType12}"/><Setter Property="MinHeight" Value="0"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox#Number /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    </Style>
  </UserControl.Styles>
  <Border Classes="unit-field" Background="{DynamicResource RaisedBrush}" BorderThickness="1"
          BorderBrush="{DynamicResource BorderBrush}" CornerRadius="7" ClipToBounds="True" Height="28">
    <Grid Name="NumberLayout" ColumnDefinitions="64,*" Margin="2,0,0,0">
      <TextBox Name="Number" MaxLength="9"/>
      <Border Grid.Column="1" Padding="0,0,3,0">
        <TextBlock Name="Unit" Foreground="{DynamicResource FaintBrush}" FontSize="{DynamicResource StudioType12}"
                   FontFamily="{DynamicResource WorkbenchMonoFamily}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
    </Grid>
  </Border>
</UserControl>
