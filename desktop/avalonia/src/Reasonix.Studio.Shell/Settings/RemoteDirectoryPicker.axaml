<local:SettingsFormView xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:local="using:Reasonix.Studio.Shell.Settings"
                        x:Class="Reasonix.Studio.Shell.Settings.RemoteDirectoryPicker"
                        KeyboardNavigation.TabNavigation="Cycle">
  <UserControl.Styles>
    <Style Selector="Button.folder-action">
      <Setter Property="Height" Value="33"/><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="10,0"/><Setter Property="CornerRadius" Value="5"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="FontSize" Value="{DynamicResource StudioType14}"/><Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Template"><ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        </Border>
      </ControlTemplate></Setter>
      <Style Selector="^:pointerover:not(:disabled)"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Style>
      <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.38"/></Style>
      <Style Selector="^.primary">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
      </Style>
    </Style>
    <Style Selector="Button.folder-row">
      <Setter Property="MinHeight" Value="29"/><Setter Property="MinWidth" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="8,5"/><Setter Property="FontSize" Value="{DynamicResource StudioType14}"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Template"><ControlTemplate>
        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="5">
          <Grid ColumnDefinitions="14,*" ColumnSpacing="8">
            <Viewbox Width="14" Height="14" VerticalAlignment="Center">
              <Canvas Width="24" Height="24">
                <Path Data="{StaticResource Glyph.folder}" Stroke="{DynamicResource GhostBrush}" StrokeThickness="1.3" StrokeJoin="Round"/>
              </Canvas>
            </Viewbox>
            <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          </Grid>
        </Border>
      </ControlTemplate></Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      </Style>
    </Style>
    <Style Selector="TextBlock.folder-notice">
      <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="{DynamicResource StudioType14}"/>
      <Setter Property="LineHeight" Value="22.4"/><Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/>
    </Style>
  </UserControl.Styles>
  <Grid>
    <Border Name="Veil">
      <Border.Background><SolidColorBrush Color="{DynamicResource Page}" Opacity="0.72"/></Border.Background>
    </Border>
    <Border Name="Card" Width="520" MaxHeight="560" Margin="24,48" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"
            Padding="20,18" BoxShadow="0 12 28 0 #30000000" AutomationProperties.AutomationId="class:pickcard">
      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
        <TextBlock Name="Heading" FontSize="{DynamicResource StudioType14}" FontWeight="Medium" LineHeight="20" Margin="0,0,0,12"/>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
          <Button Name="Up" Classes="folder-action" Width="30" Height="30" VerticalAlignment="Center" Padding="0"
                  AutomationProperties.AutomationId="action:remote.directory.up">
            <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24">
              <Path Data="M12 19V5 M5 12l7-7 7 7" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"/>
            </Canvas></Viewbox>
          </Button>
          <TextBox Name="PathInput" Grid.Column="1" Tag="remote.a_path_on_that_machine" Classes="settings-input" Height="33"
                   Padding="9,0" CornerRadius="5" Background="{DynamicResource SurfaceBrush}" FontSize="{DynamicResource StudioType14}"
                   AutomationProperties.AutomationId="field:remote.directory.path"/>
          <Button Name="Go" Grid.Column="2" Classes="folder-action" Tag="remote.go" AutomationProperties.AutomationId="action:remote.directory.go"/>
        </Grid>
        <TextBlock Name="Failure" Grid.Row="2" IsVisible="False" Classes="folder-notice"
                   Margin="0,10,0,0" Foreground="{DynamicResource ErrInkBrush}" AutomationProperties.LiveSetting="Assertive"/>
        <Border Name="Results" Grid.Row="3" MinHeight="96" Margin="0,12,0,0" Padding="4" BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}" CornerRadius="7" Background="{DynamicResource SurfaceBrush}">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Name="Rows">
              <TextBlock Name="ListingStatus" Classes="folder-notice" Padding="8,10" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="4">
          <TextBlock Name="Unlisted" IsVisible="False" Tag="remote.this_machine_will_not_list" Classes="folder-notice" Padding="0,8,0,0"/>
          <TextBlock Name="Truncated" IsVisible="False" Tag="remote.this_folder_is_too_big" Classes="folder-notice" Padding="0,8,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
          <Button Name="Cancel" Classes="folder-action" Tag="common.cancel" Padding="15,0" AutomationProperties.AutomationId="action:remote.directory.cancel"/>
          <Button Name="Choose" Classes="folder-action primary" Tag="remote.use_this_folder" Padding="15,0"
                  AutomationProperties.AutomationId="action:remote.directory.pick"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</local:SettingsFormView>
