<local:SettingsFormView xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:Reasonix.Studio.Shell.Settings" x:Class="Reasonix.Studio.Shell.Settings.ProjectChoice">
 <Border MaxWidth="670" Margin="16" Padding="28" CornerRadius="15" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
  <StackPanel Spacing="12">
   <TextBlock Tag="onboarding.which_project" FontSize="{DynamicResource StudioType25}" FontWeight="SemiBold"/>
   <TextBlock Tag="onboarding.drop_to_choose" TextWrapping="Wrap"/>
   <Border Name="DropZone" DragDrop.AllowDrop="True" MinHeight="110" Padding="15" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="9">
    <StackPanel Spacing="8" VerticalAlignment="Center">
     <TextBlock Name="PathLabel" TextWrapping="Wrap" HorizontalAlignment="Center"/>
     <Button Name="Pick" Tag="onboarding.choose_a_folder" AutomationProperties.AutomationId="action:onboarding.pick-folder" HorizontalAlignment="Center"/>
    </StackPanel>
   </Border>
   <TextBlock Name="Error" Foreground="{DynamicResource ErrBrush}" IsVisible="False" TextWrapping="Wrap"/>
   <WrapPanel><Button Name="Start" Tag="common.start" IsEnabled="False" AutomationProperties.AutomationId="action:onboarding.start"/>
    <Button Name="Skip" Tag="onboarding.not_now" Margin="6,0" AutomationProperties.AutomationId="action:onboarding.skip-project"/></WrapPanel>
  </StackPanel>
 </Border>
</local:SettingsFormView>
