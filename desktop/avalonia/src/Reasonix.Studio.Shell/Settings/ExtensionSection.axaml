<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Reasonix.Studio.Shell.Settings.ExtensionSection" UseLayoutRounding="False">
  <Border Name="Card" Padding="22,20,22,18" BorderBrush="{DynamicResource HairBrush}" BorderThickness="1" CornerRadius="10"
          Background="{DynamicResource RaisedBrush}">
    <StackPanel>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Name="Heading" FontSize="{DynamicResource StudioType13}" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
          <Border Name="ScopeBadge" IsVisible="False" Padding="7,1" CornerRadius="9" Background="{DynamicResource OverlayBrush}">
            <TextBlock Name="ScopeNote" FontSize="{DynamicResource StudioType11}" Foreground="{DynamicResource MutedBrush}"/>
          </Border>
        </StackPanel>
        <Border Name="CountBadge" Grid.Column="1" Padding="7,2" CornerRadius="12" VerticalAlignment="Center"
                Background="{DynamicResource OverlayBrush}" IsVisible="False">
          <TextBlock Name="CountLabel" FontSize="{DynamicResource StudioType12}" Foreground="{DynamicResource FaintBrush}"/>
        </Border>
      </Grid>
      <TextBlock Name="Hint" Margin="0,5,0,16" MaxWidth="550" HorizontalAlignment="Left" TextWrapping="Wrap"
                 FontSize="{DynamicResource StudioType13}" LineHeight="21.45" Foreground="{DynamicResource MutedBrush}"/>
      <ContentControl Name="Items" HorizontalContentAlignment="Stretch"/>
    </StackPanel>
  </Border>
</UserControl>
