<local:SettingsFormView xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:Reasonix.Studio.Shell.Settings" x:Class="Reasonix.Studio.Shell.Settings.KeyboardShortcutSheet">
  <local:SettingsFormView.Styles>
    <Style Selector="Border.keys-row">
      <Setter Property="BorderBrush" Value="{DynamicResource HairBrush}"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/><Setter Property="Padding" Value="12,0"/>
      <Setter Property="MinHeight" Value="20"/>
    </Style>
    <Style Selector="Border.keys-cap">
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.keys-chord">
      <Setter Property="FontFamily" Value="{DynamicResource WorkbenchMonoFamily}"/>
      <Setter Property="FontSize" Value="{DynamicResource StudioType12}"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    </Style>
  </local:SettingsFormView.Styles>
  <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource HairBrush}" Padding="0,11,0,10">
    <StackPanel>
      <TextBlock Tag="settings.keyboard_shortcuts" FontWeight="SemiBold" LineHeight="18.2" Foreground="{DynamicResource TextBrush}"/>
      <TextBlock Tag="settings.all_shortcuts_incl_global_and_esc" Classes="safety-hint" Margin="0,2,0,10"/>
      <StackPanel Name="KeyboardRows"/>
    </StackPanel>
  </Border>
</local:SettingsFormView>
