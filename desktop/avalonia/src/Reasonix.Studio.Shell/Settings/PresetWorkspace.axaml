<local:SettingsFormView xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Reasonix.Studio.Shell.Settings" x:Class="Reasonix.Studio.Shell.Settings.PresetWorkspace">
  <StackPanel Spacing="10" Margin="0,12">
    <StackPanel Name="Catalog" Spacing="9">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Tag="persona.agent_presets" FontWeight="SemiBold" FontSize="{DynamicResource StudioType16}" VerticalAlignment="Center"/>
        <Button Name="Create" Grid.Column="1" Tag="persona.new_preset" AutomationProperties.AutomationId="action:agent-preset.create"/>
      </Grid>
      <TextBlock Tag="persona.presets_define_which_capabilities_are" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
      <StackPanel Name="Groups" Spacing="8"/>
      <WrapPanel><local:PresetImport Name="Import"/><Button Name="Refresh" Tag="common.reload" AutomationProperties.AutomationId="action:agent-preset.reload" Margin="6,0"/></WrapPanel>
      <TextBlock Name="ActivePreset" TextWrapping="Wrap" FontSize="{DynamicResource StudioType12}" Foreground="{DynamicResource MutedBrush}"/>
    </StackPanel>
    <StackPanel Name="Editor" IsVisible="False" Spacing="9">
      <StackPanel Margin="32,20,32,12" Spacing="6">
        <Button Name="Back" Tag="persona.back_to_presets" AutomationProperties.AutomationId="action:agent-preset.back"/>
        <TextBlock Name="Heading" FontWeight="SemiBold" FontSize="{DynamicResource StudioType18}"/>
        <TextBlock Name="SourceLabel" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
        <TextBlock Name="Revision" FontSize="{DynamicResource StudioType12}" Foreground="{DynamicResource FaintBrush}"/>
      </StackPanel>
      <StackPanel Name="Fields" Spacing="16" Margin="32,4,32,16">
        <StackPanel Spacing="8"><TextBlock Tag="persona.preset_name"/><TextBox Name="PresetName" AutomationProperties.AutomationId="field:agent-preset.name" MaxLength="200"/></StackPanel>
        <StackPanel Spacing="8"><TextBlock Tag="persona.purpose"/><TextBox Name="Purpose" AutomationProperties.AutomationId="field:agent-preset.description" /></StackPanel>
        <StackPanel Spacing="8"><TextBlock Tag="persona.persona_and_instructions"/><TextBlock Tag="persona.describe_the_role_approach_and" FontSize="{DynamicResource StudioType12}" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap"/><TextBox Name="Prefix" AutomationProperties.AutomationId="field:persona.prefix" MaxLength="32768" AcceptsReturn="True" MinHeight="118" TextWrapping="Wrap"/></StackPanel>
        <StackPanel Spacing="8"><TextBlock Tag="persona.additional_instructions"/><TextBlock Tag="persona.placed_after_the_built_in" FontSize="{DynamicResource StudioType12}" Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap"/><TextBox Name="Suffix" AutomationProperties.AutomationId="field:persona.suffix" MaxLength="32768" AcceptsReturn="True" MinHeight="118" TextWrapping="Wrap"/></StackPanel>
        <CheckBox Name="OmitRuntime" Tag="persona.do_not_inject_optional_runtime" AutomationProperties.AutomationId="action:persona.runtime-context"/>
        <local:PresetModules Name="Modules"/>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
          <StackPanel Spacing="8"><TextBlock Tag="persona.storage_scope"/><ComboBox Name="Scope" HorizontalAlignment="Stretch"/></StackPanel>
          <StackPanel Grid.Column="1" Spacing="3"><TextBlock Tag="persona.preset_id"/><TextBox Name="Identity" MaxLength="64" AutomationProperties.AutomationId="field:agent-preset.id"/></StackPanel>
        </Grid>
      </StackPanel>
      <Expander Name="Extra" Header="{Binding #MoreLabel.Text}" Margin="32,0" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="action:agent-preset.more">
        <StackPanel Spacing="6"><TextBlock Name="MoreLabel" Tag="common.more_actions" IsVisible="False"/>
          <WrapPanel><Button Name="Export" Tag="persona.export_file" AutomationProperties.AutomationId="action:agent-preset.export"/><Button Name="Download" Tag="persona.download_preset_json" IsVisible="False" Margin="6,0" AutomationProperties.AutomationId="action:agent-preset.download"/></WrapPanel>
          <WrapPanel><Button Name="Remove" Tag="persona.delete_preset" AutomationProperties.AutomationId="action:agent-preset.delete-preview"/><Button Name="ConfirmRemove" Tag="common.delete" IsVisible="False" Margin="6,0" AutomationProperties.AutomationId="action:agent-preset.delete"/><Button Name="Keep" Tag="persona.cancel_deletion" IsVisible="False"/></WrapPanel>
          <TextBlock Tag="persona.explicit_default_configuration" FontWeight="Medium"/><TextBlock Tag="persona.used_only_when_explicitly_selecting" TextWrapping="Wrap"/>
          <WrapPanel><Button Name="Personal" Tag="persona.set_personal_preference"/><Button Name="Workspace" Tag="persona.set_workspace_preference" Margin="6,0"/></WrapPanel>
        </StackPanel>
      </Expander>
      <Border BorderBrush="{DynamicResource HairBrush}" BorderThickness="0,1,0,0" Padding="32,16">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock Tag="persona.available_to_new_conversations_after" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
      <WrapPanel Grid.Column="1">
        <Button Name="Cancel" Tag="common.cancel" Margin="0,0,6,0" AutomationProperties.AutomationId="action:agent-preset.leave"/>
        <Button Name="Save" Tag="persona.save_preset" AutomationProperties.AutomationId="action:agent-preset.save"/>
        <Button Name="Duplicate" Tag="persona.duplicate_as_custom_preset" AutomationProperties.AutomationId="action:agent-preset.copy"/>
      </WrapPanel>
      </Grid>
      </Border>
    </StackPanel>
    <TextBlock Name="Result" TextWrapping="Wrap" IsVisible="False"/>
  </StackPanel>
</local:SettingsFormView>
