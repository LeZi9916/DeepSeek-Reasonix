<local:SettingsFormView xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Reasonix.Studio.Shell.Settings" x:Class="Reasonix.Studio.Shell.Settings.SafetyToolInventory">
  <local:SettingsFormView.Styles>
    <Style Selector="Border.safety-tool-row">
      <Setter Property="Padding" Value="12,6"/><Setter Property="BorderThickness" Value="0,1,0,0"/>
      <Setter Property="BorderBrush" Value="{DynamicResource HairBrush}"/>
    </Style>
    <Style Selector="TextBlock.safety-tool-detail">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="{DynamicResource StudioType12}"/>
      <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="18.6"/>
    </Style>
  </local:SettingsFormView.Styles>
  <Border Padding="0,11,0,8" BorderBrush="{DynamicResource HairBrush}" BorderThickness="0,1,0,0">
    <StackPanel>
      <WrapPanel ItemSpacing="8" LineSpacing="4">
        <TextBlock Tag="ext.tools_the_model_can_use" FontWeight="SemiBold" LineHeight="18.2" Foreground="{DynamicResource TextBrush}"/>
        <Border Classes="setting-apply" Margin="0"><TextBlock Tag="settings.applies_to_new_sessions" VerticalAlignment="Center"/></Border>
      </WrapPanel>
      <TextBlock Tag="ext.a_tool_you_turn_off" Classes="safety-tool-detail" Margin="0,2,0,10"/>
      <StackPanel Name="ToolRows"/>
      <TextBlock Name="Error" Foreground="{DynamicResource ErrInkBrush}" TextWrapping="Wrap" IsVisible="False"/>
    </StackPanel>
  </Border>
</local:SettingsFormView>
