<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="using:Reasonix.Studio.Shell.Settings" x:Class="Reasonix.Studio.Shell.Settings.ProviderSourceForm"
             UseLayoutRounding="False">
  <UserControl.Styles>
    <Style Selector="Border#SourceFrame">
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource HairBrush}"/>
    </Style>
    <Style Selector="Border#SourceFrame.light">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    </Style>
    <Style Selector="Button.preset-vendor">
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
    </Style>
    <Style Selector="Button.preset-vendor.active">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}"/>
      <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
    </Style>
    <Style Selector="Button.source-quiet">
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    </Style>
    <Style Selector="Button.source-verify">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    </Style>
    <Style Selector="TextBlock.source-heading">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontSize" Value="{DynamicResource StudioType13}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.source-tip">
      <Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/>
      <Setter Property="FontSize" Value="{DynamicResource StudioType11}"/>
      <Setter Property="LineHeight" Value="15.95"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.source-tip.error, TextBlock.source-issue">
      <Setter Property="Foreground" Value="{DynamicResource ErrInkBrush}"/>
    </Style>
    <Style Selector="Border.source-section">
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
      <Setter Property="BorderBrush" Value="{DynamicResource HairBrush}"/>
      <Setter Property="Margin" Value="0,16,0,0"/>
      <Setter Property="Padding" Value="0,14,0,0"/>
    </Style>
    <Style Selector="ComboBox.source-select">
      <Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Background" Value="{DynamicResource PageBrush}"/>
      <Setter Property="FontSize" Value="{DynamicResource StudioType13}"/>
    </Style>
    <Style Selector="Button.source-disclosure">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="11,0"/>
      <Setter Property="FontSize" Value="{DynamicResource StudioType13}"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Button.source-model-offer">
      <Setter Property="Template"><ControlTemplate>
        <Panel>
          <Rectangle RadiusX="7" RadiusY="7" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" StrokeDashArray="3,2"
                     Fill="{TemplateBinding Background}"/>
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center" Margin="10,0"/>
        </Panel>
      </ControlTemplate></Setter>
    </Style>
    <Style Selector="TextBlock#ProbeStatus.success"><Setter Property="Foreground" Value="{DynamicResource OkInkBrush}"/></Style>
    <Style Selector="Border#ProbeMessage.error">
      <Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}"/>
      <Setter Property="BorderThickness" Value="2,0,0,0"/>
      <Setter Property="Padding" Value="10,6,0,6"/>
    </Style>
    <Style Selector="Button.source-card">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="11,8"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Height" Value="54"/>
    </Style>
    <Style Selector="CheckBox.source-model">
      <Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/>
      <Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="Template"><ControlTemplate>
        <Border CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
          <Viewbox Name="Tick" Width="10" Height="10" IsVisible="False">
            <Canvas Width="24" Height="24"><Path Data="m5 12 4 4L19 6" Stroke="{DynamicResource AccentFgBrush}"
                  StrokeThickness="3" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas>
          </Viewbox>
        </Border>
      </ControlTemplate></Setter>
    </Style>
    <Style Selector="CheckBox.source-model:checked">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="CheckBox.source-model:checked /template/ Viewbox#Tick">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
  </UserControl.Styles>

  <Border Name="SourceFrame" Padding="14,14,14,0" CornerRadius="10" BorderThickness="1">
    <StackPanel>
      <Grid Name="SourceHeader" ColumnDefinitions="*,28" ColumnSpacing="16" Margin="0,0,0,13">
        <StackPanel>
          <TextBlock Name="Eyebrow" Classes="source-tip" Margin="0,0,0,3"/>
          <TextBlock Name="Title" Classes="source-heading" FontSize="{DynamicResource StudioType14}"/>
          <TextBlock Name="Introduction" Classes="provider-caption" Foreground="{DynamicResource MutedBrush}" LineHeight="18" Margin="0,4,0,0"/>
        </StackPanel>
        <Button Name="Close" Grid.Column="1" Classes="provider-glyph" VerticalAlignment="Top" AutomationProperties.AutomationId="action:provider.add-close">
          <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Data="M18 6 6 18 M6 6l12 12"
                   Stroke="{DynamicResource FaintBrush}" StrokeThickness="1.8" StrokeLineCap="Round"/></Canvas></Viewbox>
        </Button>
      </Grid>

      <StackPanel Name="SourceFields">
        <TextBlock Name="PresetNotice" Classes="provider-caption" IsVisible="False"/>
        <Border Name="PresetGallery" Margin="0,0,0,14" IsVisible="False">
          <StackPanel>
            <Button Name="TogglePresets" Classes="provider-action source-disclosure" Height="37" AutomationProperties.AutomationId="action:provider.preset-toggle">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Name="PresetsTitle" Classes="source-heading"/>
                <TextBlock Name="PresetsCount" Classes="source-tip" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <StackPanel Name="PresetsBody" IsVisible="False" Spacing="8" Margin="0,8,0,0">
              <TextBox Name="PresetSearch" Classes="provider-search" Height="22" Padding="3,0" CornerRadius="2" AutomationProperties.AutomationId="action:provider.preset-search"/>
              <WrapPanel Name="Vendors" ItemSpacing="6" LineSpacing="6"/>
              <StackPanel Name="PresetGroups" Spacing="10"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <StackPanel Spacing="4">
              <TextBlock Name="ProtocolLabel" Classes="provider-label"/>
              <ComboBox Name="Protocol" Classes="source-select" AutomationProperties.AutomationId="action:provider.draft.protocol"/>
              <TextBlock Name="ProtocolHint" Classes="source-tip"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Name="EndpointLabel" Classes="provider-label"/>
              <TextBox Name="Endpoint" Classes="provider-field" PlaceholderText="https://api.moonshot.cn/v1"
                       AutomationProperties.AutomationId="action:provider.draft.endpoint"/>
              <TextBlock Name="DecisionHint" Classes="source-tip" IsVisible="False"/>
            </StackPanel>
          </Grid>
          <StackPanel Spacing="4">
            <TextBlock Name="CredentialLabel" Classes="provider-label" Text="API Key"/>
            <TextBox Name="Credential" Classes="provider-field" PasswordChar="●" AutomationProperties.AutomationId="action:provider.draft.credential"/>
            <TextBlock Name="CredentialHint" Classes="source-tip" Margin="0,3,0,0"/>
          </StackPanel>
          <StackPanel Spacing="4">
            <TextBlock Name="NameLabel" Classes="provider-label"/>
            <TextBox Name="SourceName" Classes="provider-field" AutomationProperties.AutomationId="action:provider.draft.name"/>
            <TextBlock Name="NameHint" Classes="source-tip" AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>
          <TextBlock Name="SiblingHint" Classes="provider-caption" IsVisible="False"/>
        </StackPanel>

        <Border Classes="source-section">
          <StackPanel Spacing="5">
            <WrapPanel ItemSpacing="10" LineSpacing="2">
              <TextBlock Name="LimitsTitle" Classes="source-heading"/>
              <TextBlock Name="LimitsHint" Classes="provider-caption"/>
            </WrapPanel>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <StackPanel Spacing="4">
                <TextBlock Name="WindowLabel" Classes="provider-label"/>
                <Panel>
                  <TextBox Name="ContextWindow" Classes="provider-field" PlaceholderText="128000" TextAlignment="Right" Padding="10,0,55,0"
                           AutomationProperties.AutomationId="action:provider.draft.context-window"/>
                  <TextBlock Classes="provider-caption" Text="tokens" Margin="0,0,11,0" HorizontalAlignment="Right"
                             VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Panel>
                <TextBlock Name="WindowHint" Classes="provider-caption"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Name="OutputLabel" Classes="provider-label"/>
                <Panel>
                  <TextBox Name="OutputLimit" Classes="provider-field" TextAlignment="Right" Padding="10,0,55,0"
                           AutomationProperties.AutomationId="action:provider.draft.max-output"/>
                  <TextBlock Classes="provider-caption" Text="tokens" Margin="0,0,11,0" HorizontalAlignment="Right"
                             VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Panel>
                <TextBlock Name="OutputHint" Classes="provider-caption"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Name="AdvancedFrame" Margin="0,16,0,0" CornerRadius="7" BorderThickness="1"
                BorderBrush="{DynamicResource HairBrush}" Background="{DynamicResource SurfaceBrush}">
          <StackPanel>
            <Button Name="AdvancedHeader" Classes="provider-action source-disclosure" Height="64" BorderThickness="0"
                    AutomationProperties.AutomationId="action:provider.advanced">
              <Grid ColumnDefinitions="*,Auto,12" ColumnSpacing="10">
                <StackPanel Spacing="5" VerticalAlignment="Center">
                  <TextBlock Name="AdvancedTitle" Classes="source-heading"/>
                  <TextBlock Name="AdvancedHint" Classes="provider-caption"/>
                </StackPanel>
                <TextBlock Name="Optional" Grid.Column="1" Classes="provider-caption" VerticalAlignment="Center"/>
                <Viewbox Grid.Column="2" Width="11" Height="11">
                  <Canvas Width="24" Height="24"><Path Name="AdvancedChevron" Data="m6 9 6 6 6-6"
                           Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas>
                </Viewbox>
              </Grid>
            </Button>
            <Border Name="AdvancedBody" IsVisible="False" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource HairBrush}" Padding="12,4,12,10">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <StackPanel>
                    <TextBlock Name="ThinkingTitle" Classes="source-heading"/>
                    <TextBlock Name="ThinkingHint" Classes="provider-caption"/>
                  </StackPanel>
                  <ToggleSwitch Name="Thinking" Grid.Column="1" IsChecked="True" OnContent="" OffContent=""
                                AutomationProperties.AutomationId="action:provider.draft.thinking"/>
                </Grid>
                <Border Name="ThinkingSection" BorderBrush="{DynamicResource HairBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <StackPanel Name="ThinkingFields" Spacing="8">
                  <TextBlock Name="ThinkingProtocolLabel" Classes="provider-label"/>
                  <ComboBox Name="ThinkingProtocol" Classes="source-select"/>
                  <TextBlock Name="ThinkingProtocolHint" Classes="source-tip"/>
                  <TextBlock Name="ThinkingShape" Classes="provider-caption"/>
                </StackPanel>
                </Border>
                <Border BorderBrush="{DynamicResource HairBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <StackPanel>
                    <TextBlock Name="ProxyTitle" Classes="source-heading"/>
                    <TextBlock Name="ProxyHint" Classes="provider-caption"/>
                  </StackPanel>
                  <ToggleSwitch Name="BypassProxy" Grid.Column="1" OnContent="" OffContent=""
                                AutomationProperties.AutomationId="action:provider.draft.no-proxy"/>
                </Grid>
                </Border>
                <StackPanel Spacing="4">
                  <TextBlock Name="HeadersLabel" Classes="provider-label"/>
                  <TextBox Name="Headers" Classes="provider-field" Height="78" AcceptsReturn="True" Padding="8,6" VerticalContentAlignment="Top"/>
                  <TextBlock Name="HeadersHint" Classes="source-tip"/>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Name="ExtraLabel" Classes="provider-label"/>
                  <TextBox Name="Extra" Classes="provider-field" Height="98" AcceptsReturn="True" Padding="8,6" VerticalContentAlignment="Top"/>
                  <TextBlock Name="ExtraHint" Classes="source-tip"/>
                  <TextBlock Name="ExtraError" Classes="source-tip error" IsVisible="False"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border Name="CatalogueSection" Classes="source-section">
          <StackPanel Spacing="8">
            <Grid Name="CatalogueHeader" ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <WrapPanel ItemSpacing="10" LineSpacing="3" VerticalAlignment="Center">
                <TextBlock Name="CatalogueTitle" Classes="source-heading"/>
                <TextBlock Name="CatalogueHint" Classes="provider-caption"/>
              </WrapPanel>
              <Button Name="Probe" Grid.Column="1" Classes="provider-action source-quiet" AutomationProperties.AutomationId="action:provider.probe"/>
            </Grid>
            <Border Name="ProbeMessage" IsVisible="False">
              <StackPanel Spacing="3">
                <TextBlock Name="ProbeFailure" Classes="source-heading" IsVisible="False"/>
                <TextBlock Name="ProbeStatus" Classes="provider-caption"
                           AutomationProperties.AutomationId="status:provider.probe" AutomationProperties.LiveSetting="Polite"/>
              </StackPanel>
            </Border>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7" Margin="0,4,0,0">
              <TextBlock Name="EnabledTitle" Classes="source-heading" VerticalAlignment="Center"/>
              <TextBlock Name="EnabledCount" Grid.Column="1" Classes="provider-caption" VerticalAlignment="Center"/>
              <Button Name="TestModels" Grid.Column="2" Classes="provider-action source-quiet source-verify" AutomationProperties.AutomationId="action:provider.model-check-all"/>
            </Grid>
            <TextBlock Name="CatalogueGuide" Classes="provider-caption" LineHeight="19.8"/>
            <TextBox Name="ModelSearch" Classes="provider-field" Height="30" AutomationProperties.AutomationId="action:provider.model-search"/>
            <StackPanel Name="ModelRows"/>
            <Button Name="AddModel" Classes="provider-action source-disclosure source-model-offer" Height="56"
                    AutomationProperties.AutomationId="action:provider.model-add" IsVisible="False">
              <Grid ColumnDefinitions="22,*" ColumnSpacing="10">
                <Border Background="{DynamicResource AccentWashBrush}" CornerRadius="5" Width="22" Height="22" VerticalAlignment="Center">
                  <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Data="{StaticResource Glyph.plus}"
                           Stroke="{DynamicResource TextBrush}" StrokeThickness="1.8" StrokeLineCap="Round"/></Canvas></Viewbox>
                </Border>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Name="AddModelLabel" Classes="source-heading"/>
                  <TextBlock Name="AddModelHint" Classes="source-tip"/>
                </StackPanel>
              </Grid>
            </Button>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Name="PresetFields" IsVisible="False" Spacing="10">
        <StackPanel Spacing="4">
          <TextBlock Name="PresetNameLabel" Classes="provider-label"/>
          <TextBox Name="PresetName" Classes="provider-field" AutomationProperties.AutomationId="action:provider.draft.preset-name"/>
          <TextBlock Name="PresetNameHint" Classes="source-tip"/>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Classes="provider-label" Text="API Key"/>
          <TextBox Name="PresetCredential" Classes="provider-field" PasswordChar="●" AutomationProperties.AutomationId="action:provider.draft.preset-credential"/>
          <TextBlock Name="PresetPrivacy" Classes="source-tip"/>
        </StackPanel>
      </StackPanel>

      <settings:SettingsStickyFooter Name="Footer" Anchor="{Binding #SourceFields}" ZIndex="1" Margin="0,12,0,0"
                  Padding="0,10,0,12" Background="{DynamicResource FloatBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
        <StackPanel Spacing="7">
          <TextBlock Name="SaveError" Classes="provider-caption source-issue" IsVisible="False" AutomationProperties.LiveSetting="Polite"/>
          <StackPanel Name="Actions" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="Save" Classes="provider-action primary" AutomationProperties.AutomationId="action:provider.add"/>
            <Button Name="Back" Classes="provider-action" IsVisible="False" AutomationProperties.AutomationId="action:provider.preset-back"/>
            <Button Name="Cancel" Classes="provider-action" AutomationProperties.AutomationId="action:provider.add-cancel"/>
          </StackPanel>
        </StackPanel>
      </settings:SettingsStickyFooter>
    </StackPanel>
  </Border>
</UserControl>
