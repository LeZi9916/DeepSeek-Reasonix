<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Reasonix.Studio.Shell.Settings.ProviderAccountRow" Height="49" UseLayoutRounding="False">
  <UserControl.Resources>
    <StreamGeometry x:Key="Mark.server">M5 3H19A2 2 0 0 1 21 5V7A2 2 0 0 1 19 9H5A2 2 0 0 1 3 7V5A2 2 0 0 1 5 3Z M5 15H19A2 2 0 0 1 21 17V19A2 2 0 0 1 19 21H5A2 2 0 0 1 3 19V17A2 2 0 0 1 5 15Z M7 6h.01 M7 18h.01</StreamGeometry>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Button.service-row-select, Button.service-row-icon">
      <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Template"><ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="Center"/>
        </Border>
      </ControlTemplate></Setter>
    </Style>
    <Style Selector="Button.service-row-select">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="10,0,84,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.service-row-icon">
      <Setter Property="Width" Value="24"/><Setter Property="Height" Value="28"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.service-row-icon:pointerover">
      <Setter Property="Background" Value="{DynamicResource OverlayBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style Selector="Border#Frame"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.12" Easing="0.16,1,0.3,1"/></Transitions></Setter>
    </Style>
    <Style Selector="Border#Frame:pointerover"><Setter Property="Background" Value="{DynamicResource OverlayBrush}"/></Style>
    <Style Selector="Border#Frame.active">
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    </Style>
    <Style Selector="Border#Frame:focus-within"><Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Style>
    <Style Selector="Border#Frame.renaming:focus-within"><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Style>
    <Style Selector="TextBox#RenameInput /template/ Border#PART_BorderElement, TextBox#RenameInput:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource PageBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="StackPanel#Actions"><Setter Property="IsVisible" Value="False"/></Style>
    <Style Selector="Border#Frame.active StackPanel#Actions, Border#Frame:pointerover StackPanel#Actions, Border#Frame:focus-within StackPanel#Actions">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Border#Frame.active Border#HealthDot, Border#Frame:pointerover Border#HealthDot, Border#Frame:focus-within Border#HealthDot">
      <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style Selector="Border#HealthDot.use"><Setter Property="Background" Value="{DynamicResource OkBrush}"/></Style>
    <Style Selector="Border#HealthDot.warn"><Setter Property="Background" Value="{DynamicResource WarnBrush}"/></Style>
    <Style Selector="Border#HealthDot.fail"><Setter Property="Background" Value="{DynamicResource ErrBrush}"/></Style>
    <Style Selector="Border#HealthDot.pass">
      <Setter Property="BorderBrush" Value="{DynamicResource OkBrush}"/>
      <Setter Property="BorderThickness" Value="1.5"/>
    </Style>
  </UserControl.Styles>
  <Border Name="Frame" BorderThickness="1" CornerRadius="7">
    <Grid>
      <Button Name="SelectAccount" Classes="service-row-select" AutomationProperties.AutomationId="action:provider.select"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
          <Panel Name="MarkHost" Width="20" Height="20" VerticalAlignment="Center">
            <Border Name="MarkWash" CornerRadius="5" Opacity="0.16"/>
            <Viewbox Name="MarkScale" Width="20" Height="20">
              <Canvas Width="24" Height="24">
                <Path Name="MarkGlyph" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/>
              </Canvas>
            </Viewbox>
          </Panel>
          <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
            <TextBlock Name="ServiceName" FontSize="{DynamicResource StudioType13}" FontWeight="Medium"
                       Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Name="ServiceHost" FontSize="{DynamicResource StudioType10}" Foreground="{DynamicResource FaintBrush}"
                       FontFamily="{DynamicResource WorkbenchMonoFamily}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Grid>
      </Button>
      <Border Name="HealthDot" Margin="0,0,14,0" Width="6" Height="6" CornerRadius="3"
              HorizontalAlignment="Right" VerticalAlignment="Center"/>
      <StackPanel Name="Actions" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
        <Button Name="Rename" Classes="service-row-icon" AutomationProperties.AutomationId="action:provider.rename-start">
          <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Data="{StaticResource Glyph.edit}" Stroke="{Binding #Rename.Foreground}"
                   StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox>
        </Button>
        <Button Name="Up" Classes="service-row-icon" AutomationProperties.AutomationId="action:provider.move" Tag="up">
          <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Data="M12 19V5m-7 7 7-7 7 7" Stroke="{Binding #Up.Foreground}"
                   StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox>
        </Button>
        <Button Name="Down" Classes="service-row-icon" AutomationProperties.AutomationId="action:provider.move" Tag="down">
          <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24"><Path Data="M12 5v14m7-7-7 7-7-7" Stroke="{Binding #Down.Foreground}"
                   StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas></Viewbox>
        </Button>
      </StackPanel>
      <TextBox Name="RenameInput" FontSize="{DynamicResource StudioType13}" FontWeight="Medium" MaxLength="64"
               Height="44" MinHeight="0" VerticalContentAlignment="Center" Padding="10,0" CornerRadius="7"
               SelectionBrush="{DynamicResource OverlayBrush}" Foreground="{DynamicResource TextBrush}"
               IsVisible="False" AutomationProperties.AutomationId="action:provider.rename"/>
    </Grid>
  </Border>
</UserControl>
