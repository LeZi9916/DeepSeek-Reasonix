<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Reasonix.Studio.Shell.Settings"
             x:Class="Reasonix.Studio.Shell.Settings.FoldingOptionRow" AutomationProperties.AutomationId="class:fold-row">
  <UserControl.Resources>
    <SolidColorBrush x:Key="FoldRowHot" Color="{DynamicResource Accent}" Opacity="0.05"/>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="local|FoldingOptionRow:not(.preview-option):pointerover Border#Surface, local|FoldingOptionRow:not(.preview-option):focus-within Border#Surface">
      <Setter Property="Background" Value="{StaticResource FoldRowHot}"/>
    </Style>
    <Style Selector="local|FoldingOptionRow.preview-option Border#Surface"><Setter Property="Padding" Value="12,0"/></Style>
    <Style Selector="local|FoldingOptionRow.preview-option TextBlock#Caption"><Setter Property="FontWeight" Value="Normal"/></Style>
    <Style Selector="local|FoldingOptionRow.last-option Border#Surface"><Setter Property="BorderThickness" Value="0,1,0,1"/></Style>
  </UserControl.Styles>
  <Border Name="Surface" Classes="fold-option-surface" CornerRadius="5" BorderBrush="{DynamicResource HairBrush}">
    <Grid Name="Layout" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16">
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Name="Caption" Classes="fold-option-caption" FontSize="{DynamicResource StudioType13}" LineHeight="19" TextWrapping="Wrap"/>
        <TextBlock Name="Hint" FontSize="{DynamicResource StudioType12}" LineHeight="18.6" TextWrapping="Wrap" Foreground="{DynamicResource FaintBrush}"/>
      </StackPanel>
      <ContentControl Name="Options" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left"/>
    </Grid>
  </Border>
</UserControl>
