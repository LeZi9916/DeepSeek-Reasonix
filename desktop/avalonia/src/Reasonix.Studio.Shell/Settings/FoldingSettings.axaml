<local:SettingsFormView xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:local="using:Reasonix.Studio.Shell.Settings" x:Class="Reasonix.Studio.Shell.Settings.FoldingSettings">
  <Border BorderBrush="{DynamicResource HairBrush}" BorderThickness="0,1,0,0" Padding="0,6">
    <StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Tag="chat.transcript_folding" FontSize="{DynamicResource StudioType13}" FontWeight="Medium" LineHeight="18.2"/>
        <Border Name="Custom" IsVisible="False" Background="{DynamicResource OverlayBrush}" Padding="6,0" CornerRadius="7">
          <TextBlock Tag="common.custom" FontSize="{DynamicResource StudioType11}" Foreground="{DynamicResource FaintBrush}"/>
        </Border>
      </StackPanel>
      <TextBlock Tag="chat.whether_each_part_of_a" FontSize="{DynamicResource StudioType12}" LineHeight="16.8"
                 Foreground="{DynamicResource FaintBrush}" TextWrapping="Wrap"/>
      <Border Name="PresetShell" Background="{DynamicResource OverlayBrush}" CornerRadius="7" Padding="2" Margin="0,14,0,0">
        <WrapPanel Name="Presets"/>
      </Border>
      <local:FoldingPreview Name="Preview" Margin="0,14,0,0"/>
      <StackPanel Name="Rows" Margin="0,10,0,0"/>
    </StackPanel>
  </Border>
</local:SettingsFormView>
