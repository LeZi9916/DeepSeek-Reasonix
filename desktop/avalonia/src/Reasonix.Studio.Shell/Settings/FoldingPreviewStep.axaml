<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Reasonix.Studio.Shell.Settings" x:Class="Reasonix.Studio.Shell.Settings.FoldingPreviewStep">
  <UserControl.Resources>
    <LinearGradientBrush x:Key="OutputFade" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="Black" Offset="0.45"/><GradientStop Color="Transparent" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="FailedLine" Color="{DynamicResource Err}" Opacity="0.55"/>
  </UserControl.Resources>
  <local:FoldingPreviewFrame Name="StepFrame" Classes="fold-example-part" CornerRadius="5">
    <StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,2">
        <TextBlock Name="Caret" Text="›" Width="9" FontSize="{DynamicResource StudioType12}" LineHeight="17" Foreground="{DynamicResource GhostBrush}"/>
        <TextBlock Name="ToolName" FontFamily="{DynamicResource StudioMonoFamily}" FontWeight="Medium"
                   FontSize="{DynamicResource StudioType12}" LineHeight="17" Foreground="{DynamicResource MutedBrush}"/>
        <TextBlock Name="Argument" FontSize="{DynamicResource StudioType12}" LineHeight="17" Foreground="{DynamicResource FaintBrush}"/>
      </StackPanel>
      <Border Name="Detail" Classes="fold-example-part" Margin="7,4,0,2" Padding="18,4,0,6"
              BorderBrush="{DynamicResource HairBrush}" BorderThickness="1,0,0,0" IsVisible="False">
        <StackPanel>
          <local:FoldingPreviewLines Name="Lines" Margin="0,4,4,2" Thickness="5" Fill="{DynamicResource TextBrush}" Opacity="0.11"/>
          <TextBlock Name="More" IsVisible="False" FontSize="{DynamicResource StudioType11}" LineHeight="19.75" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </local:FoldingPreviewFrame>
</UserControl>
