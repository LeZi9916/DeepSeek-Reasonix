<local:SettingsFormView xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Reasonix.Studio.Shell.Settings" x:Class="Reasonix.Studio.Shell.Settings.MarketPublishView" UseLayoutRounding="False">
  <local:SettingsFormView.Styles>
    <Style Selector="TextBlock.publish-hint">
      <Setter Property="FontSize" Value="{DynamicResource StudioType12}"/>
      <Setter Property="LineHeight" Value="19.2"/>
      <Setter Property="Foreground" Value="{DynamicResource FaintBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.publish-tip">
      <Setter Property="FontSize" Value="{DynamicResource StudioType11}"/>
      <Setter Property="LineHeight" Value="15.95"/>
      <Setter Property="Foreground" Value="{DynamicResource GhostBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.publish-label">
      <Setter Property="FontSize" Value="{DynamicResource StudioType12}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    </Style>
    <Style Selector="TextBox.publish-field">
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="FontSize" Value="{DynamicResource StudioType13}"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="PlaceholderForeground" Value="{DynamicResource GhostBrush}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.publish-field.source">
      <Setter Property="FontFamily" Value="{DynamicResource WorkbenchMonoFamily}"/>
      <Setter Property="FontSize" Value="{DynamicResource StudioType12}"/>
    </Style>
    <Style Selector="TextBox.publish-field:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}"/>
    </Style>
    <Style Selector="CheckBox.publish-private">
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="FontSize" Value="{DynamicResource StudioType12}"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Template"><ControlTemplate>
        <Border CornerRadius="10" Padding="12,10" Background="{DynamicResource PageBrush}">
          <Grid ColumnDefinitions="*,30" ColumnSpacing="12">
            <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap" LineHeight="19.2" VerticalAlignment="Center"/>
            <Border Grid.Column="1" Name="Track" Height="18" Width="30" CornerRadius="9" VerticalAlignment="Center"
                    Background="{DynamicResource BorderBrush}">
              <Border Name="Thumb" Margin="2,0,0,0" Width="14" Height="14" CornerRadius="7"
                      HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource RaisedBrush}"
                      BoxShadow="0 1 2 0 #33000000"/>
            </Border>
          </Grid>
        </Border>
      </ControlTemplate></Setter>
    </Style>
    <Style Selector="CheckBox.publish-private:checked /template/ Border#Track">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="CheckBox.publish-private:checked /template/ Border#Thumb">
      <Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Margin" Value="0,0,2,0"/>
    </Style>
    <Style Selector="Button.publish-submit, Button.publish-submit:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentFgBrush}"/>
    </Style>
  </local:SettingsFormView.Styles>
  <Border Name="PublishFrame" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
          Background="{DynamicResource FloatBrush}" BoxShadow="0 10 24 0 #19000000">
    <Panel>
      <StackPanel Name="Draft" Margin="16,14,16,0" Spacing="12">
        <TextBlock Tag="ext.publish_to_the_market" FontWeight="Bold" FontSize="{DynamicResource StudioType14}" Foreground="{DynamicResource TextBrush}"/>
        <TextBlock Name="Origin" Classes="publish-hint" IsVisible="False" Margin="0,-6,0,0"/>
        <TextBlock Name="Identity" Classes="publish-hint" Margin="0,-6,0,0"/>
        <Border Background="{DynamicResource OverlayBrush}" HorizontalAlignment="Left" Padding="2" CornerRadius="7">
          <StackPanel Name="Kinds" Orientation="Horizontal"/>
        </Border>
        <TextBlock Name="ThemeHint" Tag="ext.a_theme_is_published_as" Classes="publish-tip" IsVisible="False"/>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="12">
          <StackPanel Grid.ColumnSpan="2" Spacing="4">
            <TextBlock Tag="ext.source_address" Classes="publish-label"/>
            <TextBox Name="Source" Classes="publish-field source" AutomationProperties.AutomationId="action:market.draft.source"/>
            <TextBlock Name="SourceHint" Classes="publish-tip"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Tag="common.name" Classes="publish-label"/>
            <TextBox Name="PackageName" Classes="publish-field" PlaceholderText="my-package" AutomationProperties.AutomationId="action:market.draft.name"/>
            <TextBlock Tag="ext.lowercase_letters_digits_dots_underscores" Classes="publish-tip"/>
            <TextBlock Name="ExistingNameHint" Tag="ext.keep_this_name_to_publish" Classes="publish-tip" IsVisible="False"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
            <TextBlock Tag="common.version" Classes="publish-label"/>
            <TextBox Name="Version" Classes="publish-field" PlaceholderText="0.1.0" AutomationProperties.AutomationId="action:market.draft.version"/>
            <TextBlock Tag="ext.blank_starts_a_new_package" Classes="publish-tip"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="4">
            <TextBlock Tag="ext.summary" Classes="publish-label"/>
            <TextBox Name="Summary" Classes="publish-field" MaxLength="200" AutomationProperties.AutomationId="action:market.draft.summary"/>
          </StackPanel>
          <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="4">
            <TextBlock Tag="ext.description" Classes="publish-label"/>
            <TextBox Name="Description" Classes="publish-field" Height="97" Padding="10,6" VerticalContentAlignment="Top"
                     AcceptsReturn="True" TextWrapping="Wrap" MaxLength="8000" AutomationProperties.AutomationId="action:market.draft.description"/>
          </StackPanel>
          <Grid Name="TagFields" Grid.Row="4" Grid.ColumnSpan="2" ColumnDefinitions="*,*" RowDefinitions="Auto" ColumnSpacing="12" RowSpacing="12">
            <StackPanel Spacing="4">
              <TextBlock Tag="ext.repository" Classes="publish-label"/>
              <TextBox Name="Repository" Classes="publish-field source" PlaceholderText="https://github.com/…" AutomationProperties.AutomationId="action:market.draft.repoUrl"/>
            </StackPanel>
            <StackPanel Name="NewTagField" Grid.Column="1" Spacing="4">
              <TextBlock Name="NewTagLabel" Classes="publish-label"/>
              <TextBox Name="NewTags" Tag="ext.comma_separated_up_to_8" Classes="publish-field" AutomationProperties.AutomationId="action:market.draft.tags"/>
            </StackPanel>
          </Grid>
        </Grid>
        <CheckBox Name="Visibility" Tag="ext.only_me_skip_review_in" Classes="publish-private" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="action:market.draft.visibility"/>
        <StackPanel Name="ErrorPanel" IsVisible="False" Spacing="4">
          <TextBlock Tag="ext.the_submission_did_not_go" Foreground="{DynamicResource ErrInkBrush}" FontWeight="SemiBold"/>
          <TextBlock Name="Failure" Classes="publish-hint" Foreground="{DynamicResource ErrInkBrush}" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <Border Margin="-16,4,-16,0" Padding="16,10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource HairBrush}">
          <Grid Name="FooterGrid" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Name="FooterNote" Classes="publish-hint" VerticalAlignment="Center"/>
            <Button Name="Submit" Grid.Column="1" Classes="market-action publish-submit" AutomationProperties.AutomationId="action:market.publish"/>
          </Grid>
        </Border>
      </StackPanel>
      <StackPanel Name="Receipt" Margin="16,14" Spacing="8" IsVisible="False">
        <TextBlock Name="ReceiptTitle" FontSize="{DynamicResource StudioType14}" FontWeight="SemiBold"
                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock Name="ReceiptHint" Classes="publish-hint"/>
        <WrapPanel ItemSpacing="8" LineSpacing="4">
          <Button Name="PublishAgain" Tag="ext.publish_another" Classes="market-action" AutomationProperties.AutomationId="action:market.publish-again"/>
          <Button Name="SeeMine" Tag="ext.see_my_packages" Classes="market-action publish-submit" AutomationProperties.AutomationId="action:market.publish.see-mine"/>
        </WrapPanel>
      </StackPanel>
    </Panel>
  </Border>
</local:SettingsFormView>
