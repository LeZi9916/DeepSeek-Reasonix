<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Reasonix.Studio.Shell.Settings.ExtensionInventoryRow" UseLayoutRounding="False">
  <UserControl.Styles>
    <Style Selector="Border#Pip"><Setter Property="Background" Value="{DynamicResource GhostBrush}"/></Style>
    <Style Selector="Border#Pip.ready"><Setter Property="Background" Value="{DynamicResource OkBrush}"/></Style>
    <Style Selector="Border#Pip.failed"><Setter Property="Background" Value="{DynamicResource ErrBrush}"/></Style>
    <Style Selector="Border#Pip.pending"><Setter Property="Background" Value="{DynamicResource WarnBrush}"/></Style>
    <Style Selector="Border#Pip.connecting"><Setter Property="Background" Value="{DynamicResource NetBrush}"/></Style>
    <Style Selector="Button.ext-disclosure">
      <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
      <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/>
        </Border>
      </ControlTemplate></Setter>
    </Style>
  </UserControl.Styles>
  <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource HairBrush}">
    <StackPanel>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="12,0">
        <Button Name="Expand" Classes="ext-disclosure" MinHeight="56" HorizontalAlignment="Stretch"
                AutomationProperties.AutomationId="action:extensions.expand">
          <Grid ColumnDefinitions="6,*" ColumnSpacing="10">
            <Border Name="Pip" Width="6" Height="6" CornerRadius="3" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
              <TextBlock Name="Title" FontSize="{DynamicResource StudioType13}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextBrush}"/>
              <Grid ColumnDefinitions="8,*" ColumnSpacing="6">
                <Viewbox Width="8" Height="8" VerticalAlignment="Center">
                  <Canvas Width="24" Height="24"><Path Name="Caret" Data="m9 18 6-6-6-6" Stroke="{DynamicResource FaintBrush}"
                           StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas>
                </Viewbox>
                <TextBlock Name="Meta" Grid.Column="1" FontSize="{DynamicResource StudioType11}" Foreground="{DynamicResource FaintBrush}" TextTrimming="CharacterEllipsis"/>
              </Grid>
            </StackPanel>
          </Grid>
        </Button>
        <ToggleSwitch Name="Enabled" Grid.Column="1" Width="34" Height="20" MinWidth="0" VerticalAlignment="Center" OffContent="" OnContent=""/>
      </Grid>
      <StackPanel Name="Details" Margin="28,0,12,10" Spacing="6" IsVisible="False"/>
    </StackPanel>
  </Border>
</UserControl>
