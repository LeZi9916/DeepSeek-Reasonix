<local:SettingsFormView xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Reasonix.Studio.Shell.Settings" x:Class="Reasonix.Studio.Shell.Settings.PresetModules">
  <local:SettingsFormView.Styles>
    <Style Selector="ToggleButton.capability-heading">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Height" Value="52"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><ControlTemplate>
        <ContentPresenter Background="{TemplateBinding Background}" Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"/>
      </ControlTemplate></Setter>
    </Style>
    <Style Selector="ToggleButton.capability-heading:checked Viewbox.capability-chevron">
      <Setter Property="RenderTransform" Value="rotate(90deg)"/>
    </Style>
    <Style Selector="ToggleButton.capability-heading:pointerover TextBlock.capability-status">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style Selector="TextBlock.capability-status">
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="FontSize" Value="{DynamicResource StudioType12}"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </local:SettingsFormView.Styles>
  <StackPanel Name="CapabilitiesHeading">
    <TextBlock Tag="persona.capabilities" FontWeight="Medium" Margin="0,0,0,6"/>
    <TextBlock Tag="persona.inherit_current_tools_skills_and" TextWrapping="Wrap" LineHeight="19.2"
               Foreground="{DynamicResource MutedBrush}" FontSize="{DynamicResource StudioType12}" Margin="0,0,0,12"/>
    <Border CornerRadius="10" Background="{DynamicResource OverlayBrush}" ClipToBounds="True">
      <StackPanel>
        <StackPanel Margin="16,0">
          <ToggleButton Name="Tools" Classes="capability-heading" AutomationProperties.AutomationId="action:agent-preset.capability">
            <Grid ColumnDefinitions="18,Auto,*,Auto,18" ColumnSpacing="10">
              <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24">
                <Path Data="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z M10 2h4l.5 3 2 .9 2.8-1.3 2 3.4-2.2 2.1v2.8l2.2 2.1-2 3.4-2.8-1.3-2 .9-.5 3h-4l-.5-3-2-.9-2.8 1.3-2-3.4 2.2-2.1v-2.8L2.7 8l2-3.4 2.8 1.3 2-.9Z"
                      Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"/>
              </Canvas></Viewbox>
              <TextBlock Name="ToolsLabel" Grid.Column="1" Tag="common.tool" FontWeight="Medium" VerticalAlignment="Center"/>
              <TextBlock Name="ToolsStatus" Grid.Column="3" Classes="capability-status"/>
              <Viewbox Grid.Column="4" Classes="capability-chevron" Width="18" Height="18">
                <Canvas Width="24" Height="24"><Path Data="M9 6l6 6-6 6" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas>
              </Viewbox>
            </Grid>
          </ToggleButton>
          <StackPanel Name="ToolGroups" IsVisible="{Binding #Tools.IsChecked, FallbackValue=False}"/>
        </StackPanel>
        <Border BorderBrush="{DynamicResource HairBrush}" BorderThickness="0,1,0,0">
          <StackPanel Margin="16,0">
            <ToggleButton Name="Extensions" Classes="capability-heading" AutomationProperties.AutomationId="action:agent-preset.capability">
              <Grid ColumnDefinitions="18,Auto,*,Auto,18" ColumnSpacing="10">
                <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24">
                  <Path Data="M12 2 2 7l10 5 10-5-10-5Z M2 12l10 5 10-5 M2 17l10 5 10-5"
                        Stroke="{DynamicResource TextBrush}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/>
                </Canvas></Viewbox>
                <TextBlock Name="ExtensionsLabel" Grid.Column="1" Tag="persona.skills_and_extensions" FontWeight="Medium" VerticalAlignment="Center"/>
                <TextBlock Name="ExtensionsStatus" Grid.Column="3" Classes="capability-status"/>
                <Viewbox Grid.Column="4" Classes="capability-chevron" Width="18" Height="18">
                  <Canvas Width="24" Height="24"><Path Data="M9 6l6 6-6 6" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"/></Canvas>
                </Viewbox>
              </Grid>
            </ToggleButton>
            <StackPanel Name="ExtensionGroups" IsVisible="{Binding #Extensions.IsChecked, FallbackValue=False}"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </StackPanel>
</local:SettingsFormView>
